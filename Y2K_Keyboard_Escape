-- AUTO WIN LOOP
local autoWinActive = false
task.spawn(function()
    while not _DEAD do
        task.wait(0.05)
        if Cfg.AutoWin and not autoWinActive then
            autoWinActive = true
            task.spawn(function()
                Cfg.sessionWinTarget = 0
                while Cfg.AutoWin do
                    -- Check win count limit
                    if Cfg.AutoWinTargetCount > 0 and Cfg.sessionWinTarget >= Cfg.AutoWinTargetCount then
                        Cfg.AutoWin = false
                        pcall(function() Toggles.AutoWin:SetValue(false) end)
                        Library:Notify({Title="Auto Win",Description="Objectif atteint : "..Cfg.sessionWinTarget.." wins!",Time=5})
                        break
                    end

                    local done    = false
                    local timeout = 0

                    doWinCycle(function() done = true end)

                    -- Wait for cycle to finish (timeout 90s max for long stages)
                    while not done and Cfg.AutoWin do
                        task.wait(0.05)
                        timeout = timeout + 0.05
                        if timeout > 90 then done = true end
                        -- If player dies, abort cycle so it restarts automatically
                        local c = getChar()
                        local h = getHum()
                        if not c or not h or h.Health <= 0 then
                            done = true
                        end
                    end

                    if Cfg.AutoWin then
                        task.wait(Cfg.WinDelay)
                    end
                end
                autoWinActive = false
            end)
        end
    end
end)

