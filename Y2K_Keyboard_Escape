local function getState()
    if not ClientState then return {} end
    -- In this game, ClientState is a ModuleScript; its .Data table holds the live state directly
    if ClientState.Data and type(ClientState.Data) == "table" then
        return ClientState.Data
    end
    -- Fallback to Get() if Data is unavailable
    local ok,v = pcall(function() return ClientState:Get() end)
    return (ok and type(v)=="table") and v or {}
end

-- Helper: convert string booleans ("true"/"false") and numbers to proper types
local function toBool(v)
    if type(v) == "boolean" then return v end
    if type(v) == "string" then return v:lower() == "true" end
    if type(v) == "number" then return v ~= 0 end
    return v and true or false
end

local function fmt(n)
    n = tonumber(n) or 0
    if     n>=1e12 then return string.format("%.1fT",n/1e12)
    elseif n>=1e9  then return string.format("%.1fB",n/1e9)
    elseif n>=1e6  then return string.format("%.1fM",n/1e6)
    elseif n>=1e3  then return string.format("%.1fK",n/1e3)
    else                return tostring(math.floor(n)) end
end

