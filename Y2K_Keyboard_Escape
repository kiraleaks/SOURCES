-- AUTO WALK CIRCLE (Speed Farm)
local walkCircleConn
local walkAngle = 0

function stopWalkCircle()
    if walkCircleConn then
        walkCircleConn:Disconnect()
        walkCircleConn = nil
    end
    local hum = getHum()
    if hum then
        pcall(function() hum:Move(Vector3.zero, false) end)
    end
end

function startWalkCircle()
    stopWalkCircle()
    walkAngle = 0
    walkCircleConn = RunService.RenderStepped:Connect(function(dt)
        if not Cfg.AutoWalkCircle then
            stopWalkCircle()
            return
        end
        local hum = getHum()
        if not hum then return end
        -- Rotate direction over time
        walkAngle = walkAngle + (Cfg.WalkCircleSpeed * dt)
        local dir = Vector3.new(math.cos(walkAngle), 0, math.sin(walkAngle)).Unit
        hum:Move(dir, false) -- world space, natural walking
    end)
end

