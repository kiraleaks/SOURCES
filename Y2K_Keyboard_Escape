-- Search workspace for a WinBlock near a given position
local function findWinBlockNear(pos, radius)
    local best, bestD = nil, radius or 200
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if n:find("win") or n:find("trophy") or n:find("finish") or n:find("goal") or n:find("checkpoint") or n:find("end") then
                local d = (obj.Position - pos).Magnitude
                if d < bestD then bestD = d; best = obj end
            end
        end
    end
    return best
end

-- Find the exact WinBlock by name for a given stage
local function findWinBlockForStage(stageNum)
    local cfg = (Cfg.World == "World 2" and STAGE_WIN_CFG_W2 or STAGE_WIN_CFG_W1)[stageNum]
    if not cfg then return nil end
    local maxPosDist = 120
    -- First: search by exact name (case-insensitive) + position check
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower() == cfg.blockName:lower() then
            if (obj.Position - cfg.pos).Magnitude <= maxPosDist then
                return obj
            end
        end
    end
    -- Second: search by partial name match + position check
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower():find(cfg.blockName:lower()) then
            if (obj.Position - cfg.pos).Magnitude <= maxPosDist then
                return obj
            end
        end
    end
    -- Third: search by proximity with larger radius
    return findWinBlockNear(cfg.pos, 150)
end

