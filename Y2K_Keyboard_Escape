-- │  GROUND-FOLLOWING TWEEN  (v5.9)                               │
-- │  • Stops Fly first so BodyVelocity can't fight the movement   │
-- │  • Raycasts DOWN every ~15 studs to find keycap surface       │
-- │  • Uses RenderStepped loop – sets CFrame every frame so       │
-- │    physics CANNOT override it                                  │
-- │  • Noclip ON so obstacles don't block the path                │
-- └──────────────────────────────────────────────────────────────┘

local GROUND_RAY_PARAMS = RaycastParams.new()
GROUND_RAY_PARAMS.FilterType = Enum.RaycastFilterType.Exclude

local function updateRayExclusion()
    local c = getChar()
    GROUND_RAY_PARAMS.FilterDescendantsInstances = c and {c} or {}
end

-- Build a list of waypoints with direct interpolation (no raycasting)
-- Interpolates Y properly so the character follows ramps and slopes
local function buildGroundWaypoints(startPos, targetPos)
    local waypoints = {}
    local dx = targetPos.X - startPos.X
    local dz = targetPos.Z - startPos.Z
    local dy = targetPos.Y - startPos.Y
    local totalDist = math.sqrt(dx * dx + dz * dz + dy * dy)
    local STEP  = 20   -- sample every 20 studs
    local nSteps = math.max(2, math.ceil(totalDist / STEP))
    
    for i = 0, nSteps do
        local t = i / nSteps
        local wx = startPos.X + dx * t
        local wy = startPos.Y + dy * t  -- Interpolate Y so we follow slopes
        local wz = startPos.Z + dz * t
        table.insert(waypoints, Vector3.new(wx, wy, wz))
    end
    -- Force exact destination as final waypoint
    waypoints[#waypoints] = targetPos
    return waypoints
end

-- Move the character through a single segment using a smooth TweenService tween.
-- We tween a CFrameValue and apply it every frame, giving a fluid glide instead of a snap.
-- dangerCheck: optional function() -> boolean, if returns true tween is cancelled immediately
local function moveSegment(segFrom, segTo, speed, dangerCheck)
    local dist = (segTo - segFrom).Magnitude
    if dist < 0.05 then return true end
    local duration = math.max(0.04, dist / speed)

    local root = getRoot()
    if not root then return false end

    local cfValue = Instance.new("CFrameValue")
    cfValue.Value = CFrame.new(segFrom)
    cfValue.Parent = root

    local tween = TweenService:Create(
        cfValue,
        TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut),
        {Value = CFrame.new(segTo)}
    )

    local finished = false
    local cancelled = false
    tween.Completed:Connect(function()
        finished = true
    end)

    -- Keep the HRP locked to the tweened value every frame
    local conn = RunService.RenderStepped:Connect(function()
        local r = getRoot()
        if r then
            r.CFrame = cfValue.Value
        end
    end)

    tween:Play()

    while not finished do
        if dangerCheck and dangerCheck() then
            cancelled = true
            tween:Cancel()
            break
        end
        task.wait()
    end

    conn:Disconnect()
    cfValue:Destroy()
    return not cancelled
end

-- Main public tween used by all stage-TP and player-TP buttons.
local function tweenTo(targetPos, speed, onDone)
    local root = getRoot()
    if not root then if onDone then onDone() end return end
    speed = speed or 500

    task.spawn(function()
        -- 1. Kill Fly so BodyVelocity/BodyGyro can't resist our movement
        local wasFlying = Cfg.Fly
        if Cfg.Fly then StopFly() end

        -- 2. Noclip: phase through walls/obstacles
        enableNoclip()

        -- 3. Build waypoints that hug the keycap surface
        local startPos = getRoot() and getRoot().Position or root.Position
        local waypoints = buildGroundWaypoints(startPos, targetPos)

        -- 4. Move segment-by-segment via RenderStepped (physics-proof)
        for i = 2, #waypoints do
            local r = getRoot()
            if not r then break end
            moveSegment(r.Position, waypoints[i], speed)
        end

        -- 5. Cleanup
        disableNoclip()
        -- Restore fly if it was active before the tween
        if wasFlying then
            Cfg.Fly = true
            StartFly()
        end

        if onDone then onDone() end
    end)
end

