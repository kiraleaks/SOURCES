-- Deleting the tsunami won't save you (the kill is server-authoritative), so
-- instead we watch the Tsunami union; when it sweeps toward you on your row we
-- lift you above its crest until it passes, then let you drop back.
local function getTsunamiWaves()
    local np = workspace:FindFirstChild("NPC & Piege")
    local list = {}
    if np then
        for _, nm in ipairs({ "Tsunami1", "Tsunami2" }) do
            local t = np:FindFirstChild(nm)
            local wave = t and t:FindFirstChild("Tsunami")
            if wave and wave:IsA("BasePart") then list[#list + 1] = wave end
        end
    end
    return list
end

task.spawn(function()
    while not _DEAD do
        task.wait(0.12)
        if Cfg.TsunamiGuard then
            pcall(function()
                local root = getRoot(); if not root then return end
                for _, wave in ipairs(getTsunamiWaves()) do
                    local d = wave.Position - root.Position
                    local flat = Vector2.new(d.X, d.Z).Magnitude
                    local topY = wave.Position.Y + wave.Size.Y / 2
                    -- danger: wave is near and at/above our height  ride over its crest
                    if flat < (math.max(wave.Size.X, wave.Size.Z) / 2 + 28) and root.Position.Y < topY + 8 then
                        root.CFrame = CFrame.new(root.Position.X, topY + 14, root.Position.Z)
                        root.AssemblyLinearVelocity = Vector3.zero
                    end
                end
            end)
        end
