-- Navigate through NAV_POINTS from startIdx to endIdx using ground-following tween
local function navigateNavPoints(startIdx, endIdx, speed, dangerCheck, winPos)
    local CURRENT_NAV = Cfg.World == "World 2" and NAV_POINTS_W2 or NAV_POINTS_W1
    -- World 2: simple navigation without special waypoint checks
    local useSpecialWaypoints = (Cfg.World ~= "World 2")
    
    for i = startIdx, endIdx do
        if not Cfg.AutoWin then return end
        local r = getRoot()
        if not r then return end
        local target = CURRENT_NAV[i]
        if not target then continue end

        -- If this is the last nav point, adjust it to avoid overshooting the WinBlock
        if i == endIdx and endIdx > startIdx and winPos then
            local A = CURRENT_NAV[endIdx - 1]
            local B = CURRENT_NAV[endIdx]
            local AB = B - A
            local AW = winPos - A
            local abMagSq = AB.X*AB.X + AB.Y*AB.Y + AB.Z*AB.Z
            if abMagSq > 0.0001 then
                local t = (AW.X*AB.X + AW.Y*AB.Y + AW.Z*AB.Z) / abMagSq
                if t < 1.0 then
                    target = A + AB * math.max(0, t)
                end
            end
        end

        -- LADDER / VERTICAL CLIMB DETECTION
        -- When next nav point is way above/below (>100 studs Y diff), treat as ladder.
        -- Move horizontally first, then teleport straight up (noclip handles collision).
        local dy = math.abs(target.Y - r.Position.Y)
        local isWorldTransition = (r.Position.Y < 150 and target.Y > 400)
        if dy > 100 and not isWorldTransition then
            -- Step 1: move horizontally to align with ladder base at current Y
            local ladderBase = Vector3.new(target.X, r.Position.Y, target.Z)
            local horizWps = buildGroundWaypoints(r.Position, ladderBase)
            for j = 2, #horizWps do
                if not Cfg.AutoWin then return end
                local cr = getRoot()
                if not cr then return end
                moveSegment(cr.Position, horizWps[j], speed, dangerCheck)
            end
            -- Step 2: teleport straight up to the top (ladder climb)
            local cr2 = getRoot()
            if cr2 then
                local topPos = Vector3.new(target.X, target.Y, target.Z)
                moveSegment(cr2.Position, topPos, speed * 2)
                task.wait(0.1)
            end
            -- Skip to next nav point
            continue
        end

        -- Build ground-hugging waypoints between current pos and next nav point
        local wps = buildGroundWaypoints(r.Position, target)
        for j = 2, #wps do
            if not Cfg.AutoWin then return end
            local cr = getRoot()
            if not cr then return end
            local ok = moveSegment(cr.Position, wps[j], speed, dangerCheck)
            if not ok and dangerCheck then
                -- Danger detected mid-segment: wait for safe then retry this segment
                local stuckTimer = 0
                while dangerCheck() and Cfg.AutoWin do
                    task.wait(0.1)
                    stuckTimer = stuckTimer + 0.1
                    -- If stuck >25s, abort this nav attempt
                    if stuckTimer > 25 then return end
                end
                if not Cfg.AutoWin then return end
                j = j - 1 -- retry same segment
            end
        end

        -- Check for special waypoint conditions AFTER arriving at the waypoint target position
        local special = nil
        if useSpecialWaypoints then
            special = SPECIAL_WAYPOINTS[i]
        end
        if special then
            if special.type == "wait_despawn" then
                -- Wait for ball objects to despawn
                local allDespawned = false
                local timeout = 10
                local startWait = os.clock()
                while not allDespawned and (os.clock() - startWait) < timeout do
                    allDespawned = true
                    for _, objPath in ipairs(special.objects) do
                        local obj = workspace:FindFirstChild(objPath:match("NPC & Piege") and "NPC & Piege" or objPath:split(".")[1])
                        if obj then
                            local parts = objPath:split(".")
                            local current = obj
                            for k = 2, #parts do
                                current = current and current:FindFirstChild(parts[k])
                            end
                            if current then
                                allDespawned = false
                                break
                            end
                        end
                    end
                    if not allDespawned then task.wait(0.1) end
                end
            elseif special.type == "wait_timer" then
                -- Stage 5 bridge timer: wait until the timer resets (value becomes high) to cross safely
                local bridge = workspace:FindFirstChild("Keycaps") and workspace.Keycaps:FindFirstChild("Bridge") and workspace.Keycaps.Bridge:FindFirstChild("Bridge1")
                local timerPart = bridge and bridge:FindFirstChild("Timer")
                if timerPart then
                    local startWait = os.clock()
                    local isSafe = false
                    while (os.clock() - startWait) < 15 and not isSafe and Cfg.AutoWin do
                        pcall(function()
                            -- 1. If Timer itself is a ValueBase (IntValue/NumberValue)
                            if timerPart:IsA("ValueBase") then
                                local val = tonumber(timerPart.Value)
                                if val and val > 1 then
                                    isSafe = true
                                end
                            else
                                -- 2. Check for direct child ValueBases or types
                                local timerVal = timerPart:FindFirstChild("Value") or timerPart:FindFirstChild("Time") or timerPart:FindFirstChild("Timer") or timerPart:FindFirstChildOfClass("NumberValue") or timerPart:FindFirstChildOfClass("IntValue")
                                if timerVal and timerVal:IsA("ValueBase") then
                                    local val = tonumber(timerVal.Value)
                                    if val and val > 1 then
                                        isSafe = true
                                    end
                                else
                                    -- 3. Check for TextLabel in billboard/surface/children
                                    local textLabel = timerPart:FindFirstChildOfClass("TextLabel") 
                                        or timerPart:FindFirstChildOfClass("TextBox") 
                                        or (timerPart:FindFirstChild("BillboardGui") and timerPart.BillboardGui:FindFirstChildOfClass("TextLabel"))
                                        or (timerPart:FindFirstChild("SurfaceGui") and timerPart.SurfaceGui:FindFirstChildOfClass("TextLabel"))
                                        or timerPart:FindFirstChildWhichIsA("TextLabel", true) -- Recursive search
                                    if textLabel then
                                        local num = tonumber(textLabel.Text:match("%d+"))
                                        if num and num > 1 then
                                            isSafe = true
                                        end
                                    else
                                        -- 4. Check color fallback (green usually means safe/active)
                                        if timerPart:IsA("BasePart") and timerPart.Color.G > 0.6 then
                                            isSafe = true
                                        end
                                    end
                                end
                            end
                        end)
                        if not isSafe then task.wait(0.05) end -- 0.05s check for instant reaction
                    end
                else
                    task.wait(0.1)
                end
            elseif special.type == "wait_tsunami" then
                -- Stage 67: Bulletproof tsunami crossing
                -- LIVE DATA CYCLE (~7 seconds):
                --  1. Tsunami moves left: X=220  X=-460, timer 5.00.1
                --  2. RESET: tsunami teleports to X≈220, timer resets to 5.0
                --  3. Tsunami immediately starts moving left again
                -- SAFE WINDOW: right after reset when tsX > 150 (spawn zone)
                -- DANGER: tsX between 120 and -550 (bridge zone)
                -- MUST cross IMMEDIATELY after reset — waiting kills you
                local CURRENT_NAV = Cfg.World == "World 2" and NAV_POINTS_W2 or NAV_POINTS_W1
                local p17 = CURRENT_NAV[17]
                local p18 = CURRENT_NAV[18]

                local function getTsunami()
                    local tsParent = workspace:FindFirstChild("NPC & Piege")
                    local tsObj = tsParent and tsParent:FindFirstChild("Tsunami1")
                    return tsObj and tsObj:FindFirstChild("Tsunami")
                end

                local function getTimer()
                    local tsParent = workspace:FindFirstChild("NPC & Piege")
                    local tsObj = tsParent and tsParent:FindFirstChild("Tsunami1")
                    local timerPart = tsObj and tsObj:FindFirstChild("TimerPart")
                    local timerGui = timerPart and timerPart:FindFirstChild("StageGui")
                    return timerGui and timerGui:FindFirstChild("Timer")
                end

                -- Wait for the RESET moment: tsunami in spawn zone (X > 150)
                -- After reset, timer is high (~5.0) and tsunami is at X≈220
                local function isSpawnZone()
                    local tsunami = getTsunami()
                    if not tsunami or not tsunami:IsA("BasePart") then return false end
                    return tsunami.Position.X > 150
                end

                local function isBridgeZone()
                    local tsunami = getTsunami()
                    if not tsunami or not tsunami:IsA("BasePart") then return false end
                    local tsX = tsunami.Position.X
                    return tsX <= 150 and tsX >= -500
                end

                -- Wait for spawn zone with quick confirmation (only 3 frames = 0.3s)
                local ready = false
                while Cfg.AutoWin and not ready do
                    local spawnCount = 0
                    for _ = 1, 3 do
                        if isSpawnZone() then
                            spawnCount = spawnCount + 1
                        else
                            spawnCount = 0
                        end
                        task.wait(0.1)
                    end
                    if spawnCount >= 3 then ready = true end
                    -- If bridge zone active, wait for next cycle
                    if isBridgeZone() then
                        -- Wait until tsunami passes or resets
                        local waitStart = os.clock()
                        while isBridgeZone() and (os.clock() - waitStart) < 8 and Cfg.AutoWin do
                            task.wait(0.1)
                        end
                    end
                end
                if not Cfg.AutoWin then return end

                -- CROSS IMMEDIATELY at MAX SPEED
                -- Total bridge distance ~539 studs, at 2500 studs/s = 0.22s
                -- Tsunami takes ~0.5s to reach bridge from spawn  we have time
                local totalDist = (p18 - p17).Magnitude
                local crossSpeed = math.min(Cfg.WinTweenSpeed or 2000, 2500)

                local function isTsunamiDanger()
                    local tsunami = getTsunami()
                    if not tsunami or not tsunami:IsA("BasePart") then return false end
                    local r = getRoot()
                    if not r then return false end
                    local tsX = tsunami.Position.X
                    local dist = (tsunami.Position - r.Position).Magnitude
                    -- Danger if tsunami is close to player
                    if dist < 100 then return true end
                    -- Danger if tsunami entered bridge zone and is approaching player
                    if tsX <= 120 and tsX > r.Position.X - 50 then return true end
                    return false
                end

                -- Single fast tween across the bridge with danger check
                local r = getRoot()
                if r then
                    local ok = moveSegment(r.Position, p18, crossSpeed, isTsunamiDanger)
                    if not ok then
                        -- Danger hit: retreat and wait for next reset cycle
                        local r2 = getRoot()
                        if r2 then moveSegment(r2.Position, p17, crossSpeed) end
                    end
                end
            elseif special.type == "wait_walls" then
                -- Stage 78: single fast tween across corridor with retry loop
                local function getWalls()
                    local tr = workspace:FindFirstChild("NPC & Piege")
                    local trap = tr and tr:FindFirstChild("CorridorTrap")
                    return trap and trap:FindFirstChild("WallR"), trap and trap:FindFirstChild("WallL")
                end
                local function checkWallsSafe()
                    local wr, wl = getWalls()
                    if not wr or not wl or not wr.Parent or not wl.Parent then return false end
                    if (wr.Position - wl.Position).Magnitude < 100 then return false end
                    return true
                end
                local function isWallDanger()
                    local wr, wl = getWalls()
                    if not wr or not wl then return false end
                    if (wr.Position - wl.Position).Magnitude < 80 then return true end
                    return false
                end

                local CURRENT_CFG = Cfg.World == "World 2" and STAGE_WIN_CFG_W2 or STAGE_WIN_CFG_W1
                local CURRENT_NAV = Cfg.World == "World 2" and NAV_POINTS_W2 or NAV_POINTS_W1
                local winCfg = CURRENT_CFG[Cfg.AutoWinTargetStage or 2]
                if winCfg and winCfg.pos.X < -800 and Cfg.AutoWin then
                    local stageTarget = Cfg.AutoWinTargetStage or 2
                    -- For Stage 8, cross directly to win block so we never overshoot p19
                    local crossTarget = (stageTarget == 8 and winCfg.pos) or CURRENT_NAV[19]
                    local crossSpeed = math.min(Cfg.WinTweenSpeed or 2000, 2200)
                    -- Retry loop
                    while Cfg.AutoWin do
                        -- Wait for walls to open (5 consecutive frames = 0.5s)
                        local consecutiveSafe = 0
                        while Cfg.AutoWin do
                            if checkWallsSafe() then
                                consecutiveSafe = consecutiveSafe + 1
                            else
                                consecutiveSafe = 0
                            end
                            if consecutiveSafe >= 5 then break end
                            task.wait(0.1)
                        end
                        if not Cfg.AutoWin then return end

                        local cr = getRoot()
                        if not cr then return end
                        local ok = moveSegment(cr.Position, crossTarget, crossSpeed, isWallDanger)
                        if ok then
                            if stageTarget == 8 then
                                return -- Stage 8: already at win block, stop navigateNavPoints here
                            end
                            break -- Stage 9+: success, exit retry loop
                        end
                        -- Danger: retreat to Stage-7 side and retry
                        local r2 = getRoot()
                        if r2 then moveSegment(r2.Position, CURRENT_NAV[18], crossSpeed) end
                    end
                end
            elseif special.type == "wait_lava" then
                -- Only wait for lava if target stage is 9+ (Stage 8 win block is before the lava)
                if (Cfg.AutoWinTargetStage or 2) < 9 then
                    -- Skip lava wait for Stage 8 and below
                else
                -- Stage 9 path: robust lava wait with consecutive safe checks
                -- Live data: LavaPart.Y cycles from -71.5 (safe/bottom) up to 171.5 (top)
                -- Floor is at Y=54.50. Lava is safe only when well below the floor.
                local function getLava()
                    local lt = workspace:FindFirstChild("NPC & Piege")
                    local tower = lt and lt:FindFirstChild("LavaTower")
                    return tower and tower:FindFirstChild("LavaPart")
                end
                local function checkLavaSafe()
                    local lp = getLava()
                    if not lp or not lp:IsA("BasePart") or not lp.Parent then return true end
                    -- Safe only when lava center is well below the map floor (Y < -55)
                    -- At Y=-55, top of lava is at Y=66 which is safely below floor (54.50)
                    -- At Y=-71 (fully down), completely safe
                    if lp.Position.Y < -55 then return true end
                    return false
                end
                local consecutiveSafe = 0
                while Cfg.AutoWin do
                    local safe = checkLavaSafe()
                    if safe then
                        consecutiveSafe = consecutiveSafe + 1
                    else
                        consecutiveSafe = 0
                    end
                    -- Need 15 consecutive safe frames (~1.5s) to be absolutely sure
                    if consecutiveSafe >= 15 then break end
                    task.wait(0.1)
                end
                end -- close else (stage 9+ only)
            end
        end
    end
end

-- Find the closest NAV_POINT index to a given position
-- World-aware: only searches in the selected world's waypoints
local function findClosestNavIdx(pos, worldOverride)
    local world = worldOverride or Cfg.World
    local CURRENT_NAV = world == "World 2" and NAV_POINTS_W2 or NAV_POINTS_W1
    local bestIdx, bestDist = 1, math.huge
    for i, pt in ipairs(CURRENT_NAV) do
        local d = (pt - pos).Magnitude
        if d < bestDist then bestDist = d; bestIdx = i end
    end
    return bestIdx
end

