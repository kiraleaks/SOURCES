-- Direct remote fire with exact names
local function fireAuraRemote(name, ...)
    local rem = ReplicatedStorage:WaitForChild("Remotes"):FindFirstChild(name)
    if rem then
        if rem:IsA("RemoteFunction") then
            local ok, res1, res2 = pcall(function(args) return rem:InvokeServer(unpack(args)) end, {...})
            return ok
        else
            pcall(function(...) rem:FireServer(...) end, ...)
            return true
        end
    end
    return false
end

local function buyAura(name)
    return fireAuraRemote("BuyAura", name, "Wins")
end
local function equipAura(name)
    return fireAuraRemote("EquipAura", name)
end
local function buyTrail(name)
    return fireAuraRemote("BuyTrail", name, "Wins")
end
