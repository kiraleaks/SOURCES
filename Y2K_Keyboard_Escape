local function doWinCycle(onDone)
    -- Wait for character to be fully loaded and alive
    local char = LocalPlayer.Character
    local root = char and char:WaitForChild("HumanoidRootPart", 5)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    while (not char or not root or not hum or hum.Health <= 0) and Cfg.AutoWin do
        task.wait(0.1)
        char = LocalPlayer.Character
        root = char and char:WaitForChild("HumanoidRootPart", 5)
        hum = char and char:FindFirstChildOfClass("Humanoid")
    end
    if not Cfg.AutoWin or not root then if onDone then onDone() end return end

    local startWins = getTrophies()

    local stageNum = Cfg.AutoWinTargetStage or 2
    local STAGE_CFG = Cfg.World == "World 2" and STAGE_WIN_CFG_W2 or STAGE_WIN_CFG_W1
    local winCfg   = STAGE_CFG[stageNum]
    if not winCfg then stageNum = 2; winCfg = STAGE_CFG[2] end

    local stageData = getStageByNum(stageNum)
    local winPos    = winCfg.pos
    local navEndIdx = winCfg.navEnd

    -- 1. Delete all obstacles if in World 2
    if Cfg.World == "World 2" then
        disableWorld2Traps()
    end

    -- 2. Stream target area
    pcall(function() LocalPlayer:RequestStreamAroundAsync(winPos) end)

    -- 2. Noclip + continuous heal
    local wasFlying = Cfg.Fly
    if Cfg.Fly then StopFly() end
    enableNoclip()
    local healConn = RunService.Heartbeat:Connect(function()
        local h = getHum()
        if h then pcall(function() h.Health = h.MaxHealth end) end
    end)
    table.insert(_conns, healConn)

    local speed = math.max(100, Cfg.WinTweenSpeed or 2000)


    -- 3. Compute navigation range:
    --    targetNavIdx = nav point closest to the WinBlock (never overshoot)
    --    startIdx     = nav point closest to the player's current position
    --    Both computed dynamically so the path is always optimal.
    local CURRENT_NAV = Cfg.World == "World 2" and NAV_POINTS_W2 or NAV_POINTS_W1
    local targetNavIdx = findClosestNavIdx(winPos, Cfg.World)
    -- Clamp to configured navEnd as safety upper bound (never go further than navEnd)
    if navEndIdx and targetNavIdx > navEndIdx then
        targetNavIdx = navEndIdx
    end

    -- Find closest nav point to player (works for both W1 and W2)
    local r = getRoot()
    local startIdx = 1
    if r then
        startIdx = findClosestNavIdx(r.Position, Cfg.World)
    end

    -- World 2: NO danger checks, simple straight navigation
    -- World 1: lava danger detector (active for Stage 9+ where LavaTower exists)
    local dangerCheck = nil
    if Cfg.World ~= "World 2" then
        local function isLavaDanger()
            if stageNum < 9 then return false end
            local lt = workspace:FindFirstChild("NPC & Piege")
            local tower = lt and lt:FindFirstChild("LavaTower")
            local lp = tower and tower:FindFirstChild("LavaPart")
            if not lp or not lp:IsA("BasePart") then return false end
            if lp.Position.Y < -40 then return false end
            local root = getRoot()
            if not root then return false end
            if (lp.Position - root.Position).Magnitude < 400 then return true end
            return false
        end
        dangerCheck = isLavaDanger
    end

    -- Navigate from player to the nav point closest to win block
    -- If startIdx > targetNavIdx, skip navigation (player is already past/at the win)
    if Cfg.AutoWin and targetNavIdx >= startIdx then
        navigateNavPoints(startIdx, targetNavIdx, speed, dangerCheck, winPos)
    end

    -- 4b. For stage 9+: move slightly deeper into the stage so the game
    -- clearly registers the player as being in the target stage (avoids
    -- getting credited for the previous stage's win). Stage 8 already
    -- has its win block right at the nav point, no need to push forward.
    -- World 2 doesn't need this adjustment
    -- REMOVED: This was causing player to go past win block then come back

    -- 5. Locate the WinBlock (scan + proximity fallback)
    local winBlock = nil
    if Cfg.AutoWin then
        local startScan = os.clock()
        while not winBlock and (os.clock() - startScan) < 2.5 and Cfg.AutoWin do
            winBlock = findWinBlockForStage(stageNum)
            if not winBlock then task.wait(0.05) end
        end
    end

    -- 6. Move to WinBlock and fire touch
    r = getRoot()
    if r and Cfg.AutoWin then
        local destination = (winBlock and winBlock.Position) or winPos
        local landPos = destination + Vector3.new(0, 0.5, 0)

        -- Final tween to landing pos above win block (with lava danger check for Stage 9+)
        -- World 2 doesn't have lava tower checks
        local wpsF = buildGroundWaypoints(r.Position, landPos)
        local j = 2
        while j <= #wpsF and Cfg.AutoWin do
            local cr = getRoot()
            if not cr then break end
            local ok = moveSegment(cr.Position, wpsF[j], speed, isLavaDanger)
            if not ok and Cfg.World ~= "World 2" then
                -- Lava danger: wait for it to subside then rebuild path (World 1 only)
                local waitStart = os.clock()
                while (os.clock() - waitStart) < 20 and Cfg.AutoWin do
                    local lp = workspace:FindFirstChild("NPC & Piege")
                        and workspace["NPC & Piege"]:FindFirstChild("LavaTower")
                        and workspace["NPC & Piege"].LavaTower:FindFirstChild("LavaPart")
                    if not lp or not lp:IsA("BasePart") or lp.Position.Y < -55 then break end
                    task.wait(0.1)
                end
                r = getRoot()
                if r then
                    wpsF = buildGroundWaypoints(r.Position, landPos)
                    j = 1
                else
                    break
                end
            end
            j = j + 1
        end

        -- Disable noclip before touching to ensure proper collision
        disableNoclip()

        -- Simulate landing state
        local hum = getHum()
        simulateLanding(r, hum)

        -- Snap exactly onto win block surface
        r = getRoot()
        if r then
            r.CFrame = CFrame.new(destination)
            task.wait(0.15)
        end

        -- Fire touch events (multiple times for reliability)
        local touchTarget = winBlock or findWinBlockNear(destination, 50)
        r = getRoot()
        if touchTarget and r then
            for i = 1, 3 do
                pcall(function() firetouchinterest(touchTarget, r, 0) end)
                task.wait(0.1)
                pcall(function() firetouchinterest(touchTarget, r, 1) end)
                task.wait(0.1)
            end
        end
    end

    -- 7. Short cooldown then cleanup
    task.wait(0.25)
    healConn:Disconnect()
    disableNoclip()
    if wasFlying then
        Cfg.Fly = true
        StartFly()
    end

    -- Wait for wins to increase (timeout 2.5s for lag)
    local startWait = os.clock()
    local winSuccess = false
    while (os.clock() - startWait) < 2.5 and Cfg.AutoWin do
        if getTrophies() > startWins then
            winSuccess = true
            break
        end
        task.wait(0.1)
    end

    if winSuccess then
        Cfg.sessionWins        = Cfg.sessionWins + 1
        Cfg.sessionWinTarget   = Cfg.sessionWinTarget + 1

        -- Wait for death and respawn BEFORE returning to spawn/hub
        waitForRespawn()

        -- 8. Return to hub (World 1)
        r = getRoot()
        if r then
            if Cfg.World ~= "World 2" then
                -- Return to World 1 hub
                r.CFrame = CFrame.new(1.87, 12, 7.76)
            end
        end
    else
        -- We failed to get the win (bug/lag). Restart the cycle!
        Library:Notify({Title="Auto Win", Description="Win undetected! Retrying...", Time=3})
    end

    if onDone then onDone() end
end

-- Continuous Stream Request Loop (keeps target area warm)
task.spawn(function()
    while not _DEAD do
        task.wait(1.5)
        if Cfg.AutoWin then
            pcall(function()
                local CURRENT_CFG = Cfg.World == "World 2" and STAGE_WIN_CFG_W2 or STAGE_WIN_CFG_W1
                local cfg = CURRENT_CFG[Cfg.AutoWinTargetStage or 2]
                if cfg then
                    LocalPlayer:RequestStreamAroundAsync(cfg.pos)
                end
            end)
        end
    end
end)

