        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("ModuleScript") and obj.Name == "Auras" then
                auraMod = require(obj)
                break
            end
        end
    end)
    local result = {}
    if auraMod and auraMod.AURAS then
        for k, v in pairs(auraMod.AURAS) do
