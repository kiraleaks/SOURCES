local obstacleDisabledParts = {}

local OBSTACLE_KEYWORDS = {"lava","kill","hazard","acid","poison","spike","death","void","fire","burn","toxic"}

local function isObstaclePart(part)
    if not part:IsA("BasePart") then return false end
    local n = part.Name:lower()
    for _,kw in ipairs(OBSTACLE_KEYWORDS) do
        if n:find(kw) then return true end
    end
    -- Also check parent name
    if part.Parent then
        local pn = part.Parent.Name:lower()
        for _,kw in ipairs(OBSTACLE_KEYWORDS) do
            if pn:find(kw) then return true end
        end
    end
    return false
end

-- PRECISE World-2 obstacle list (user-specified). Removes ONLY these, never the whole map.
local function disableWorld2Traps()
    pcall(function()
        local function killChild(parent, ...)
            local node = parent
            for _, seg in ipairs({ ... }) do
                if not node then return end
                node = node:FindFirstChild(seg)
            end
            if node then pcall(function() node:Destroy() end) end
        end
        local w2 = workspace:FindFirstChild("WORLD 2")
        local pl = workspace:FindFirstChild("Pieges & Lava")
        local np = workspace:FindFirstChild("NPC & Piege")
        if w2 then
            killChild(w2, "Stage2", "MovingWalls")
            -- Stage2 child #6 (exact index the user flagged)
            local s2 = w2:FindFirstChild("Stage2")
            if s2 then local c6 = s2:GetChildren()[6]; if c6 then pcall(function() c6:Destroy() end) end end
            -- Stage8 ventilateurs: clear every fan (covers indexes 2-9 + "Ventilateur")
            local s8 = w2:FindFirstChild("Stage8")
            local vent = s8 and s8:FindFirstChild("Ventilateurs")
            if vent then for _, f in ipairs(vent:GetChildren()) do pcall(function() f:Destroy() end) end end
        end
        if pl then
            killChild(pl, "Lava_Stage3")
            killChild(pl, "Twomps")
        end
        if np then
            killChild(np, "Tsunami1")
            killChild(np, "Tsunami2")
        end
        killChild(workspace, "NPC_MacaronMonster")
        killChild(workspace, "NPC9")
    end)
end

local function applyDeleteObstacles()
    local count = 0
    if Cfg.World == "World 2" then disableWorld2Traps() return 0 end  -- W2: precise list ONLY
    for _,part in ipairs(workspace:GetDescendants()) do
        if isObstaclePart(part) then
            pcall(function()
                if not obstacleDisabledParts[part] then
                    obstacleDisabledParts[part] = {CanTouch=part.CanTouch, CanCollide=part.CanCollide, Transparency=part.Transparency}
                end
                part.CanTouch      = false
                part.CanCollide    = false
                part.Transparency  = 0.75
                count = count + 1
            end)
        end
    end
    return count
end

local function restoreObstacles()
    for part,saved in pairs(obstacleDisabledParts) do
        pcall(function()
            part.CanTouch   = saved.CanTouch
            part.CanCollide = saved.CanCollide
            part.Transparency = saved.Transparency
        end)
    end
    obstacleDisabledParts = {}
end

-- Continuous obstacle watcher (catches newly loaded parts)
task.spawn(function()
    while not _DEAD do
        task.wait(0.5)
        if Cfg.DeleteObstacles then
