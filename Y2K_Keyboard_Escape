-- Get shop items (hardcoded from game data + dynamic scan)
local function getShopItems()
    local items = {}
    -- Hardcoded items discovered from MCP scans
    local knownItems = {
        {name="CaramelBow",        price=1000,  type="Item"},
        {name="PinkGummyBear",      price=5000,  type="Item"},
        {name="CookieBag",          price=5000,  type="Item"},
        {name="PinkHeartLollipop", price=2500,  type="Item"},
        {name="CupcakeMic",         price=2500,  type="Item"},
    }
    for _, item in ipairs(knownItems) do
        table.insert(items, item)
    end
    -- Also try to read from ItemsShopConfig if it exists
    local shopCfg = nil
    pcall(function()
        local mod = ReplicatedStorage:FindFirstChild("ItemsShopConfig")
        if mod then shopCfg = require(mod) end
    end)
    if shopCfg and type(shopCfg) == "table" then
        for k, v in pairs(shopCfg) do
            if type(v) == "table" then
                table.insert(items, {name=k, price=tonumber(v.Price or v.price or 0), type=v.Type or v.type or "Item"})
            end
        end
    end
    -- Remove duplicates by name
    local seen = {}
    local result = {}
    for _, item in ipairs(items) do
        if not seen[item.name] then
            seen[item.name] = true
            table.insert(result, item)
        end
    end
    return result
end

