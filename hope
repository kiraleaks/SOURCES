function AutoFarm:Start()
	if self._running then return end
	if isLobby or isMenu then return end
	self._running = true
	getgenv().KiraHub.State.MissionStartTime = os.clock()

	task.spawn(function()
		while self._running do
			local char = player.Character
			if char then
				local hrp = char:FindFirstChild("HumanoidRootPart")
				if hrp then hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0) end
			end
			task.wait()
		end
	end)

	task.spawn(function()
		-- Guard the whole farm loop: one unexpected error used to kill farming
		-- silently until rejoin. Errors now stop the loop and warn once.
		local ok, loopErr = pcall(function()
		local function isWavesMode()
			return workspace:FindFirstChild("Waves") ~= nil
		end

		-- Kira-style readiness: only require a live character + a loaded map.
		-- The old version required char.Main.W which does not always exist, so
		-- the loop waited forever and Auto Farm never started.
		local function checkReady()
			local char, hrp = KiraChar()
			if not (char and hrp) then return false end
			if isWavesMode() then
				return workspace:FindFirstChild("Titans") ~= nil
			end
			return workspace:FindFirstChild("Titans") ~= nil
				or workspace:FindFirstChild("Unclimbable") ~= nil
		end

		local readyDeadline = os.clock() + 30
		while self._running and not checkReady() and os.clock() < readyDeadline do
			task.wait(0.5)
		end
		if not self._running then return end

		if IsToggled("WaitBeforeFarmingToggle") then
			local waitSecs = GetOption("WaitBeforeFarmingSlider", 15)
			task.wait(waitSecs)
		end
		if not self._running then return end

		local titansFolder = workspace:FindFirstChild("Titans")
		local currentChar, root = nil, nil
		local attackTitanSpawnTime = nil

		local function updateCharState()
			local char = player.Character
			if not char then return false end
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if not hrp then return false end
			if char ~= currentChar then
				currentChar = char
				root = hrp
			end
			return true
		end

		local validNapes = {}
		local nextTitanCacheUpdate = 0
		local nextObjectiveCacheUpdate = 0
		local cachedObjectivePart = nil
		local masteryComboIndex = 1
		local lastMasteryPunch = 0

		while self._running do
			local wavesMode = workspace:FindFirstChild("Waves") ~= nil

			if getgenv().KiraHub.State.EmergencyStop then
				task.wait(0.1)
				continue
			end

			if IsToggled("SkinHunterToggle") and not isLobby then
				task.wait(1)
				continue
			end

			if IsToggled("FailSafeToggle") and getgenv().KiraHub.State.MissionStartTime then
				local elapsed = os.clock() - getgenv().KiraHub.State.MissionStartTime
				local limitSecs = GetOption("FailsafeMinutesSlider", 15) * 60
				if elapsed >= limitSecs then
					self:Stop()
					pcall(function() getRemote:InvokeServer("Functions", "Teleport", "Lobby") end)
					task.wait(0.5)
					pcall(function() TeleportService:Teleport(LOBBY_ID, player) end)
					break
				end
			end

			if player:GetAttribute("Cutscene") then task.wait(0.05) continue end

			-- Pause the farm while a refill trip is in progress (the refill loop
			-- tweens the character to a station and back). A watchdog releases
			-- the pause after 20s so a wedged refill can never leave the player
			-- hovering above the titans and never attacking again.
			if getgenv().KiraHub.State.Refilling then
				local rs = getgenv().KiraHub.State.RefillSince
				if not rs then
					getgenv().KiraHub.State.RefillSince = os.clock()
				elseif os.clock() - rs > 20 then
					getgenv().KiraHub.State.Refilling = false
					getgenv().KiraHub.State.RefillSince = nil
					local rc = getgenv().KiraHub.Refill
					if rc then rc.Refilling = false end
				end
				local c = player.Character
				local r = c and c:FindFirstChild("HumanoidRootPart")
				if r then r.AssemblyLinearVelocity = Vector3.zero end
				task.wait(0.1)
				continue
			else
				getgenv().KiraHub.State.RefillSince = nil
			end

			-- Old code hard-blocked here on CheckMissionExists() and on slotData.
			-- A failed Data/Copy (or a missing slot) froze auto farm forever.
			-- Only skip when the map itself is not loaded yet.
			if not wavesMode and not (workspace:FindFirstChild("Titans") or workspace:FindFirstChild("Unclimbable")) then
				task.wait(0.5)
				continue
			end

			local slotIndex = player:GetAttribute("Slot")
			local slotData = slotIndex and mapData and mapData.Slots and mapData.Slots[slotIndex]
			if not slotData and not wavesMode then
				pcall(function()
					local ok, res = pcall(function() return getRemote:InvokeServer("Data", "Copy") end)
					if ok and res then
						mapData = res
						slotData = slotIndex and res.Slots and res.Slots[slotIndex]
					end
				end)
			end

			if IsToggled("DieAtStreakToggle") then
				local streak = player:GetAttribute("Streak") or 0
				local threshold = GetOption("DieAtStreakSlider", 10000)
				if streak >= threshold then
					local char = player.Character
					if char then
						local hum = char:FindFirstChildOfClass("Humanoid")
						if hum then hum.Health = 0 end
					end
				end
			end

			-- Weapon detection: the LIVE HUD is authoritative during a fight,
			-- then the session slot, then the character rig / attributes. The
			-- old order trusted a stale slot snapshot (or a lingering "Spears"
			-- attribute) and could spend the whole raid classified as an empty
			-- spear loadout, which is why the player hovered without swinging.
			local weaponKind = GetCurrentWeapon()
			if weaponKind ~= "Blades" and weaponKind ~= "Spears" then
				weaponKind = slotData and slotData.Weapon
			end
			if weaponKind ~= "Blades" and weaponKind ~= "Spears" then
				weaponKind = KiraWeaponInfo() or getgenv().KiraHub.State.Weapon or "Blades"
			end
			if weaponKind ~= "Blades" and weaponKind ~= "Spears" then weaponKind = "Blades" end
			local isBlades = weaponKind == "Blades"
			getgenv().KiraHub.State.AttackCooldownVal = KiraSlashInterval
			getgenv().KiraHub.State.Weapon = weaponKind

			local playerCount = workspace:GetAttribute("Player_Count") or #Players:GetPlayers()
			if IsToggled("SoloOnlyToggle") and playerCount > 1 then
				self:Stop()
				pcall(function() getRemote:InvokeServer("Functions", "Teleport", "Lobby") end)
				task.wait(0.5)
				TeleportService:Teleport(LOBBY_ID, player)
				break
			end

			if not updateCharState() then task.wait(0.05) continue end
			titansFolder = workspace:FindFirstChild("Titans") or titansFolder

			local ws_ObjectiveFolder = workspace:FindFirstChild("Unclimbable")
				and workspace.Unclimbable:FindFirstChild("Objective")
			local rs_ObjectiveFolder = ReplicatedStorage:FindFirstChild("Objectives")
			local mapType = wavesMode and "Waves"
				or (workspace:GetAttribute("Type") or (mapData and mapData.Map and mapData.Map.Type))

			local isArmoredRaid = not wavesMode and ws_ObjectiveFolder and ws_ObjectiveFolder:FindFirstChild("Armored_Boss")
			local isFemaleRaid = (not wavesMode and rs_ObjectiveFolder and rs_ObjectiveFolder:FindFirstChild("Defeat_Annie"))
				or (not wavesMode and mapData and mapData.Map and mapData.Map.Objective == "Female Titan")
			local femaleExists = not wavesMode and ws_ObjectiveFolder and ws_ObjectiveFolder:FindFirstChild("Female_Boss")
			local attackExists = not wavesMode and ws_ObjectiveFolder and ws_ObjectiveFolder:FindFirstChild("Attack_Boss")
			local armoredTitan = not wavesMode and titansFolder and titansFolder:FindFirstChild("Armored_Titan")
			local hasReinerObjective = armoredTitan and armoredTitan:GetAttribute("State")

			local isColossalRaid = not wavesMode and (
				(rs_ObjectiveFolder and rs_ObjectiveFolder:FindFirstChild("Defeat_Bertholdt"))
				or (ws_ObjectiveFolder and ws_ObjectiveFolder:FindFirstChild("Colossal_Boss"))
			)

			local isDefendEren = (not wavesMode and rs_ObjectiveFolder and rs_ObjectiveFolder:FindFirstChild("Defend_Eren"))
				or (not wavesMode and mapData and mapData.Map and mapData.Map.Objective == "Attack Titan")
			local isDefendBoats = (not wavesMode and rs_ObjectiveFolder and rs_ObjectiveFolder:FindFirstChild("Defend_Boats"))
				or (not wavesMode and mapData and mapData.Map and mapData.Map.Objective == "Armored Titan")
			local isRaidMap = not wavesMode and (
				mapType == "Raids"
				or isArmoredRaid or isFemaleRaid or isColossalRaid
				or isDefendEren or isDefendBoats
			)
			local isRaidDefensePhase = (isDefendEren or isDefendBoats) and IsToggled("AutoFarmRaidsToggle")

			-- Missions and raids are farmed by separate toggles. Waves count as
			-- mission content. When the matching toggle is off, stay idle.
			local farmEnabled
			if wavesMode then
				farmEnabled = IsToggled("AutoKillToggle")
			elseif isRaidMap then
				farmEnabled = IsToggled("AutoFarmRaidsToggle")
			else
				farmEnabled = IsToggled("AutoKillToggle")
			end
			if not farmEnabled then
				if root then root.AssemblyLinearVelocity = Vector3.zero end
				KiraCancelFarmMove()
				task.wait(0.25)
				continue
			end

			if not wavesMode and isFemaleRaid and not femaleExists and not attackExists then
				-- Female raid: only Female / Attack titans spawn. If the
				-- objective folder has not streamed in yet but a boss model is
				-- already there, fight it instead of idling forever.
				local raidBoss = titansFolder and (
					titansFolder:FindFirstChild("Female_Titan")
					or titansFolder:FindFirstChild("Attack_Titan")
				)
				if not raidBoss then
					task.wait(0.05)
					continue
				end
			end

			if not wavesMode and isColossalRaid then
				local stallObjective = rs_ObjectiveFolder and rs_ObjectiveFolder:FindFirstChild("Stall_Colossal_Titan")
				local stallDone = stallObjective and stallObjective.Value >= (stallObjective:GetAttribute("Requirement") or 1)
				if not stallDone then
					local walls = workspace:FindFirstChild("Climbable") and workspace.Climbable:FindFirstChild("Walls")
					local cannonModel = nil
					if walls then
						cannonModel = walls:FindFirstChild("Wall") and walls.Wall:FindFirstChild("Cannons") and walls.Wall.Cannons:FindFirstChild("1")
						if not cannonModel then
							for _, wall in ipairs(walls:GetChildren()) do
								local c = wall:FindFirstChild("Cannons") and wall.Cannons:FindFirstChild("1")
								if c then cannonModel = c break end
							end
						end
					end
					if cannonModel and not self._colossalCannon then
						self._colossalCannon = true
						task.spawn(function()
							local function getLiveNapePos()
								local tf = workspace:FindFirstChild("Titans")
								local ct = tf and tf:FindFirstChild("Colossal_Titan")
								if not ct then return nil end
								local hit = ct:FindFirstChild("Hitboxes") and ct.Hitboxes:FindFirstChild("Hit")
								if hit and hit:FindFirstChild("Nape") then return hit.Nape.Position end
								local fake = ct:FindFirstChild("Fake")
								local head = fake and fake:FindFirstChild("Head")
								return head and head.Position or nil
							end
							local function isStallComplete()
								local so = ReplicatedStorage:FindFirstChild("Objectives")
									and ReplicatedStorage.Objectives:FindFirstChild("Stall_Colossal_Titan")
								return so and so.Value >= (so:GetAttribute("Requirement") or 1)
							end
							local function findCannonRef(...)
								local args = {...}
								local argCount = select("#", ...)
								for i = 1, argCount do
									local v = args[i]
									if typeof(v) == "Instance" then
										if v:IsA("Model") then return v end
									elseif typeof(v) == "table" then
										for _, item in pairs(v) do
											if typeof(item) == "Instance" and item:IsA("Model") then
												return item
											end
										end
									end
								end
								local fallback = workspace:FindFirstChild("Cannon")
								return fallback
							end
							-- Kira cannon multi-hit: re-fire the server Impact
							-- event several times per shot so one cannonball lands many hits.
							local hitsPerShot = math.clamp(tonumber(GetOption("CannonHitsSlider", 10)) or 10, 1, 30)
							local function fireCannonHits(ref, count)
								if not ref then return 0 end
								local fired = 0
								for i = 1, count do
									if not self._running or not self._colossalCannon then break end
									local napePos = getLiveNapePos()
									if not napePos then break end
									pcall(function() postRemote:FireServer("S_Skills", "Impact", ref, napePos) end)
									fired = fired + 1
									if i < count then task.wait(0.045) end
								end
								return fired
							end
							local serverImpactAt = 0
							local impactConn = postRemote.OnClientEvent:Connect(function(...)
								local a1, a2 = ...
								if a1 ~= "Skills" or a2 ~= "Impact" then return end
								if not self._colossalCannon then return end
								serverImpactAt = os.clock()
								local ref = findCannonRef(select(3, ...)) or cannonModel
								if not ref then return end
								task.spawn(function() fireCannonHits(ref, hitsPerShot) end)
							end)
							while self._running and not isStallComplete() do
								pcall(function() getRemote:InvokeServer("Cannon", "State", cannonModel, true) end)
								task.wait(0.3)
								serverImpactAt = 0
								local shootOk = false
								for shootAttempt = 1, 3 do
									shootOk = pcall(function()
										getRemote:InvokeServer("Cannon", "Shoot", {BarrelWood = 40, Base = 0})
									end)
									if shootOk then break end
									task.wait(0.1)
								end
								if shootOk then
									local waitUntil = os.clock() + 0.8
									while os.clock() < waitUntil and serverImpactAt == 0 do task.wait(0.05) end
									if serverImpactAt == 0 then
										fireCannonHits(cannonModel, hitsPerShot)
									end
								end
								task.wait(1.2)
							end
							impactConn:Disconnect()
							pcall(function() getRemote:InvokeServer("Cannon", "State", cannonModel, false) end)
							self._colossalCannon = false
						end)
					end
					task.wait(0.05)
					continue
				end
			end

			if math.fmod(os.clock(), 0.5) < 0.05 then
				pcall(function()
					if root then root.CanCollide = false end
				end)
			end

			local now = os.clock()
			local isShifted = currentChar and currentChar:GetAttribute("Shifter") or false

			if IsToggled("MasteryFarmToggle") then
				local shiftReady = player:GetAttribute("Bar") and player:GetAttribute("Bar") == 100
				if not isShifted and shiftReady then
					repeat
						pcall(function() getRemote:InvokeServer("S_Skills", "Usage", "999", false) end)
						task.wait(1)
					until not self._running or (player.Character and player.Character:GetAttribute("Shifter"))
					continue
				end
			end

			if now >= nextTitanCacheUpdate then
				nextTitanCacheUpdate = now + 0.1
				table.clear(validNapes)
				if titansFolder then
					for _, v in ipairs(titansFolder:GetChildren()) do
						if v:IsA("Model") and KiraTitanAlive(v) then
							local nape = KiraNape(v)
							if nape then
								if IsToggled("AutoIceburstToggle") then
									local isIceburst = v:GetAttribute("Type") == "Iceburst" or v.Name:find("Iceburst")
									if isIceburst then table.insert(validNapes, 1, nape)
									else table.insert(validNapes, nape) end
								else
									table.insert(validNapes, nape)
								end
							end
						end
					end
				end
			end

			if #validNapes == 0 then
				getgenv().KiraHub.State._sawZeroTitans = true
				if root then root.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end
				task.wait(0.05)
				continue
			end

			-- Kira "Hold Last Titan": while the wait timer is running, keep
			-- (alive - 1) distinct titans alive instead of freezing on the final
			-- titan. The last titan is only released once the timer expires.
			local holdNapes = validNapes
			do
				local state = getgenv().KiraHub.State
				if not wavesMode and IsToggled("LastTitanWaitToggle") and not isRaidMap then
					local holdTime = GetOption("LastTitanWaitSlider", 60)
					local aliveCount = 0
					if titansFolder then
						for _, m in ipairs(titansFolder:GetChildren()) do
							if m:IsA("Model") and KiraTitanAlive(m) then
								aliveCount = aliveCount + 1
							end
						end
					end
					if aliveCount <= 0 then
						state.HoldTitanZeroSince = state.HoldTitanZeroSince or now
					else
						if not state.HoldTitanStart
							or (state.HoldTitanZeroSince and now - state.HoldTitanZeroSince > 20)
						then
							state.HoldTitanStart = now
						end
						state.HoldTitanZeroSince = nil
					end

					local safeLeft = 0
					if state.HoldTitanStart then
						safeLeft = math.max(0, holdTime - (now - state.HoldTitanStart))
					end
					state.HoldSafeLeft = safeLeft

					if safeLeft > 0 then
						local order, modelMap = {}, {}
						for _, nape in ipairs(validNapes) do
							local model = nape
							while model and model.Parent ~= titansFolder do
								model = model.Parent
							end
							if model then
								if not modelMap[model] then
									modelMap[model] = {}
									order[#order + 1] = model
								end
								modelMap[model][#modelMap[model] + 1] = nape
							end
						end
						local keepModels = math.max(0, #order - 1)
						local kept = {}
						for i = 1, keepModels do
							for _, nape in ipairs(modelMap[order[i]]) do
								kept[#kept + 1] = nape
							end
						end
						holdNapes = kept
					end
				else
					state.HoldTitanStart = nil
					state.HoldTitanZeroSince = nil
					state.HoldSafeLeft = 0
				end
			end

			-- Kira "safe time": restart the last-titan timer whenever a fresh
			-- wave of titans spawns, otherwise the timer is stale across maps.
			if getgenv().KiraHub.State._sawZeroTitans then
				getgenv().KiraHub.State._sawZeroTitans = false
				getgenv().KiraHub.State._missionStartClock = os.clock()
				getgenv().KiraHub.State.HoldTitanStart = nil
				getgenv().KiraHub.State.HoldTitanZeroSince = nil
			end

			-- Kira "Wait for Boss": do not burn the boss window on adds while
			-- the raid boss is still spawning / anchored / missing its hitbox.
			if IsToggled("WaitForBossToggle") and not wavesMode and titansFolder then
				local bossModel = nil
				for _, m in ipairs(titansFolder:GetChildren()) do
					if m:IsA("Model") and getgenv().KiraHub.Data.BossNames[m.Name] and KiraTitanAlive(m) then
						bossModel = m
						break
					end
				end
				if bossModel then
					local state = getgenv().KiraHub.State
					if state.BossWatch ~= bossModel then
						state.BossWatch = bossModel
						state.BossSeenAt = os.clock()
					end
					local hum = bossModel:FindFirstChildOfClass("Humanoid")
					local primary = bossModel.PrimaryPart or bossModel:FindFirstChild("HumanoidRootPart")
					local settle = GetOption("BossSettleSlider", 5)
					local notReady = (not primary) or primary.Anchored
						or (hum and hum.MaxHealth <= 0) or (not KiraNape(bossModel))
					if notReady or (os.clock() - (state.BossSeenAt or 0)) < settle then
						if root then root.AssemblyLinearVelocity = Vector3.zero end
						task.wait(0.1)
						continue
					end
				end
			end

			local rootPos = root.Position
			local referencePos = rootPos
			local objectiveFound = false

			if not wavesMode and now >= nextObjectiveCacheUpdate then
				nextObjectiveCacheUpdate = now + 1
				cachedObjectivePart = nil
				if ws_ObjectiveFolder then
					for _, desc in ipairs(ws_ObjectiveFolder:GetDescendants()) do
						if desc:IsA("BillboardGui") and desc.Parent and desc.Parent:IsA("BasePart") then
							cachedObjectivePart = desc.Parent
							break
						end
					end
				end
			end

			if not wavesMode and cachedObjectivePart and cachedObjectivePart.Parent then
				referencePos = cachedObjectivePart.Position
				objectiveFound = true
			end

			if isRaidDefensePhase and objectiveFound then
				referencePos = cachedObjectivePart.Position
			end

			local useRangeLimit = not wavesMode and objectiveFound and isArmoredRaid and not hasReinerObjective
			local closestDist, closestNape = math.huge, nil
			local closestIsBoss = false
			local bossDist, bossHitPoint = math.huge, nil
			local femaleDist, femaleNape = math.huge, nil
			local attackDist, attackNape = math.huge, nil
			local attackTitanFound = false
			local highestZ = -math.huge
			local isStall = not wavesMode and mapData and mapData.Map and mapData.Map.Objective == "Stall"
			local bossIsRoaring = false

			for i = 1, #holdNapes do
				local nape = holdNapes[i]
				if not nape or not nape.Parent then continue end
				local titanModel = KiraNapeModel(nape)
				if not KiraTitanAlive(titanModel) then continue end
				local tName = titanModel.Name
				local isBoss = getgenv().KiraHub.Data.BossNames[tName]
				-- Raid / wave bosses are always eligible targets now. The old
				-- "no State attribute" and Armored-raid guards silently skipped
				-- the raid boss, so the script only ever fought adds.
				local isRoaring = not wavesMode and isBoss and (
					titanModel:GetAttribute("Attack") == "Roar"
					or titanModel:GetAttribute("Attack") == "Berserk_Mode"
				)
				if tName == "Attack_Titan" then attackTitanFound = true end
				local dx = referencePos.X - nape.Position.X
				local dz = referencePos.Z - nape.Position.Z
				local d = dx * dx + dz * dz
				local adjustedDist = d
				if getgenv().KiraHub.State.TargetNape == nape then adjustedDist = adjustedDist - 15000 end
				if useRangeLimit and d > 90000 then continue end
				if isBoss then
					-- Always register on the nape, never on Marker/other body parts.
					local hitPart = KiraNape(titanModel)
					if hitPart and adjustedDist < bossDist then
						bossDist = adjustedDist
						bossHitPoint = hitPart
						bossIsRoaring = isRoaring
					end
				end
				if not wavesMode then
					if tName == "Female_Titan" and adjustedDist < femaleDist then
						femaleDist = adjustedDist
						femaleNape = nape
					elseif tName == "Attack_Titan" and adjustedDist < attackDist then
						attackDist = adjustedDist
						attackNape = nape
					end
				end
				if isStall then
					if nape.Position.Z > highestZ then highestZ = nape.Position.Z closestNape = nape end
				elseif adjustedDist < closestDist then
					closestDist = adjustedDist
					closestNape = nape
					closestIsBoss = isBoss
				end
			end

			local targetPart, targetIsRoaring = nil, false

			if wavesMode then
				-- Waves: bosses first. Previously this always took the nearest
				-- add, so a wave boss was never touched while adds were alive.
				targetPart = bossHitPoint or closestNape
				targetIsRoaring = (targetPart == bossHitPoint) and bossIsRoaring or false
			elseif isRaidMap then
				if isFemaleRaid then
					-- Female raid: only Female / Attack titans exist. Take the
					-- nearest of those (Female first), then any boss nape.
					targetPart = femaleNape or attackNape or bossHitPoint or closestNape
					targetIsRoaring = (targetPart == bossHitPoint) and bossIsRoaring or false
				elseif isDefendEren or isDefendBoats then
					-- Objective defense: referencePos is the objective marker
					-- (Eren / the boats), so nearest-to-reference is the threat.
					targetPart = closestNape or bossHitPoint
					targetIsRoaring = (targetPart == bossHitPoint) and bossIsRoaring or false
				else
					local prio = GetOption("RaidPriorityDropdown", "Boss First")
					if prio == "Boss First" then
						targetPart = bossHitPoint or closestNape
						targetIsRoaring = (targetPart == bossHitPoint) and bossIsRoaring or false
					elseif prio == "Adds First" then
						targetPart = closestNape or bossHitPoint
						targetIsRoaring = (targetPart == bossHitPoint) and bossIsRoaring or false
					elseif prio == "Mixed" then
						if math.random(1, 3) == 1 and bossHitPoint then
							targetPart = bossHitPoint
							targetIsRoaring = bossIsRoaring
						else
							targetPart = closestNape or bossHitPoint
							targetIsRoaring = (targetPart == bossHitPoint) and bossIsRoaring or false
						end
					else
						targetPart = closestNape
						if targetPart == bossHitPoint then targetIsRoaring = bossIsRoaring end
					end
				end
			else
				-- Missions: hit the titans in a random order. Keep the pick for a
				-- short window so the movement tween does not thrash. When the
				-- "Wait for last titan" hold is active, holdNapes is empty and the
				-- final titan is deliberately left alone until the timer expires.
				local state = getgenv().KiraHub.State
				if #holdNapes == 0 then
					targetPart = nil
				else
					local pick = state.MissionTarget
					if not pick or not pick.Parent or (now - (state.MissionTargetAt or 0)) > 2.5
						or not KiraTitanAlive(KiraNapeModel(pick))
						or not table.find(holdNapes, pick)
					then
						pick = holdNapes[math.random(1, #holdNapes)]
						state.MissionTarget = pick
						state.MissionTargetAt = now
					end
					targetPart = pick or closestNape
					if targetPart == bossHitPoint then targetIsRoaring = bossIsRoaring end
				end
			end

			if useRangeLimit and closestNape then
				targetPart = closestNape
				targetIsRoaring = false
			end

			if not getgenv().KiraHub.State._missionStartClock then getgenv().KiraHub.State._missionStartClock = os.clock() end

			getgenv().KiraHub.State.TargetNape = targetPart
			if attackTitanFound then
				attackTitanSpawnTime = attackTitanSpawnTime or now
			else
				attackTitanSpawnTime = nil
			end
			local attackTitanReady = not attackTitanFound
				or (attackTitanSpawnTime and (now - attackTitanSpawnTime) >= 1.5)

			if targetPart then
				local currentTitanModel = targetPart
				while currentTitanModel and currentTitanModel.Parent ~= titansFolder do
					currentTitanModel = currentTitanModel.Parent
				end

				if isShifted then
					local targetHRP = currentTitanModel and currentTitanModel:FindFirstChild("HumanoidRootPart")
					local targetCFrame = targetHRP and targetHRP.CFrame or targetPart.CFrame
					local state = getgenv().KiraHub.State
					local stancePos = targetCFrame.Position - targetCFrame.LookVector * 80
					if state.MasteryStanceTarget ~= targetPart
						or (root.Position - stancePos).Magnitude > 30
					then
						state.MasteryStanceTarget = targetPart
						KiraFarmMove(root, stancePos, 2000, targetPart, 0.5)
					end
					local mode = GetOption("MasteryModeDropdown", "Both")
					local doPunch = mode == "Punching" or mode == "Both"
					local doSkills = mode == "Skill Usage" or mode == "Both"
					do
						-- Attacks always run, even while a boss is roaring. The
						-- old "not targetIsRoaring" gate idled the whole farm
						-- whenever a raid boss's Attack attribute stayed on
						-- Roar / Berserk_Mode, which is the hovering bug.
						if doPunch and (now - lastMasteryPunch) >= 1 then
							lastMasteryPunch = now
							postRemote:FireServer("Attacks", "Slash", true)
							postRemote:FireServer("Hitboxes", "Register", targetPart, nil, nil, masteryComboIndex)
							masteryComboIndex = masteryComboIndex + 1
							if masteryComboIndex > 4 then masteryComboIndex = 1 end
						end
						if doSkills and slotData and slotData.Skills and slotData.Skills.Shifter
							and not getgenv().KiraHub.State.ShifterSkillsRunning
						then
							getgenv().KiraHub.State.ShifterSkillsRunning = true
							task.spawn(function()
								for _, skillId in ipairs(slotData.Skills.Shifter) do
									local idNum = tonumber(skillId)
									if idNum and idNum ~= 200 and idNum ~= 300 and idNum ~= 400
										and idNum ~= 210 and idNum ~= 211 and idNum ~= 306
										and idNum ~= 308 and idNum ~= 402 and idNum ~= 403 and idNum ~= 407
									then
										pcall(function() getRemote:InvokeServer("S_Skills", "Usage", tostring(skillId), false) end)
									end
									task.wait(1)
								end
								getgenv().KiraHub.State.ShifterSkillsRunning = false
							end)
						end
					end
					task.wait(0.05)
					continue
				end

				local titanHRP = currentTitanModel and currentTitanModel:FindFirstChild("HumanoidRootPart")
				local floatHeight = GetOption("FloatHeightSlider", 250)
				local targetHeightPos
				if titanHRP then
					targetHeightPos = (titanHRP.CFrame * CFrame.new(0, floatHeight, 30)).Position
				else
					targetHeightPos = targetPart.Position + Vector3.new(0, floatHeight, 0)
				end

				local moveMode = GetOption("MovementModeDropdown", "Hover")
				local moveSpeed = math.max(tonumber(GetOption("HoverSpeedSlider", 400)) or 400, 100)
				local moveKey = targetPart
				if isBlades and moveMode ~= "Teleport" then
					-- Blades: hold 400+ studs/s of momentum (more velocity =
					-- more blade damage) and orbit inside the attack ring
					-- instead of tweening to a stop above the titan.
					KiraCancelFarmMove()
					KiraBladeMomentum(root, targetHeightPos, targetPart)
				elseif moveMode == "Teleport" then
					KiraCancelFarmMove()
					root.AssemblyLinearVelocity = Vector3.zero
					root.AssemblyAngularVelocity = Vector3.zero
					root.CFrame = CFrame.new(targetHeightPos)
				elseif moveMode == "Tween Farm" then
					-- One linear tween per committed target. The Heartbeat lock
					-- keeps gravity from fighting the tween, so no vibration.
					KiraFarmMove(root, targetHeightPos, moveSpeed, moveKey, 8)
				else
					-- Hover: identical gliding tween (one linear tween per
					-- committed target). Re-issues only when the titan has moved
					-- more than 12 studs, so there is no per-frame snapping.
					KiraFarmMove(root, targetHeightPos, moveSpeed, moveKey, 4)
				end

				if not attackTitanReady then task.wait(0.05) continue end

				local dx = root.Position.X - targetPart.Position.X
				local dz = root.Position.Z - targetPart.Position.Z
				local attackRange = GetOption("AttackRangeSlider", 150)
				local AttackRangeSq = attackRange * attackRange
				local bladesReady = (KiraBladesEmpty() ~= true)
					and now >= (getgenv().KiraHub.State.BladeSettleUntil or 0)
				local spearAmmo = KiraSpearsLeft() or 0
				local canFallbackBlades = (#KiraBladeParts() > 0) or ((GetBladeSetCount() or 0) > 0)
				-- If detection says "spears" but there is no fireable spear (and
				-- the rig still has blades), swing the blades instead of idling
				-- above the titan waiting for a refill that is not needed.
				local useBlades = isBlades or (spearAmmo <= 0 and canFallbackBlades)

				-- One attack per 1.05s window on the committed nape. Blade swings
				-- follow the SH farm: safe mode is 1 nape / 1 hit request, and
				-- Multi Hit fans out over several napes with N pairs per nape.
				if (dx * dx + dz * dz) <= AttackRangeSq then
					local isBoss = IsBossTarget(targetPart)
					if useBlades then
						if bladesReady and KiraSlashGate(now, KiraMultiHitEnabled() and 0.4 or nil) then
							KiraBladeAttack(targetPart, holdNapes, isBoss)
						end
					elseif KiraSlashGate(now, KiraMultiHitEnabled() and 0.6 or nil) then
						-- Thunder spears: S_Fire expects a spear SLOT id (1..8),
						-- never the remaining ammo count. One spear + its
						-- explosion(s) per cycle, exactly like the old build.
						if spearAmmo > 0 then
							KiraRefreshSpearMarks()
							local spearId = KiraPickSpearId()
							local multi = KiraMultiHitEnabled()
							local multiTargets
							local reps = 1
							if multi then
								-- SH thunder farm: every live nape counts, and the
								-- explosion count comes from acquireTokens() -- a
								-- 150 events/s budget capped at 10 per target.
								multiTargets = {}
								for _, n in ipairs(holdNapes) do
									if n and n.Parent then
										multiTargets[#multiTargets + 1] = {part = n, pos = n.Position}
									end
								end
								if #multiTargets == 0 then
									multiTargets[1] = {part = targetPart, pos = targetPart.Position}
								end
								reps = math.max(1, math.min(10, math.floor(150 / math.max(#multiTargets, 1))))
							else
								if isBoss then
									reps = math.clamp(math.floor(tonumber(GetOption("BladeBossHitsSlider", 10)) or 10), 1, 60)
								end
								multiTargets = {{part = targetPart, pos = targetPart.Position}}
							end
							task.spawn(function()
								local function unusedSpears()
									local n = 0
									for _, unused in pairs(KiraSpearIds()) do
										if unused then n = n + 1 end
									end
									return n
								end
								local beforeUnused = unusedSpears()
								local beforeAmmo = KiraSpearsLeft()
								local okFire = pcall(function() getRemote:InvokeServer("Spears", "S_Fire", tostring(spearId)) end)
								if multi and okFire then
									-- SH verifies the spear actually left the slot
									-- before exploding; a refused shot never explodes.
									local deadline = os.clock() + 1.0
									local after = KiraSpearsLeft()
									while beforeAmmo ~= nil and after ~= nil and after >= beforeAmmo
										and os.clock() < deadline do
										task.wait()
										after = KiraSpearsLeft()
									end
									if beforeAmmo ~= nil and after ~= nil and after >= beforeAmmo then
										table.clear(kiraUsedSpearIds)
										getgenv().KiraHub.State.ForceSpearReset = true
										KiraRefreshSpearMarks()
										getgenv().KiraHub.State.RefillRequest = "Spears"
										return
									end
								end
								if not okFire then return end
								for _ = 1, reps do
									for _, t in ipairs(multiTargets) do
										if t.part and t.part.Parent then
											KiraNet:Fire(postRemote, "Spears", "S_Explode", t.pos, 0.10 + math.random() * 0.09)
										end
									end
								end
								if not multi then
									task.wait(0.5)
									if KiraSpearsLeft() == beforeAmmo and unusedSpears() >= beforeUnused then
										-- The server refused the shot (the "stuck at
										-- 1/12" bug). Free every slot mark and force
										-- a real station refill instead of retrying.
										table.clear(kiraUsedSpearIds)
										getgenv().KiraHub.State.ForceSpearReset = true
										KiraRefreshSpearMarks()
										getgenv().KiraHub.State.RefillRequest = "Spears"
									end
								end
							end)
						else
							-- Hand off to the refill loop (proper station refill).
							getgenv().KiraHub.State.RefillRequest = "Spears"
							local station = GetRefillStation(root)
							if station then
								KiraNet:Fire(postRemote, "Attacks", "Reload", station)
							end
						end
					end
				end
			else
				KiraCancelFarmMove()
				if root then root.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end
			end

			task.wait(0.05)
		end
		end)
		if not ok then
			self._running = false
			pcall(function() warn("[Kira Premium] farm loop error: " .. tostring(loopErr)) end)
		end
	end)
end

