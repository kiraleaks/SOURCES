KIRA_REFILL_PLACES = {
	[13379349730]     = {"Unclimbable", "Props", "HQ"},
	[14012874501]     = {"Unclimbable", "Props", "HQ"},
	[13904207646]     = {"Climbable", "_Walls", "Gate"},
	[14638336319]     = {"Unclimbable", "Camps", "Camp"},
	[15220308770]     = {"Climbable", "Utgard"},
