-- ============================================================================
--  [KIRA] COMBAT CORE
--  Ported from the proven farm/refill implementation:
--   - character-based weapon + ammo detection (no HUD dependency)
--   - batched remote sender (no more dropped / rate-limited hits)
--   - real refill flow: remote -> verify "Refills" attribute -> fly to station
--     -> press ProximityPrompt / R -> re-fire remote -> fly back
-- ============================================================================

local KiraNet = {
	Queue = {},
	Head = 1,
	Tail = 0,
	PerFrame = 20,
	MaxQueue = 800,
	Sent = 0,
}

function KiraNet:Fire(remote, ...)
	if not remote or not remote.Parent then return false end
	if (self.Tail - self.Head + 1) >= self.MaxQueue then return false end
	self.Tail = self.Tail + 1
	self.Queue[self.Tail] = {remote = remote, args = table.pack(...)}
	return true
end

function KiraNet:Flush(limit)
	local sent = 0
	limit = limit or self.PerFrame
	while self.Head <= self.Tail and sent < limit do
		local item = self.Queue[self.Head]
		self.Queue[self.Head] = nil
		self.Head = self.Head + 1
		sent = sent + 1
		if item and item.remote and item.remote.Parent then
			pcall(item.remote.FireServer, item.remote, table.unpack(item.args, 1, item.args.n))
			self.Sent = self.Sent + 1
		end
	end
	if self.Head > self.Tail then
		self.Head, self.Tail = 1, 0
	end
end

function KiraNet:Pending()
	return self.Tail - self.Head + 1
end

RunService.Heartbeat:Connect(function()
	if getgenv().KiraHubAOTR then
		pcall(function() KiraNet:Flush() end)
	end
end)

getgenv().KiraHub.Net = KiraNet

