function BuildMarketTab(TabRef)
	local MKT_Boost = TabRef:AddLeftGroupbox("Boosts", "zap")

	MKT_Boost:AddToggle("AutoBuyBoostsToggle", {Text = "Auto Buy Boosts", Default = false})
	Toggles.AutoBuyBoostsToggle:OnChanged(function() MarkDirty() end)

	MKT_Boost:AddDropdown("MarketBoostSelectDropdown", {
		Values = getgenv().KiraHub.Data.MarketBoostValues,
		Default = {},
		Multi = true,
		Text = "Select Boosts to Buy"
	})

	MKT_Boost:AddSlider("MarketBoostAmountSlider", {
		Text = "Amount",
		Default = 1,
		Min = 1,
		Max = 99,
		Rounding = 0
	})

	MKT_Boost:AddButton({Text = "Buy Now", Func = function()
		task.spawn(function()
			local selected = Options.MarketBoostSelectDropdown.Value or {}
			local amount = Options.MarketBoostAmountSlider.Value or 1
			local bought = 0
			for boostName, isActive in pairs(selected) do
				if isActive then
					local idx = getgenv().KiraHub.Data.BoostIndexMap[boostName]
					if idx then
						pcall(function() getRemote:InvokeServer("S_Market", "Buy", "1_Boosts", idx, amount) end)
						bought = bought + 1
						task.wait(0.3)
					end
				end
			end
			if bought == 0 then
				Library:Notify({Title = "Market", Description = "No boosts selected", Time = 3})
			else
				Library:Notify({Title = "Market", Description = "Bought " .. bought .. " boost(s)", Time = 3})
			end
		end)
	end})

	MKT_Boost:AddDivider()

	MKT_Boost:AddToggle("AutoUsePotionsToggle", {Text = "Auto Use Potions", Default = false})
	Toggles.AutoUsePotionsToggle:OnChanged(function() MarkDirty() end)

	MKT_Boost:AddDropdown("MarketUsePotionDropdown", {
		Values = getgenv().KiraHub.Data.MarketBoostValues,
		Default = {},
		Multi = true,
		Text = "Potions to Auto Use"
