local function applyFlatConfig(cfg)
	if not cfg or type(cfg) ~= "table" then return end
	task.spawn(function()
		task.wait(2)
		local lib = getgenv()._KiraLib
		if not lib then return end
		for key, val in pairs(cfg) do
			local toggleName = KiraHubToggleMap[key]
			if toggleName and lib.Toggles[toggleName] then pcall(function() lib.Toggles[toggleName]:SetValue(val) end) continue end
			local sliderName = KiraHubSliderMap[key]
			if sliderName and lib.Options[sliderName] then pcall(function() lib.Options[sliderName]:SetValue(val) end) continue end
			local dropdownName = KiraHubDropdownMap[key]
			if dropdownName and lib.Options[dropdownName] then pcall(function() lib.Options[dropdownName]:SetValue(val) end) continue end
			if key == "Modifiers" and type(val) == "table" and lib.Options["ModifiersDropdown"] then
				pcall(function() lib.Options["ModifiersDropdown"]:SetValue(val) end)
				continue
			end
			if lib.Toggles[key] then pcall(function() lib.Toggles[key]:SetValue(val) end) continue end
			if lib.Options[key] then pcall(function() lib.Options[key]:SetValue(val) end) end
		end
	end)
end

