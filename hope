function KiraTweenRoot(root, targetPos, speed)
	if not root or not targetPos then return end
	local dist = (root.Position - targetPos).Magnitude
	local duration = math.clamp(dist / (speed or 800), 0.1, 6)
	local ok, tween = pcall(function()
		return TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)})
	end)
	if not ok or not tween then
		pcall(function() root.CFrame = CFrame.new(targetPos) end)
		return
	end
	local conn = RunService.Heartbeat:Connect(function()
		pcall(function() root.AssemblyLinearVelocity = Vector3.zero end)
	end)
	tween:Play()
	local t0 = os.clock()
	while os.clock() - t0 < duration + 0.3 and tween.PlaybackState == Enum.PlaybackState.Playing do
		task.wait()
	end
	pcall(function() tween:Cancel() end)
	conn:Disconnect()
end

-- ============================================================
-- Farm movement: one linear tween per committed target, with the
-- root velocity locked every frame while it plays. No per-frame
-- CFrame writes, so the character glides instead of vibrating.
-- ============================================================
function KiraCancelFarmMove()
	local st = getgenv().KiraHub and getgenv().KiraHub.State
	if not st then return end
	if st.FarmTween then pcall(function() st.FarmTween:Cancel() end) end
	st.FarmTween = nil
	st.FarmMoveTarget = nil
	st.FarmMoveKey = nil
end

function KiraFarmMove(root, targetPos, speed, key, maxDur)
	if not root or not targetPos then return end
	local st = getgenv().KiraHub and getgenv().KiraHub.State
	if not st then return end
	local active = st.FarmTween
	local sameKey = key ~= nil and st.FarmMoveKey == key
	local committed = st.FarmMoveTarget
	local moved = committed and (targetPos - committed).Magnitude or math.huge
	if active and sameKey and active.PlaybackState == Enum.PlaybackState.Playing and moved < 12 then
		return
	end
	if active then pcall(function() active:Cancel() end) end
	local dist = (root.Position - targetPos).Magnitude
	if dist < 1.5 then
		st.FarmTween = nil
		st.FarmMoveTarget = targetPos
		st.FarmMoveKey = key
		return
	end
	local dur = math.clamp(dist / math.max(tonumber(speed) or 400, 80), 0.12, maxDur or 4)
	local ok, tween = pcall(function()
		return TweenService:Create(root, TweenInfo.new(dur, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)})
	end)
	if ok and tween then
		st.FarmTween = tween
		st.FarmMoveTarget = targetPos
		st.FarmMoveKey = key
		tween:Play()
	else
		pcall(function() root.CFrame = CFrame.new(targetPos) end)
	end
end

-- Global velocity lock for the farm tween (single Heartbeat connection).
RunService.Heartbeat:Connect(function()
	local st = getgenv().KiraHub and getgenv().KiraHub.State
	if not st then return end
	local tween = st.FarmTween
	if not tween or tween.PlaybackState ~= Enum.PlaybackState.Playing then return end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
end)

-- Slash + hit request sync: both are sent together once per interval.
-- Multi Hit shortens the window to SH's cadence (0.4s blades / 0.6s spears).
KiraSlashInterval = 1.05
function KiraSlashGate(now, interval)
	local st = getgenv().KiraHub and getgenv().KiraHub.State
	if not st then return false end
	now = now or os.clock()
	interval = interval or KiraSlashInterval
	local last = st.LastSlashAt or 0
	if now - last >= interval then
		st.LastSlashAt = now
		return true
	end
	return false
end

-- ============================================================================
--  Blade M1 + momentum
--
--  AOTR only registers blade hits on a real swing, so every blade attack also
--  taps M1 (aimed at a viewport point no visible GUI covers, so it can never
--  press a hub button). Blade damage scales with velocity, so while blades are
--  out the farm keeps the character moving at 400+ studs/s around the titan
--  instead of parking with zero speed.
-- ============================================================================
local kiraM1At = 0

function KiraM1()
	if not IsToggled("AutoM1Toggle") then return false end
	local now = os.clock()
	if now - kiraM1At < 0.08 then return false end
	local okFocus, focused = pcall(function() return UserInputService:GetFocusedTextBox() end)
	if okFocus and focused then return false end
	kiraM1At = now

	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local points = {
		Vector2.new(vp.X * 0.5, vp.Y * 0.5),
		Vector2.new(vp.X * 0.82, vp.Y * 0.5),
		Vector2.new(vp.X * 0.18, vp.Y * 0.5),
		Vector2.new(vp.X * 0.5, vp.Y * 0.8),
	}
	local gui = player:FindFirstChildOfClass("PlayerGui")
	local point = points[1]
	for _, c in ipairs(points) do
		local blocked = false
		if gui then
			local ok, objs = pcall(function() return gui:GetGuiObjectsAtPosition(c.X, c.Y) end)
			if ok and type(objs) == "table" then
				for _, o in ipairs(objs) do
					if o and o.Visible and o.AbsoluteSize.X > 0 and o.AbsoluteSize.Y > 0 then
						blocked = true
						break
					end
				end
			end
		end
		if not blocked then
			point = c
			break
		end
	end

	pcall(function()
		VirtualInputManager:SendMouseMoveEvent(point.X, point.Y, game)
		VirtualInputManager:SendMouseButtonEvent(point.X, point.Y, 0, true, game, 0)
	end)
	task.delay(0.04, function()
		pcall(function()
			VirtualInputManager:SendMouseButtonEvent(point.X, point.Y, 0, false, game, 0)
		end)
	end)
	return true
end

function KiraBladeMomentumSpeed()
	local v = tonumber(GetOption("HoverSpeedSlider", 400)) or 400
	return math.max(v, 400)
end

function KiraBladeMomentum(root, hoverPos, nape)
	local st = getgenv().KiraHub and getgenv().KiraHub.State
	if not (root and hoverPos and st) then return end
	local now = os.clock()
	local speed = KiraBladeMomentumSpeed()
	local aim = hoverPos
	if nape and nape.Parent then
		-- Rotate the aim point around the nape so the velocity vector keeps
		-- changing direction (that is what builds momentum) while the
		-- character stays well inside the horizontal attack ring.
		local range = tonumber(GetOption("AttackRangeSlider", 150)) or 150
		local radius = math.clamp(range * 0.45, 30, 120)
		if now >= (st.MomentumNextAt or 0) then
			st.MomentumNextAt = now + 0.35
			st.OrbitAngle = ((st.OrbitAngle or 0) + 1.1) % (math.pi * 2)
		end
		local ang = st.OrbitAngle or 0
		aim = Vector3.new(
			nape.Position.X + math.cos(ang) * radius,
			hoverPos.Y,
			nape.Position.Z + math.sin(ang) * radius
		)
	end
	local delta = aim - root.Position
	local mag = delta.Magnitude
	if mag < 0.5 then return end
	root.AssemblyLinearVelocity = (delta / mag) * speed
	root.AssemblyAngularVelocity = Vector3.zero
end

-- ============================================================================
--  Blade farm
--
--  Multi Hit OFF: one nape, one Slash + one hit request per 1.05s swing
--  (bosses keep their Blade Boss Hits loop). Safe, current behaviour.
--
--  Multi Hit ON: the SH blade farm -- the main nape plus every other live
--  nape, nearest first, capped at defaultThunderTargets() = 20, one
--  Slash + Register pair per nape per 0.4s. Raids, missions and waves all
--  use this same path.
-- ============================================================================
function KiraMultiHitEnabled()
	return IsToggled("MultiHitToggle") == true
end

function KiraBladeTargets(targetPart, validNapes)
	local list = {}
	if not (targetPart and targetPart.Parent) then return list end
	list[1] = targetPart
	if not KiraMultiHitEnabled() then return list end

	-- SH defaultThunderTargets() is 20; the blade list is that many napes.
	local want = 20
	local candidates = {}
	for _, n in ipairs(validNapes or {}) do
		if n ~= targetPart and n and n.Parent then
			if KiraTitanAlive(KiraNapeModel(n)) then
				candidates[#candidates + 1] = {
					part = n,
					d = (n.Position - targetPart.Position).Magnitude
				}
			end
		end
	end
	table.sort(candidates, function(a, b) return a.d < b.d end)
	for _, c in ipairs(candidates) do
		if #list >= want then break end
		list[#list + 1] = c.part
	end
	return list
end

function KiraBladeAttack(targetPart, validNapes, isBoss)
	local st = getgenv().KiraHub and getgenv().KiraHub.State
	if not st then return 0 end

	local list = KiraBladeTargets(targetPart, validNapes)
	if #list == 0 then return 0 end

	-- The server only accepts hit requests that belong to a real swing, so
	-- every blade attack taps M1 before the Slash + Register burst.
	KiraM1()

	local bossHits = math.clamp(math.floor(tonumber(GetOption("BladeBossHitsSlider", 10)) or 10), 1, 60)

	-- KiraNet's queue holds 800 events; stop well before it overflows.
	local sent = 0
	for _, nape in ipairs(list) do
		if nape and nape.Parent then
			-- SH sends one Slash + Register per nape. Bosses additionally get
			-- the tuned Blade Boss Hits loop so raids still finish.
			local hits = 1
			if isBoss then hits = math.max(1, bossHits) end
			for _ = 1, hits do
				if sent >= 700 then break end
				if nape.Parent then
					KiraNet:Fire(postRemote, "Attacks", "Slash", true)
					KiraNet:Fire(postRemote, "Hitboxes", "Register", nape, math.random(700, 900))
				end
				sent = sent + 2
			end
		end
		if sent >= 700 then break end
	end
	return sent
end


