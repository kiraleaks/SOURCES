		"https://cdn.jsdelivr.net/gh/deividcomsono/Obsidian@main/",
		"https://raw.gitmirror.com/deividcomsono/Obsidian/main/"
	}

	-- Robust download: game:HttpGet first, then request()/http_request() fallbacks.
	function KiraHttpGet(url)
		local ok, res = pcall(function() return game:HttpGet(url) end)
		if ok and type(res) == "string" and #res > 0 then return res end
		if type(request) == "function" then
			local ok2, r = pcall(request, {Url = url, Method = "GET"})
			if ok2 and type(r) == "table" and type(r.Body) == "string" and #r.Body > 0 then
				return r.Body
			end
		end
		if type(http_request) == "function" then
			local ok3, r = pcall(http_request, {Url = url, Method = "GET"})
			if ok3 and type(r) == "table" and type(r.Body) == "string" and #r.Body > 0 then
				return r.Body
			end
		end
		return nil
	end

	function KiraLoadModule(relPath)
		local loader = loadstring or load
		if type(loader) ~= "function" then
			lib_errors[#lib_errors + 1] = relPath .. ": loadstring unavailable"
			return nil
		end
		for _, base in ipairs(repoMirrors) do
			for _ = 1, 2 do
				local src = KiraHttpGet(base .. relPath)
				if src then
					local ok, mod = pcall(loader(src))
					if ok and mod then return mod end
					lib_errors[#lib_errors + 1] = relPath .. ": " .. tostring(mod)
				else
					lib_errors[#lib_errors + 1] = relPath .. ": download failed"
				end
				task.wait(0.25)
			end
		end
		return nil
	end

	task.spawn(function()
		Library = KiraLoadModule("Library.lua")
		lib_count = lib_count + 1
	end)

	task.spawn(function()
		ThemeManager = KiraLoadModule("addons/ThemeManager.lua")
		lib_count = lib_count + 1
	end)

	task.spawn(function()
		SaveManager = KiraLoadModule("addons/SaveManager.lua")
		lib_count = lib_count + 1
	end)

	local libWaitStart = os.clock()
	repeat task.wait(0.1) until lib_count >= 3 or os.clock() - libWaitStart > 45

	pcall(function() print("[Kira Premium] libraries: " .. tostring(Library ~= nil) .. "/" .. tostring(ThemeManager ~= nil) .. "/" .. tostring(SaveManager ~= nil)) end)

	if not Library then
		local detail = table.concat(lib_errors, " | ")
		if #detail > 180 then detail = detail:sub(1, 180) .. "..." end
		pcall(function() print("[Kira Premium] Library load failed: " .. detail) end)
		pcall(function()
			StarterGui:SetCore("SendNotification", {
				Title = "Kira Hub Premium",
				Text = "Library failed to load. Check your executor's HTTP (HttpGet/request) support.",
				Duration = 10
			})
		end)
		getgenv().KiraHubAOTR = false
		getgenv().KiraHubLoading = false
		return
	end
end

