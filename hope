		local char, hrp = KiraChar()
		if not (char and hrp) then continue end

		if char ~= currentTrackedChar then
			currentTrackedChar = char
			lastReloadTime = 0
			lastRefillTime = 0
		end

		local now = os.clock()
		local state = getgenv().KiraHub.State
		local weaponType = KiraWeaponInfo()

		-- Thunder spear stuck detection: sometimes the server leaves the client
		-- holding ammo it refuses to fire (stuck at "1/12"). When the count has
		-- not moved while spears are in use, rebuild the spear marks and force
		-- a real station refill instead of retrying the same dead slot.
		local spearCount = KiraSpearsLeft()
		if spearCount ~= nil then
			if state.LastSpearSeen ~= spearCount then
				state.LastSpearSeen = spearCount
				state.LastSpearChangeAt = now
			end
			local spearsActive = weaponType == "Spears" or KiraHasSpearLoadout()
			local attacking = (AutoFarm and AutoFarm._running) or IsToggled("ManualAutoAttackToggle")
			if spearsActive and attacking and spearCount > 0
				and (now - (state.LastSpearChangeAt or now)) > 6
				and (now - lastReloadTime) > 6
			then
				lastReloadTime = now
				state.LastSpearChangeAt = now
				table.clear(kiraUsedSpearIds)
				state.ForceSpearReset = true
				KiraRefreshSpearMarks()
				pcall(function() RefillCore:ForceType("Spears") end)
			end
		end

		KiraRefreshSpearMarks()
		state.BladesEmpty = KiraBladesEmpty()
		state.SpearsLeft = KiraSpearsLeft()
		state.RefillsLeft = KiraRefillsLeft()
		state.Weapon = KiraWeaponInfo() or state.Weapon

		-- Explicit request from the attack block (spears ran dry mid-fight).
		local request = state.RefillRequest
		if request then
			state.RefillRequest = nil
			local okRefill = pcall(function() RefillCore:Try(request) end)
			if not okRefill then
				-- Never let a refill error wedge the farm in "paused" state.
				RefillCore.Refilling = false
				state.Refilling = false
			end
		end

		if weaponType == "Blades" then
			-- Only reload once the equipped set is completely used up (every
			-- blade on the rig is Broken). The old per-broken-blade swap fired
			-- a Reload after every kill and burned spare sets for nothing.
			if KiraBladesEmpty() == true then
				local spare = KiraBladeSpare()
				if spare and spare > 0 then
					-- Give the game's own swap a moment first: it costs no set.
					if KiraBladesEmptyFor() >= 1.2 and (now - lastReloadTime) > 2.5 then
						lastReloadTime = now
						pcall(function() getRemote:InvokeServer("Blades", "Reload") end)
						state.BladeSettleUntil = now + 0.7
					end
				elseif (now - lastRefillTime) > 1.2 then
					lastRefillTime = now
					pcall(function() RefillCore:Try("Blades") end)
				end
			end

		elseif weaponType == "Spears" then
			local count = KiraSpearsLeft()
			if count ~= nil and count <= 0 and (now - lastRefillTime) > 1.2 then
				lastRefillTime = now
				pcall(function() RefillCore:Try("Spears") end)
			end
		end

		pcall(function()
			local label = getgenv().KiraHub.UI.Labels.Refill
			if label then
				label:SetText(("Refill: %s | Refills %s"):format(
					tostring(RefillCore.Status),
					tostring(state.RefillsLeft or "?")
				))
			end
		end)
	end
end)

-- ============================================================================
--  [KIRA] NO KILL LAG
--  The stutter after a kill is the titan ragdoll: on death the humanoid breaks
--  every joint and the client suddenly simulates a pile of loose parts. With
--  the toggle on, titan humanoids never break their joints on death and the
--  corpse is stripped of collision / mass, so the kill resolves without the
--  physics spike. Client-side only: the server still sees a normal kill.
-- ============================================================================
task.spawn(function()
	local seen = setmetatable({}, { __mode = "k" })

	local function stripCorpse(model)
		pcall(function()
			for _, d in ipairs(model:GetDescendants()) do
				if d:IsA("BasePart") then
					d.CanCollide = false
					d.CanTouch = false
					d.Massless = true
				elseif d:IsA("ParticleEmitter") then
					d.Enabled = false
				end
			end
		end)
	end

	local function disarm(model)
		local hum = model:FindFirstChildOfClass("Humanoid")
		if not hum then return end
		pcall(function() hum.BreakJointsOnDeath = false end)
		if seen[model] then return end
		seen[model] = true
		pcall(function()
			hum.Died:Connect(function()
				if not IsToggled("NoKillLagToggle") then return end
				task.defer(function()
					if model.Parent then stripCorpse(model) end
				end)
			end)
		end)
	end

	local hookedFolder, conn = nil, nil
	while task.wait(0.5) do
		if not getgenv().KiraHubAOTR then break end
		if not IsToggled("NoKillLagToggle") then continue end
		if isLobby or isMenu then continue end
		local tf = workspace:FindFirstChild("Titans")
		if tf ~= hookedFolder then
			if conn then pcall(function() conn:Disconnect() end) end
			hookedFolder = tf
			conn = nil
			if tf then
				local ok, c = pcall(function()
					return tf.ChildAdded:Connect(function(m)
						if m:IsA("Model") and IsToggled("NoKillLagToggle") then disarm(m) end
					end)
				end)
				conn = ok and c or nil
			end
		end
		for _, m in ipairs(tf and tf:GetChildren() or {}) do
			if m:IsA("Model") then disarm(m) end
		end
	end
	if conn then pcall(function() conn:Disconnect() end) end
end)

