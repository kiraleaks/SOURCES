-- ============================================================
-- Auto Select Slot (exact Kira character selection)
-- Presses the SELECT button under the chosen SLOT label.
-- ============================================================
function KiraSlotText(obj)
	local text = tostring(obj.Text or "")
	text = text:gsub("<[^>]->", "")
	return (text:gsub("^%s+", ""):gsub("%s+$", "")):upper()
end

function KiraSlotIsLabel(obj)
	return obj:IsA("TextLabel") or obj:IsA("TextButton")
end

function KiraSlotVisible(obj)
	local ref = obj
	while ref and ref ~= pGui do
		if ref:IsA("GuiObject") and not ref.Visible then return false end
		if ref:IsA("ScreenGui") and not ref.Enabled then return false end
		ref = ref.Parent
	end
	return obj:IsA("GuiObject") and obj.AbsoluteSize.X > 0 and obj.AbsoluteSize.Y > 0
end

function KiraSlotButton(obj)
	if obj:IsA("GuiButton") then return obj end
	local parent = obj.Parent
	for _ = 1, 3 do
		if not parent then break end
		if parent:IsA("GuiButton") then return parent end
		parent = parent.Parent
	end
	parent = obj.Parent
	if parent then return parent:FindFirstChildWhichIsA("GuiButton", true) end
	return nil
end

function KiraSlotFindSelect(holder)
	for _, item in ipairs(holder:GetDescendants()) do
		if KiraSlotIsLabel(item) and KiraSlotText(item) == "SELECT" and KiraSlotVisible(item) then
			local button = KiraSlotButton(item)
			if button then return button end
		end
	end
	return nil
end

function KiraSlotFind(letter)
	local wanted = "SLOT " .. letter
	for _, item in ipairs(pGui:GetDescendants()) do
		if KiraSlotIsLabel(item) and KiraSlotText(item) == wanted and KiraSlotVisible(item) then
			local parent = item.Parent
			for _ = 1, 6 do
				if not parent or parent == pGui then break end
				local button = KiraSlotFindSelect(parent)
				if button then return button end
				parent = parent.Parent
			end
		end
	end
	return nil
end

function KiraSlotScreenVisible()
	for _, item in ipairs(pGui:GetDescendants()) do
		if KiraSlotIsLabel(item) and KiraSlotText(item) == "SLOT A" and KiraSlotVisible(item) then
			return true
		end
	end
	return false
end

function KiraSlotPress(button)
	pcall(function() GuiService.SelectedObject = button end)
	task.wait(0.15)
	pcall(function()
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
		task.wait(0.05)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
	end)
	task.wait(1)
	if button.Parent and KiraSlotVisible(button) then
		pcall(function()
			if type(firesignal) == "function" then
				firesignal(button.MouseButton1Click)
				firesignal(button.Activated)
			end
		end)
	end
	pcall(function()
		if GuiService.SelectedObject == button then GuiService.SelectedObject = nil end
	end)
end

function KiraSlotMouseClick(button)
	pcall(function()
		local point = button.AbsolutePosition + button.AbsoluteSize / 2
		local gui = button:FindFirstAncestorOfClass("ScreenGui")
		if not (gui and gui.IgnoreGuiInset) then
			point = point + GuiService:GetGuiInset()
		end
		VirtualInputManager:SendMouseButtonEvent(point.X, point.Y, 0, true, game, 0)
		task.wait(0.05)
		VirtualInputManager:SendMouseButtonEvent(point.X, point.Y, 0, false, game, 0)
	end)
end

function KiraSlotKey(button)
	local pos, size = button.AbsolutePosition, button.AbsoluteSize
	return math.floor(pos.X + 0.5) .. "," .. math.floor(pos.Y + 0.5) .. ","
		.. math.floor(size.X + 0.5) .. "," .. math.floor(size.Y + 0.5)
end

function KiraSlotSetStatus(text)
	pcall(function()
		local label = getgenv().KiraHub.UI and getgenv().KiraHub.UI.Labels.AutoSlot
		if label then label:SetText("Slot status: " .. tostring(text)) end
	end)
end

function KiraSlotTrySelect(letter)
	local state = getgenv().KiraHub.State
	state.SlotSelectClicked = false

	-- Wait (briefly) for the SELECT button to stream in before touching it.
	local button = KiraSlotFind(letter)
	local waitUntil = os.clock() + 5
	while not button and os.clock() < waitUntil do
		if not getgenv().KiraHubAOTR then return false end
		KiraSlotSetStatus("Waiting for Slot " .. letter .. " to load...")
		task.wait(0.2)
		button = KiraSlotFind(letter)
	end
	if not button then
		KiraSlotSetStatus("Slot " .. letter .. " UI not found")
		return false
	end

	KiraSlotSetStatus("Waiting for slot screen to load...")
	local key, stable = KiraSlotKey(button), 0
	for _ = 1, 20 do
		task.wait(0.2)
		if not getgenv().KiraHubAOTR then return false end
		if not (button.Parent and KiraSlotVisible(button)) then
			button = KiraSlotFind(letter)
			if not button then return false end
			key, stable = KiraSlotKey(button), 0
		else
			local newKey = KiraSlotKey(button)
			if newKey == key then
				stable = stable + 1
				if stable >= 3 then break end
			else
				key, stable = newKey, 0
			end
		end
	end

	-- Exactly two SELECT attempts: one press, one mouse click. After that the
	-- caller fires the lobby teleport remote no matter what the screen shows.
	for attempt = 1, 2 do
		if not getgenv().KiraHubAOTR then return false end
		button = KiraSlotFind(letter)
		if not button then
			if not KiraSlotScreenVisible() then return true end
			break
		end
		KiraSlotSetStatus(("Selecting Slot %s... (click %d/2)"):format(letter, attempt))
		state.SlotSelectClicked = true
		if attempt == 2 then
			KiraSlotMouseClick(button)
		else
			KiraSlotPress(button)
		end
		for _ = 1, 12 do
			task.wait(0.25)
			if not KiraSlotScreenVisible() then
				return true
			end
		end
	end
	return not KiraSlotScreenVisible()
end

function KiraTeleportLobby(reason)
	local state = getgenv().KiraHub.State
	if state.SlotTeleporting then return end
	state.SlotTeleporting = true
	KiraSlotSetStatus(reason or "Slot selected - teleporting to lobby...")

	pcall(function() getRemote:InvokeServer("Functions", "Teleport", "Lobby", nil) end)
	task.wait(0.5)
	pcall(function() getRemote:InvokeServer("Functions", "Teleport", "Lobby") end)
	task.wait(0.5)
	if game.PlaceId ~= LOBBY_ID then
		pcall(function() TeleportService:Teleport(LOBBY_ID, player) end)
	end

	state.SlotTeleporting = false
	KiraSlotSetStatus("Slot selected")
end

function ExecuteAutoSelectSlot()
	local state = getgenv().KiraHub.State
	if state.SlotTeleporting then return end
	if not IsToggled("AutoSelectSlotToggle") then return end
	if not (isMenu or isLobby) then return end

	-- Only act once the toggle has actually selected a slot. If the select
	-- screen is gone and the place is still the menu, push the lobby teleport
	-- (throttled) so the script never just sits on the character screen.
	if not KiraSlotScreenVisible() then
		if state.SlotSelectDone and game.PlaceId ~= LOBBY_ID
			and (os.clock() - (state.SlotLobbyTryAt or 0)) > 8
		then
			state.SlotLobbyTryAt = os.clock()
			KiraTeleportLobby("Teleporting to lobby...")
		end
		return
	end
	if state.AutoSlotBusy then return end

	local selectedSlot = tostring(GetOption("SelectSlotDropdown", "Slot A") or "Slot A")
	local letter = string.sub(selectedSlot, -1)
	if letter ~= "A" and letter ~= "B" and letter ~= "C" then letter = "A" end

	state.AutoSlotBusy = true
	local ok, result = pcall(KiraSlotTrySelect, letter)
	state.AutoSlotBusy = false
	state.SlotSelectDone = true
	if ok and result then
		-- Let the slot click settle for 1s before asking the server for the
		-- lobby (was 2s - the slot register is already confirmed by now).
		task.wait(1)
		KiraTeleportLobby(("Slot %s selected - teleporting to lobby..."):format(letter))
	elseif ok and state.SlotSelectClicked then
		-- Clicked twice and the screen is still up: force the lobby remote.
		task.wait(1)
		KiraTeleportLobby(("Slot %s not ready - forcing lobby teleport..."):format(letter))
	else
		state.SlotSelectDone = false
		KiraSlotSetStatus("Waiting for slot screen...")
	end
end

