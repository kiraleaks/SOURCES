-- Family data (ported from the community). Tier names come from the game's
-- Families module; a static fallback keeps the dropdown usable everywhere.
do
	local Data = getgenv().KiraHub.Data
	Data.FamilyList = {}
	Data.FamilyTierMap = {}
	Data.FamilyTiers = {"Common", "Rare", "Epic", "Legendary", "Mythic", "Secret"}
	pcall(function()
		local Families = require(ReplicatedStorage.Modules.Storage.Families)
		for tier, group in pairs(Families) do
			if type(group) == "table" then
				for name in pairs(group) do
					table.insert(Data.FamilyList, name)
					Data.FamilyTierMap[name] = tier
				end
			end
		end
		table.sort(Data.FamilyList)
	end)
	if #Data.FamilyList == 0 then
		Data.FamilyList = {
			"Ackerman", "Arlert", "Azumabito", "Blouse", "Boyega", "Bozado",
			"Braun", "Braus", "Finger", "Fritz", "Galliard", "Grice", "Helos",
			"Hume", "Iglehaut", "Inocenio", "Kirstein", "Kruger", "Ksaver",
			"Leonhart", "Munsell", "Pikale", "Ral", "Reeves", "Reiss", "Shiki",
			"Smith", "Springer", "Tybur", "Yeager", "Zoe"
		}
		for tier, names in pairs({
			Legendary = {"Yeager", "Ackerman", "Reiss"},
			Common = {"Reeves", "Blouse", "Inocenio", "Munsell", "Boyega", "Ral", "Bozado", "Pikale", "Hume", "Iglehaut"},
			Epic = {"Galliard", "Zoe", "Leonhart", "Tybur", "Ksaver", "Braun", "Finger", "Arlert"},
			Secret = {"Shiki"},
			Mythic = {"Helos", "Fritz"},
			Rare = {"Braus", "Kruger", "Azumabito", "Smith", "Grice", "Springer", "Kirstein"},
		}) do
			for _, name in ipairs(names) do
				Data.FamilyTierMap[name] = tier
			end
		end
	end
end

