local function _DeleteMap()
	if not getgenv().DeleteMap then return end
	if not workspace:FindFirstChild("Climbable") then return end
	if mapData and mapData.Map and mapData.Map.Type == "Raids" then return end
	task.spawn(function()
		while getgenv().DeleteMap and workspace:FindFirstChild("Climbable") do
			if mapData and mapData.Map and mapData.Map.Type == "Raids" then break end
			for _, v in ipairs(workspace.Climbable:GetChildren()) do
				pcall(function() v:Destroy() end)
			end
			if workspace:FindFirstChild("Unclimbable") then
				for _, v in ipairs(workspace.Unclimbable:GetChildren()) do
					if v.Name ~= "Reloads" and v.Name ~= "Objective" and v.Name ~= "Cutscene" then
						pcall(function() v:Destroy() end)
					end
				end
			end
			task.wait(3)
		end
	end)
end

