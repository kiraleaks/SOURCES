function FormatStatsTable(tbl)
	local str = ""
	for k, v in pairs(tbl) do 
		str = str .. k .. ": " .. tostring(v) .. "\n" 
	end
	return str ~= "" and str or "None"
end

function FormatItemsTable(tbl)
