	local banStatus = getgenv().KiraHub.State.BanStatus or "Unknown"
	local embedColor = 15844367
	if rewardType == "Mythical" or rewardType == "Secret" then
		embedColor = 16711680
	elseif rewardType == "Legendary" then
		embedColor = 15105570
	end

	local rewardFields = {}
	for _, drop in ipairs(drops) do
		table.insert(rewardFields, {
			name = drop.Rarity .. " Drop",
			value = "**" .. drop.Name .. "**" .. (drop.Qty and drop.Qty ~= "1" and " (x" .. drop.Qty .. ")" or ""),
			inline = true
		})
