		task.spawn(function()
			local selected = Options.MarketUsePotionDropdown.Value or {}
			local used = 0
			for boostName, isActive in pairs(selected) do
				if isActive then
					pcall(function() getRemote:InvokeServer("S_Inventory", "Item", boostName) end)
					used = used + 1
					task.wait(0.3)
				end
			end
			if used == 0 then
				Library:Notify({Title = "Potions", Description = "No potions selected", Time = 3})
			else
				Library:Notify({Title = "Potions", Description = "Used " .. used .. " potion(s)", Time = 3})
