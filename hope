		Text = "Your Webhook URL",
		Placeholder = "https://discord.com/api/webhooks/..."
	})
	Options.MasterWebhookUrl:OnChanged(function() MarkDirty() end)

	WH_Main:AddToggle("RewardsShowUsernameToggle", {Text = "Show Username in Embeds", Default = false})
	Toggles.RewardsShowUsernameToggle:OnChanged(function() MarkDirty() end)

	local WH_Events = TabRef:AddRightGroupbox("Event Dispatchers", "bell")

	WH_Events:AddToggle("ToggleRewardWebhook", {Text = "Enable Mission Clear Alerts", Default = false})
	Toggles.ToggleRewardWebhook:OnChanged(function() MarkDirty() end)

	WH_Events:AddToggle("ToggleMythicalFamilyWebhook", {Text = "Enable Mythical Clan Alerts", Default = false})
	Toggles.ToggleMythicalFamilyWebhook:OnChanged(function() MarkDirty() end)

	WH_Events:AddToggle("ToggleSkinHunterWebhook", {Text = "Enable Skin Hunter Alerts", Default = false})
	Toggles.ToggleSkinHunterWebhook:OnChanged(function() MarkDirty() end)

	WH_Events:AddButton({Text = "Dispatch Test Webhook", Func = function()
		local url = GetWebhookURL()
		if url == "" then
			Library:Notify({Title = "Webhook", Description = "Enter a URL first", Time = 3})
			return
		end
		local banStatus = getgenv().KiraHub.State.BanStatus or "Unknown"
		local statusColor = 3066993
		if banStatus == "Banned" or banStatus == "Flagged" then statusColor = 15158332 end
		PostWebhook(url, {
			embeds = {{
				title = "Kira Hub Premium | Test Webhook",
				description = "Secure communication link verified.\n**Premium Edition v3**",
