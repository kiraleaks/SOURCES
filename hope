function HandleWavesBaseUpgrades()
	if not IsToggled("AutoBuyBaseUpgradesToggle") or not IsWavesMode() then return end
	local whitelist = GetOption("BaseUpgradesSelectDropdown", {})
	local state = getgenv().KiraHub.State
	state.BaseUpgradeRetryAt = state.BaseUpgradeRetryAt or {}
	state.BaseUpgradeCursor = state.BaseUpgradeCursor or 1
	local names = getgenv().KiraHub.Data.BaseUpgradeNames or {}
	if #names == 0 then return end
	local now = os.clock()
	for offset = 0, #names - 1 do
		local index = ((state.BaseUpgradeCursor + offset - 1) % #names) + 1
		local upg = names[index]
		if whitelist[upg] and now >= (state.BaseUpgradeRetryAt[upg] or 0) then
			state.BaseUpgradeCursor = (index % #names) + 1
			local ok, result = pcall(function()
				return getRemote:InvokeServer("Waves", "Upgrade", {upg})
			end)
			-- Rotate through upgrades even on failures; a failed purchase is retried
			-- after a cooldown instead of blocking all later upgrades.
			state.BaseUpgradeRetryAt[upg] = os.clock() + (ok and 2.5 or 5)
			if not ok then
				pcall(function()
					Library:Notify({Title = "Wave Upgrade", Description = "Retrying " .. tostring(upg) .. " after a request error.", Time = 3})
				end)
			end
			return
		end
	end
end

