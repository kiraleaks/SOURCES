-- ============================================================
-- Executor compatibility shim (Delta / Fluxus / older mobile builds
-- sometimes expose a partial task library: task.wait can be nil).
-- Never mutates the real task table; only swaps it when unusable.
-- ============================================================
function KiraEnsureTask()
	local real = task
	if type(real) == "table" and type(real.wait) == "function"
		and type(real.spawn) == "function" then
		return true
	end
	local shim = {}
	if type(real) == "table" then
		for k, v in pairs(real) do shim[k] = v end
	end
	if type(shim.wait) ~= "function" then
		shim.wait = function(t) return wait(t or 0) end
	end
	if type(shim.spawn) ~= "function" then
		shim.spawn = function(f, ...) return spawn(f, ...) end
	end
	if type(shim.delay) ~= "function" then
		shim.delay = function(t, f, ...) return delay(t, f, ...) end
	end
	if type(shim.defer) ~= "function" then
		shim.defer = function(f, ...) spawn(f, ...) end
	end
	return pcall(function() task = shim end)
end
