-- button. The retry remotes are reserved for Force Retry and the stuck-result
-- recovery path, never for Auto Retry.
function KiraFindRewardsRetry()
	local rewardsGui = INTERFACE:FindFirstChild("Rewards")
	if not rewardsGui or not rewardsGui.Visible then return nil, nil end
	for _, d in ipairs(rewardsGui:GetDescendants()) do
		if (d:IsA("TextButton") or d:IsA("TextLabel")) and d.Visible then
			local text = string.upper(tostring(d.Text or ""))
			text = text:gsub("<[^>]->", ""):gsub("^%s+", ""):gsub("%s+$", "")
			if text:match("^RETRY") then
				local clickable = d
				for _ = 1, 4 do
					if not clickable or clickable == pGui then break end
					if clickable:IsA("GuiButton") then break end
					clickable = clickable.Parent
				end
				if clickable and not clickable:IsA("GuiButton") then clickable = nil end
				return d, clickable
			end
		end
	end
	return nil, nil
end

