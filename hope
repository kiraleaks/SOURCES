function KiraSpearsLeft()
	-- The physical rig is the truth when it has spear parts: it shows exactly
	-- which slots are still unused. Attributes / HUD are only a fallback for
	-- when the rig has not streamed in. (Reading a stale "0" attribute before
	-- the rig made spear users look empty and skip every attack.)
	local rig = KiraRig()
	if rig then
		local total, unused = 0, 0
		for _, armName in ipairs({"RightLowerArm", "LeftLowerArm"}) do
			local arm = rig:FindFirstChild(armName)
			local spears = arm and arm:FindFirstChild("Spears")
			for _, p in ipairs(spears and spears:GetChildren() or {}) do
				if tonumber(p.Name) then
					total = total + 1
					if not p:GetAttribute("Used") then unused = unused + 1 end
				end
			end
		end
		if total > 0 then return unused end
	end

	local best = nil
	local function consider(v)
		if type(v) == "number" and (best == nil or v > best) then best = v end
	end
	local char = player.Character
	if char then
		for _, attr in ipairs(KiraSpearAttrs) do
			consider(char:GetAttribute(attr))
		end
	end
	consider(GetSpearAmmoCount())
	return best
end

-- Weapon detection order matters. The HUD and the physical rig are the only
-- reliable sources during a fight; the "Spears" character attribute can linger
-- at 0 on a blade loadout, and treating that as "Spears" made the farm loop
-- refuse to swing blades (it kept asking for a spear refill instead).
function KiraWeaponInfo()
	local hud = GetCurrentWeapon()
	if hud == "Blades" or hud == "Spears" then return hud end
	if #KiraBladeParts() > 0 then return "Blades" end
	local sets = GetBladeSetCount()
	if sets ~= nil and sets > 0 then return "Blades" end
	if KiraHasSpearLoadout() then return "Spears" end
	return nil
end

local kiraUsedSpearIds = {}
local kiraLastSpearCount = nil
local kiraLastSpearSide = 8

function KiraSpearIds()
	local live = {}
	local rig = KiraRig()
	if rig then
		for _, armName in ipairs({"RightLowerArm", "LeftLowerArm"}) do
			local arm = rig:FindFirstChild(armName)
			local spears = arm and arm:FindFirstChild("Spears")
			for _, p in ipairs(spears and spears:GetChildren() or {}) do
				local id = tonumber(p.Name)
				if id and id >= 1 and id <= 8 then
					live[id] = not p:GetAttribute("Used")
				end
			end
		end
	end
	return live
end

function KiraResetSpearMarks()
	table.clear(kiraUsedSpearIds)
	kiraLastSpearCount = KiraSpearsLeft()
end

function KiraReconcileSpears()
	local live = KiraSpearIds()
	for id in pairs(kiraUsedSpearIds) do
		-- The spear is gone from the rig: free its mark so a later refill can
		-- reuse that slot id instead of running out of fireable ids.
		if live[id] == nil then
			kiraUsedSpearIds[id] = nil
		end
	end
	local ammo = KiraSpearsLeft() or 0
	local free = 0
	for id, unused in pairs(live) do
		if unused and not kiraUsedSpearIds[id] then free = free + 1 end
	end
	if free == 0 and ammo > 0 then
		-- Marks out of sync with the server: rebuild them from the rig.
		table.clear(kiraUsedSpearIds)
	end
end

function KiraRefreshSpearMarks()
	local n = KiraSpearsLeft()
	if kiraLastSpearCount ~= nil and n ~= nil and n > kiraLastSpearCount then
		table.clear(kiraUsedSpearIds)
	end
	kiraLastSpearCount = n
	KiraReconcileSpears()
	local st = getgenv().KiraHub and getgenv().KiraHub.State
	if st and st.ForceSpearReset then
		st.ForceSpearReset = nil
		table.clear(kiraUsedSpearIds)
	end
end

-- S_Fire takes a SPEAR SLOT ID (1..8), never the ammo count.
function KiraPickSpearId()
	local live = KiraSpearIds()
	local ids = {}
	for id, unused in pairs(live) do
		if unused and not kiraUsedSpearIds[id] then
			ids[#ids + 1] = id
		end
	end
	if #ids == 0 then
		table.clear(kiraUsedSpearIds)
		for id, unused in pairs(live) do
			if unused then ids[#ids + 1] = id end
		end
	end
	if #ids > 0 then
		local id = ids[math.random(1, #ids)]
		kiraUsedSpearIds[id] = true
		kiraLastSpearSide = id
		return id
	end
	kiraLastSpearSide = (kiraLastSpearSide == 8) and 7 or 8
	return kiraLastSpearSide
end

