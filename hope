function KiraCollectRefills(container)
	local list = {}
	if not container then return list end
	for _, d in ipairs(container:GetDescendants()) do
		if d.Name == "Refill" then table.insert(list, d) end
	end
	return list
end

function KiraRefillStations()
	local cache = kiraRefillCache
	local valid = #cache.list > 0
	if valid then
		for _, st in ipairs(cache.list) do
			if not st.Parent then valid = false break end
		end
	end
	if valid and cache.job == game.JobId and (os.clock() - cache.built) < 5 then
		return cache.list
	end

	local list = {}
	local unclimb = workspace:FindFirstChild("Unclimbable")
	local objective = unclimb and unclimb:FindFirstChild("Objective")
	local waves = objective and objective:FindFirstChild("Waves")
	if waves then list = KiraCollectRefills(waves) end

	if #list == 0 then
		local container = workspace
		local path = KIRA_REFILL_PLACES[game.PlaceId]
		if path then
			local cur = workspace
			for _, name in ipairs(path) do cur = cur and cur:FindFirstChild(name) end
			if cur then container = cur end
		end
		list = KiraCollectRefills(container)
		if #list == 0 and container ~= workspace then
			list = KiraCollectRefills(workspace)
		end
	end

	cache.list, cache.built, cache.job = list, os.clock(), game.JobId
	return list
end

function GetRefillStation(root)
	if not root then
		local _, hrp = KiraChar()
		root = hrp
