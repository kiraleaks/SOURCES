-- ============================================================
-- Config export / import (loadstring-style)
-- Only settings that are ON or differ from their default are emitted,
-- so omitted settings mean OFF / default.
-- ============================================================
function KiraConfigValue(v)
	if type(v) == "boolean" then return tostring(v) end
	if type(v) == "number" then return tostring(v) end
	return string.format("%q", tostring(v))
end

function KiraConfigSameList(a, b)
	if type(a) ~= "table" or type(b) ~= "table" then return false end
	local countA, countB = 0, 0
	for _, v in pairs(a) do if v == true then countA = countA + 1 end end
	for _, v in pairs(b) do if v == true then countB = countB + 1 end end
	if countA ~= countB then return false end
	for k, v in pairs(a) do
		if v == true and b[k] ~= true then return false end
	end
	return true
end

function KiraBuildConfigScript()
	local defaults = getgenv().KiraHub.Defaults or {toggles = {}, options = {}}
	local dToggles = defaults.toggles or {}
	local dOptions = defaults.options or {}
	local pending = {}

	if Toggles then
		for name, t in pairs(Toggles) do
			-- Emit every toggle that is ON, plus any toggle that was switched
			-- OFF from a default-ON state (omitted means OFF / default).
			if type(t.Value) == "boolean" and (t.Value or dToggles[name] == true) then
				pending[name] = tostring(t.Value)
			end
		end
	end
	if Options then
		for name, o in pairs(Options) do
			local v = o.Value
			if type(v) == "number" or type(v) == "string" then
				if dOptions[name] ~= v then pending[name] = KiraConfigValue(v) end
			elseif type(v) == "table" then
				local selected = {}
				for k, val in pairs(v) do
					if val == true then selected[#selected + 1] = tostring(k) end
				end
				if #selected > 0 and not KiraConfigSameList(v, dOptions[name]) then
					table.sort(selected)
					local quoted = {}
					for i, k in ipairs(selected) do quoted[i] = string.format("%q", k) end
					pending[name] = "{" .. table.concat(quoted, ", ") .. "}"
				end
			end
		end
	end

	local lines = {"-- Kira Hub Premium config (only ON / changed settings)"}
	local names = {}
	for name in pairs(pending) do names[#names + 1] = name end
	table.sort(names)
	for _, name in ipairs(names) do
		lines[#lines + 1] = name .. " = " .. pending[name]
	end
	lines[#lines + 1] = ""
	lines[#lines + 1] = 'loadstring(game:HttpGet("https://api.jnkie.com/api/v1/luascripts/public/51428b087781147e90ebff75072f665b51841956014e1b9e9601a9fe443393e8/download"))()'
	return table.concat(lines, "\n")
end

function KiraResetToDefaults()
	local defaults = getgenv().KiraHub.Defaults
	if not defaults then return end
	local dToggles = defaults.toggles or {}
	local dOptions = defaults.options or {}
	if Toggles then
		for name, t in pairs(Toggles) do
			if type(dToggles[name]) == "boolean" then
				pcall(function() t:SetValue(dToggles[name]) end)
			end
		end
	end
	if Options then
		for name, o in pairs(Options) do
			local v = dOptions[name]
			if type(v) == "number" or type(v) == "string" then
				pcall(function() o:SetValue(v) end)
			elseif type(v) == "table" then
				local copy = {}
				for k, val in pairs(v) do
					if val == true then copy[k] = true end
				end
				pcall(function() o:SetValue(copy) end)
			end
		end
	end
end

function KiraApplyConfig(text)
	local applied = 0
	KiraResetToDefaults()
	for line in tostring(text or ""):gmatch("[^\r\n;]+") do
		line = line:gsub("%-%-.*$", "")
		line = line:gsub("^%s+", ""):gsub("%s+$", "")
		local name, raw = line:match("^([%w_]+)%s*=%s*(.+)$")
		if name and raw then
			raw = raw:gsub("^%s+", ""):gsub("%s+$", "")
			local value, isTable = nil, false
			if raw == "true" then
				value = true
			elseif raw == "false" then
				value = false
			elseif raw:match("^%-?%d+%.?%d*$") then
				value = tonumber(raw)
			elseif raw:match("^[\"'].*[\"']$") then
				value = raw:sub(2, -2)
			elseif raw:match("^{.*}$") then
				isTable = true
				value = {}
				for item in raw:sub(2, -2):gmatch("[^,]+") do
					item = item:gsub("^%s+", ""):gsub("%s+$", "")
					item = item:gsub("^[\"']", ""):gsub("[\"']$", "")
					if item ~= "" then value[item] = true end
				end
			end
			if value ~= nil then
				if isTable then
					if Options[name] then
						pcall(function() Options[name]:SetValue(value) end)
						applied = applied + 1
					end
				elseif Toggles[name] and type(value) == "boolean" then
					pcall(function() Toggles[name]:SetValue(value) end)
					applied = applied + 1
				elseif Options[name] then
					pcall(function() Options[name]:SetValue(value) end)
					applied = applied + 1
				end
			end
		end
	end
	MarkDirty()
	-- A config can never change the font: re-assert Jura after applying.
	pcall(function()
		if Library and Library.SetFont then Library:SetFont(Enum.Font.Jura) end
	end)
	return applied
end

function BuildSettingsTab(TabRef)
	local Set_Sys = Tabs.Settings:AddLeftGroupbox("System", "settings")
	Set_Sys:AddLabel("Menu toggle"):AddKeyPicker("MenuKeybind", {Default = "RightControl", NoUI = true, Text = "Menu keybind"})
	Library.ToggleKeybind = Options.MenuKeybind
	Set_Sys:AddLabel("Emergency Stop"):AddKeyPicker("EmergencyStopKeybind", {
		Default  = "Backspace",
		NoUI     = false,
		Mode     = "Toggle",
		Text     = "Emergency Stop",
		Callback = function(v) getgenv().KiraHub.State.EmergencyStop = v end,
	})

	local function SaveKeybinds()
		pcall(function()
			local menuKey = Options.MenuKeybind and tostring(Options.MenuKeybind.Value or "RightControl") or "RightControl"
			local stopKey = Options.EmergencyStopKeybind and tostring(Options.EmergencyStopKeybind.Value or "Backspace") or "Backspace"
			local stopMode = Options.EmergencyStopKeybind and tostring(Options.EmergencyStopKeybind.Mode or "Toggle") or "Toggle"
			writefile(CFG_KEYBINDS, menuKey .. "\n" .. stopKey .. "\n" .. stopMode)
		end)
	end

	local function LoadKeybinds()
		local ok, raw = pcall(function()
			if isfile and isfile(CFG_KEYBINDS) then return readfile(CFG_KEYBINDS) end
			return nil
		end)
		if not ok or not raw then return end
		local lines = {}
		for line in tostring(raw):gmatch("[^\r\n]+") do table.insert(lines, line) end
		if lines[1] and lines[1] ~= "" then
			pcall(function() Options.MenuKeybind:SetValue(lines[1]) end)
		end
		if lines[2] and lines[2] ~= "" then
			pcall(function() Options.EmergencyStopKeybind:SetValue(lines[2]) end)
		end
		if lines[3] and lines[3] ~= "" then
			pcall(function() Options.EmergencyStopKeybind.Mode = lines[3] end)
		end
		pcall(function() Library.ToggleKeybind = Options.MenuKeybind end)
	end

	getgenv().KiraHub.LoadKeybinds = LoadKeybinds
	Options.MenuKeybind:OnChanged(function() SaveKeybinds() end)
	Options.EmergencyStopKeybind:OnChanged(function() SaveKeybinds() end)
	LoadKeybinds()

	-- Snapshot the defaults before autoload config runs so the exporter can
	-- skip every setting that is still at its default value.
	do
		local D = {toggles = {}, options = {}}
		if Toggles then
			for name, t in pairs(Toggles) do
				if type(t.Value) == "boolean" then D.toggles[name] = t.Value end
			end
		end
		if Options then
			for name, o in pairs(Options) do
				local v = o.Value
				if type(v) == "number" or type(v) == "string" then
					D.options[name] = v
				elseif type(v) == "table" then
					local copy, any = {}, false
					for k, val in pairs(v) do
						if val == true then copy[k] = true; any = true end
					end
					if any then D.options[name] = copy end
				end
			end
		end
		getgenv().KiraHub.Defaults = D
	end

	local Set_Cfg = TabRef:AddRightGroupbox("Config Export / Import", "share")
	Set_Cfg:AddLabel("Only ON / changed settings are exported.", true)
	Set_Cfg:AddLabel("Omitted settings mean OFF / default.", true)
	getgenv().KiraHub.UI.Labels.ConfigStatus = Set_Cfg:AddLabel("Config: ready")

	Set_Cfg:AddButton({
		Text = "Export Config to Clipboard",
		Func = function()
			local script = KiraBuildConfigScript()
			pcall(function() writefile(CFG_EXPORT_CONFIG, script) end)
			pcall(function() setclipboard(script) end)
			pcall(function()
				local label = getgenv().KiraHub.UI.Labels.ConfigStatus
				if label then label:SetText("Config: exported " .. tostring(#script) .. " chars") end
			end)
			Library:Notify({Title = "Config Export", Description = "Loadstring config copied to clipboard", Time = 4})
		end
	})

	Set_Cfg:AddButton({
		Text = "Export Config File",
		Func = function()
			local script = KiraBuildConfigScript()
			local ok = pcall(function() writefile(CFG_EXPORT_CONFIG, script) end)
			pcall(function()
				local label = getgenv().KiraHub.UI.Labels.ConfigStatus
				if label then
					label:SetText(ok and ("Config: saved to export_config.lua") or "Config: file write failed")
				end
			end)
			if ok then
				Library:Notify({Title = "Config Export", Description = "Saved to export_config.lua", Time = 4})
			end
		end
	})

	Set_Cfg:AddInput("ConfigImportInput", {
		Default = "",
		Text = "Paste config (Name = value; ...)",
		Placeholder = "AutoFarmToggle = true; StartDelaySlider = 25"
	})
	Options.ConfigImportInput:OnChanged(function() MarkDirty() end)

	Set_Cfg:AddButton({
		Text = "Apply Imported Config",
		Func = function()
			local text = GetOption("ConfigImportInput", "")
			if type(text) ~= "string" or text == "" then
				Library:Notify({Title = "Config Import", Description = "Paste a config first", Time = 3})
				return
			end
			local applied = KiraApplyConfig(text)
			pcall(function()
				local label = getgenv().KiraHub.UI.Labels.ConfigStatus
				if label then label:SetText("Config: applied " .. tostring(applied) .. " settings") end
			end)
			Library:Notify({Title = "Config Import", Description = "Applied " .. tostring(applied) .. " settings", Time = 4})
		end
	})

	Set_Cfg:AddButton({
		Text = "Load export_config.lua",
		Func = function()
			if not (isfile and isfile(CFG_EXPORT_CONFIG)) then
				Library:Notify({Title = "Config Import", Description = "No export_config.lua found", Time = 3})
				return
			end
			local applied = KiraApplyConfig(readfile(CFG_EXPORT_CONFIG))
			pcall(function()
				local label = getgenv().KiraHub.UI.Labels.ConfigStatus
				if label then label:SetText("Config: applied " .. tostring(applied) .. " settings") end
			end)
			Library:Notify({Title = "Config Import", Description = "Applied " .. tostring(applied) .. " settings", Time = 4})
		end
	})
end

-- Auto Prestige worker (ported from Kira). Scoped to avoid top-level locals.
do
	prestigeBoostText = { Luck = "luckboost", Gold = "goldboost", EXP = "expboost" }
	prestigeClickers = {
		function(obj)
			if type(firesignal) ~= "function" then return false end
			return pcall(firesignal, obj.Activated)
		end,
		function(obj)
			if type(firesignal) ~= "function" then return false end
			return pcall(firesignal, obj.MouseButton1Click)
		end,
		function(obj)
			return UseButton(obj)
		end,
		function(obj)
			return pcall(function()
				local inset = GuiService:GetGuiInset()
				local pos = obj.AbsolutePosition + obj.AbsoluteSize / 2 + inset
				VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 0)
				task.wait(0.05)
				VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0)
			end)
		end,
	}

	function PrestigeNormalize(text)
		return tostring(text or ""):gsub("<[^>]->", ""):lower():gsub("[^%w]", "")
	end

	function PrestigeStatus(text)
		local labels = getgenv().KiraHub.UI and getgenv().KiraHub.UI.Labels
		local label = labels and labels.AutoPrestigeStatus
		if label then
			pcall(function() label:SetText("Prestige Status: " .. tostring(text)) end)
		end
	end

	function PrestigeVisible(obj)
		local ref = obj
		while ref and ref ~= pGui do
			if ref:IsA("GuiObject") and not ref.Visible then return false end
			if ref:IsA("ScreenGui") and not ref.Enabled then return false end
			ref = ref.Parent
		end
		return true
	end

	function PrestigePath(...)
		local ref = pGui
		for _, name in ipairs({...}) do
			ref = ref and ref:FindFirstChild(name)
		end
		return ref
	end

	function PrestigeHasText(obj, needle)
		needle = PrestigeNormalize(needle)
		if obj:IsA("TextButton") and PrestigeNormalize(obj.Text) == needle then return true end
		for _, item in ipairs(obj:GetDescendants()) do
			if (item:IsA("TextLabel") or item:IsA("TextButton"))
				and PrestigeNormalize(item.Text) == needle
			then
				return true
			end
		end
		return false
	end

	function PrestigeAncestorHasText(obj, needle)
		needle = PrestigeNormalize(needle)
		local parent = obj and obj.Parent
		for _ = 1, 5 do
			if not parent or parent == pGui then break end
			for _, item in ipairs(parent:GetDescendants()) do
				if item:IsA("TextLabel") and PrestigeVisible(item)
					and PrestigeNormalize(item.Text):find(needle, 1, true)
				then
					return true
				end
			end
			parent = parent.Parent
		end
		return false
	end

	function PrestigeFindButton(target, filter)
		local wanted = PrestigeNormalize(target)
		for _, item in ipairs(pGui:GetDescendants()) do
			if item:IsA("GuiButton") and PrestigeVisible(item)
				and PrestigeHasText(item, wanted)
				and (not filter or filter(item))
			then
				return item
			end
		end
		return nil
	end

	function PrestigeFindLabel(target)
		local wanted = PrestigeNormalize(target)
		for _, item in ipairs(pGui:GetDescendants()) do
			if item:IsA("TextLabel") and PrestigeVisible(item)
				and PrestigeNormalize(item.Text) == wanted
			then
				return item
			end
		end
		return nil
	end

	function PrestigeFindYes()
		return PrestigeFindButton("YES", function(btn)
			return PrestigeAncestorHasText(btn, "areyousureyouwanttoprestige")
		end)
	end

	function PrestigeLevel()
		return tonumber(player:GetAttribute("Prestige")) or 0
	end

	function PrestigeLevelFull()
		local label = PrestigePath("Interface", "Equipment", "Prestige", "Progress", "Level")
		if not (label and label:IsA("TextLabel")) then
			return false, "Prestige page not found"
		end
		local text = label.Text or ""
		if PrestigeNormalize(text):find("maxlvl", 1, true) then return true end
		local a, b = text:match("(%d+)%s*/%s*(%d+)")
		a = tonumber(player:GetAttribute("Level")) or tonumber(a)
		b = tonumber(b)
		if a and b and a >= b then return true end
		return false, ("Level not full ( %s / %s )"):format(tostring(a), tostring(b))
	end

	function PrestigeClick(obj, methodIndex)
		if not obj or not obj.Parent or not PrestigeVisible(obj) then return false end
		local method = prestigeClickers[methodIndex or 1]
		if not method then return false end
		return (pcall(method, obj))
	end

	function PrestigeWait(getter, done, seconds)
		local deadline = os.clock() + (seconds or 10)
		local methodIndex = 1
		while os.clock() < deadline and IsToggled("AutoPrestigeToggle") do
			if done() then return true end
			local obj = getter()
			if obj then
				PrestigeClick(obj, methodIndex)
				local settle = os.clock() + 1.5
				while os.clock() < settle do
					if done() then return true end
					task.wait(0.1)
				end
				methodIndex = methodIndex % #prestigeClickers + 1
			else
				task.wait(0.4)
			end
		end
		return done()
	end

	function PrestigeCardButton(label)
		local boostTexts = {"luckboost", "goldboost", "expboost"}
		local parents = {}
		local ref = label
		for _ = 1, 7 do
			if not ref or ref == pGui then break end
			table.insert(parents, ref)
			ref = ref.Parent
		end
		for _, parent in ipairs(parents) do
			if parent:IsA("GuiButton") and PrestigeVisible(parent) then return parent end
		end
		for _, parent in ipairs(parents) do
			local containsOther = false
			for _, item in ipairs(parent:GetDescendants()) do
				if item:IsA("TextLabel") and item ~= label then
					local normalized = PrestigeNormalize(item.Text)
					for _, boostText in ipairs(boostTexts) do
						if normalized == boostText then containsOther = true break end
					end
				end
				if containsOther then break end
			end
			if not containsOther then
				for _, item in ipairs(parent:GetDescendants()) do
					if item:IsA("GuiButton") and PrestigeVisible(item) then return item end
				end
			end
		end
		return nil
	end

	function PrestigeFindFinish()
		return PrestigeFindButton("FINISH")
	end

	function PrestigeFindNext()
		return PrestigeFindButton("NEXT")
	end

	function RunPrestige(phase)
		local st = getgenv().KiraHub.State
		st.PrestigeBusy = true
		local ok, failAt = pcall(function()
			local boostIndex = math.clamp(PrestigeLevel() + 1, 1, 5)
			if phase <= 1 then
				PrestigeStatus("Opening the Prestige page...")
				local function findEntry()
					local equipment = PrestigePath("Interface", "Equipment")
					if equipment and PrestigeVisible(equipment) then
						return PrestigePath("Interface", "Equipment", "Categories", "Prestige", "Main", "Interact")
					end
					return PrestigePath("Interface", "Topbar", "Main", "Categories", "Equipment", "Interact")
				end
				local function findPrestigeButton()
					local btn = PrestigePath("Interface", "Equipment", "Prestige", "B_Prestige")
					if btn and PrestigeVisible(btn) then return btn end
					return nil
				end
				if not PrestigeWait(findEntry, function()
					return findPrestigeButton() ~= nil
				end, 12) then
					return "the Prestige page"
				end
				PrestigeStatus("Clicking PRESTIGE...")
				if not PrestigeWait(findPrestigeButton, function()
					return PrestigeFindYes() ~= nil
				end, 10) then
					return "the PRESTIGE button"
				end
			end
			if phase <= 3 then
				PrestigeStatus("Confirming with YES...")
				if not PrestigeWait(PrestigeFindYes, function()
					return PrestigeFindLabel("luckboost") ~= nil
				end, 10) then
					return "the YES button"
				end
			end
			if phase <= 4 then
				local boostName = GetOption("PrestigeBoost" .. boostIndex, "Luck")
				local boostText = prestigeBoostText[boostName] or "luckboost"
				PrestigeStatus(("Choosing %s boost (prestige #%d)..."):format(tostring(boostName), boostIndex))
				local label = PrestigeFindLabel(boostText)
				if label then
					for attempt = 1, 3 do
						local card = PrestigeCardButton(label)
						if card then PrestigeClick(card, attempt) end
						local nextBtn = nil
						local waitUntil = os.clock() + 1.5
						while os.clock() < waitUntil do
							task.wait(0.3)
							nextBtn = PrestigeFindNext()
							if nextBtn then break end
						end
						if nextBtn then break end
					end
				else
					PrestigeStatus("Boost card not found: " .. tostring(boostName))
				end
				PrestigeStatus("Clicking NEXT...")
				if not PrestigeWait(PrestigeFindNext, function()
					return PrestigeFindFinish() ~= nil
				end, 10) then
					return "the NEXT button"
				end
			end
			task.wait(0.8)
			-- Memory card step: keeping the current pick is safe and the FINISH
			-- button accepts it, so no card is force-selected here.
			PrestigeStatus("Clicking FINISH...")
			if not PrestigeWait(PrestigeFindFinish, function()
				return PrestigeFindFinish() == nil
			end, 12) then
				return "the FINISH button"
			end
			return nil
		end)
		st.PrestigeBusy = false
		if not ok then
			PrestigeStatus("Error: " .. tostring(failAt))
			return false
		end
		if failAt then
			PrestigeStatus("Failed at: " .. tostring(failAt) .. " (retrying in 30s)")
			return false
		end
		PrestigeStatus(("Prestige done (now Prestige %d)"):format(PrestigeLevel()))
		return true
	end

	task.spawn(function()
		local tick = 0
		local retryAt = 0
		while getgenv().KiraHubAOTR do
			task.wait(1)
			tick = tick + 1
			local st = getgenv().KiraHub.State
			if not IsToggled("AutoPrestigeToggle") then
				st.PrestigeBusy = false
				if tick % 5 == 0 then PrestigeStatus("Off") end
				continue
			end
			if game.PlaceId ~= LOBBY_ID then
				st.PrestigeBusy = false
				if tick % 5 == 0 then PrestigeStatus("Lobby place only") end
				continue
			end
			if st.PrestigeBusy or os.clock() < retryAt then continue end
			local current = PrestigeLevel()
			local stopAt = tonumber(GetOption("PrestigeStopAt", 3)) or 3
			if current >= stopAt then
				if tick % 5 == 0 then
					PrestigeStatus(("Stopped: Prestige %d reached the target %d"):format(current, stopAt))
				end
				continue
			end
			local full, reason = PrestigeLevelFull()
			if not full then
				if tick % 5 == 0 then PrestigeStatus(reason or "Waiting for max level") end
				continue
			end
			local phase
			if PrestigeFindFinish() then
				phase = 5
			elseif PrestigeFindLabel("luckboost") then
				phase = 4
			elseif PrestigeFindYes() then
				phase = 3
			else
				phase = 1
			end
			local done = RunPrestige(phase)
			retryAt = os.clock() + (done and 10 or 30)
		end
	end)
end

