	crashCheckActive = enabled
	if not enabled then return end
	task.spawn(function()
		while crashCheckActive do
			task.wait(10)
			if not IsToggled("AutoRejoinToggle") then continue end
			if isLobby or isMenu then continue end
			if not IsToggled("AutoKillToggle") then continue end
