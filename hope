	if not root then return nil end
	local best, bestDist = nil, math.huge
	for _, station in ipairs(KiraRefillStations()) do
		local pos = KiraPos(station)
		if pos then
			local d = (pos - root.Position).Magnitude
			if d < bestDist then best, bestDist = station, d end
		end
