function ExecuteFamilySpin()
	local state = getgenv().KiraHub.State
	if state.FamilySpinning then return end
	if not IsToggled("AutoFamilySpin") then return end

	state.FamilySpinning = true
	task.spawn(function()
		local Data = getgenv().KiraHub.Data
		local statusLabel = getgenv().KiraHub.UI.Labels.FamilyStatus
		local familyLabel = getgenv().KiraHub.UI.Labels.Family
		local function setStatus(text)
			pcall(function()
				if statusLabel then statusLabel:SetText("Status: " .. tostring(text)) end
			end)
		end

		while getgenv().KiraHubAOTR and IsToggled("AutoFamilySpin") do
			local famUI = GetFamilyUI()
			if not famUI then
				setStatus("Open Customisation > Family")
				task.wait(1.5)
			else
				local lucky = false
				pcall(function()
					local pity = famUI:FindFirstChild("Pity")
					lucky = pity ~= nil and pity:IsA("TextLabel")
						and string.upper(tostring(pity.Text or "")):find("LEGENDARY", 1, true) ~= nil
				end)
				local mode = lucky and "Lucky" or "Normal"
				setStatus("Rolling (" .. mode .. ")...")

				local ok, result, result1, result2, result3, result4 = pcall(function()
					return getRemote:InvokeServer("Family", "Roll", mode)
				end)

				local spinsTable, gotFamily, pityTable, luckVal
				local totalSpins, pityVal = 0, nil
				if ok then
					if type(result) == "table" and type(result1) == "string" then
						spinsTable = result
						gotFamily = result1
						pityTable = type(result2) == "table" and result2 or nil
						luckVal = result4
						local entry = spinsTable[mode] or spinsTable.Normal
						if type(entry) == "table" then
							totalSpins = (tonumber(entry.Amount) or 0) + (tonumber(entry.Free) or 0)
						end
						if pityTable then
							pityVal = pityTable[mode] or pityTable.Normal
						end
					elseif type(result2) == "string" then
						gotFamily = result2
						totalSpins = (tonumber(result) or 0) + (tonumber(result1) or 0)
						pityVal = tonumber(result3)
					end
				end

				if type(gotFamily) == "string" and gotFamily ~= "" then
					local tier = Data.FamilyTierMap[gotFamily] or "Common"

					pcall(function()
						local title = famUI:FindFirstChild("Family")
						title = title and title:FindFirstChild("Title")
						if title and title:IsA("TextLabel") then
							title.Text = string.upper(tostring(gotFamily)) .. " (" .. tier .. ")"
							title.Visible = true
						end
					end)
					pcall(function()
						local buttons = famUI:FindFirstChild("Buttons") or famUI:FindFirstChild("Buttons_2")
						local rollBtn = buttons and buttons:FindFirstChild("Roll")
						local rollTitle = rollBtn and rollBtn:FindFirstChild("Title")
						if rollTitle and rollTitle:IsA("TextLabel") then
							rollTitle.Text = "ROLL (" .. tostring(totalSpins) .. ")"
						end
					end)
					pcall(function()
						local pity = famUI:FindFirstChild("Pity")
						if pity and pity:IsA("TextLabel") and pityVal ~= nil then
							if mode == "Lucky" then
								pity.Text = "LEGENDARY+ PITY: " .. tostring(pityVal) .. "/100"
							else
								pity.Text = "EPIC+ PITY: " .. tostring(pityVal) .. "/400"
							end
						end
					end)
					pcall(function()
						if familyLabel then
							familyLabel:SetText("Family: " .. gotFamily .. " (" .. tier .. ")")
						end
					end)

					local stopFamilies = GetOption("FamiliesToStop", {})
					local stopTiers = GetOption("FamilyTiersToStop", {})
					local shouldStop = FamilyListMatches(stopFamilies, gotFamily)
						or FamilyListMatches(stopTiers, tier)

					if shouldStop then
						KiraFamilyNotify(gotFamily, tier)
						Library:Notify({
							Title = "👑 Family Roller",
							Description = "Target rolled: " .. gotFamily .. " (" .. tier .. ")",
							Time = 6
						})
						SendFamilyWebhook(gotFamily, tier)
						StopFamilySpin("Found " .. gotFamily .. " (" .. tier .. ")")
						break
					end

					if totalSpins <= 0 then
						setStatus("No spins left")
						Library:Notify({Title = "👑 Family Roller", Description = "Out of family spins", Time = 5})
						StopFamilySpin("Out of spins")
						break
					end
				end

				if ok then
					task.wait(0.1)
				else
					setStatus("Roll failed, retrying...")
					task.wait(0.5)
				end
			end
		end
		state.FamilySpinning = false
	end)
end

