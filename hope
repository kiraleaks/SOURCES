		for _, v in ipairs(Lighting:GetChildren()) do
			if v:IsA("Atmosphere") or v:IsA("FogEffect") then v:Destroy() end
		end
		Lighting.FogEnd = 100000
	end)
end

local function applyPerformanceStrip()
	pcall(function()
		settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
		Lighting.GlobalShadows = false
		Lighting.FogEnd = 9e8
		for _, v in ipairs(Lighting:GetChildren()) do
			if v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("ColorCorrectionEffect")
				or v:IsA("BloomEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("Atmosphere")
			then
				pcall(function() v.Enabled = false end)
			end
		end
	end)
end

local titanHL = {}

local function UpdateNapeExtend()
	if not workspace:FindFirstChild("Titans") then return end
	for _, t in ipairs(workspace.Titans:GetChildren()) do
		if t:IsA("Model") and not bossNames[t.Name] then
			pcall(function()
				local hit  = t:FindFirstChild("Hitboxes") and t.Hitboxes:FindFirstChild("Hit")
				local nape = hit and hit:FindFirstChild("Nape")
				if nape then
					if getgenv().NapeExtend then
						nape.Size         = Vector3.new(50, 50, 50) * (getgenv().ExtendMulti or 1.3)
						nape.Transparency = getgenv().NapeVisible and 0.65 or 1
						nape.Color        = Color3.new(1, 1, 1)
						nape.Material     = Enum.Material.Neon
					else
						nape.Size         = Vector3.new(15, 9, 11)
						nape.Transparency = 1
					end
				end
			end)
		end
	end
end

local function UpdateESP()
	if not workspace:FindFirstChild("Titans") then return end
	local col = getgenv().ESPColor or Color3.fromRGB(200, 200, 200)
	if getgenv().TitanESP then
		for _, t in ipairs(workspace.Titans:GetChildren()) do
			if t:IsA("Model") then
				pcall(function()
					local h = t:FindFirstChildOfClass("Humanoid")
					if h and h.Health > 0 then
						if not titanHL[t] then
							local hl               = Instance.new("Highlight")
							hl.Adornee             = t
							hl.FillTransparency    = 0.88
							hl.OutlineColor        = bossNames[t.Name] and Color3.fromRGB(255, 55, 55) or col
							hl.OutlineTransparency = 0.25
							hl.Parent              = t
							titanHL[t]             = hl
						elseif not bossNames[t.Name] then
							titanHL[t].OutlineColor = col
						end
					elseif titanHL[t] then
						titanHL[t]:Destroy()
						titanHL[t] = nil
					end
				end)
			end
		end
	else
		for _, hl in pairs(titanHL) do pcall(function() hl:Destroy() end) end
		titanHL = {}
	end
end

