local function checkIsBossTarget(targetPart)
	local result = false
	pcall(function()
		local part = targetPart
		for depth = 1, 5 do
			if not part or not part.Parent then break end
			if bossNames[part.Name] then result = true break end
			if bossNames[part.Parent.Name] then result = true break end
			part = part.Parent
		end
	end)
	return result
end

local crashCheckRunning = false

local function startCrashDetection()
	if crashCheckRunning then return end
	crashCheckRunning = true
	task.spawn(function()
		while crashCheckRunning do
			task.wait(10)
			if not getgenv().AutoRejoin then continue end
			if isLobby then continue end
			if not getgenv().AutoFarm then continue end
			if not workspace:FindFirstChild("Titans") and not workspace:FindFirstChild("Unclimbable") then
				task.wait(10)
				if not workspace:FindFirstChild("Titans") and not workspace:FindFirstChild("Unclimbable") then
					SessionStats.Crashes = SessionStats.Crashes + 1
					saveSession()
					pcall(function() getgenv().AutoFarmClass:Stop() end)
					task.wait(0.5)
					pcall(function() getRemote:InvokeServer("Functions", "Teleport", "Lobby") end)
					task.wait(0.5)
					pcall(function() TeleportService:Teleport(LOBBY_ID, player) end)
				end
			end
		end
	end)
end

local function stopCrashDetection()
	crashCheckRunning = false
end

