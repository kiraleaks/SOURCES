	while os.clock() - s < 2 do
		for _, m in ipairs(ReplicatedStorage.Missions:GetChildren()) do
			if m:FindFirstChild("Leader") and m.Leader.Value == player.Name then return m end
		end
		task.wait(0.1)
	end
	return nil
end

local function tpToPart(part, offset)
	if not part then return false end
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then return false end
	offset = offset or Vector3.new(0, 3, 0)
	if part:IsA("BasePart") then
		root.CFrame = part.CFrame * CFrame.new(offset)
	elseif part:IsA("Model") then
		local primary = part.PrimaryPart or part:FindFirstChildWhichIsA("BasePart")
		if primary then root.CFrame = primary.CFrame * CFrame.new(offset) end
	end
	root.AssemblyLinearVelocity = V3_ZERO
	return true
end

