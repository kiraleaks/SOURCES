						label.BackgroundTransparency = 1
						label.Font = Enum.Font.Jura
						label.TextSize = 14
						label.TextColor3 = Color3.fromRGB(255, 255, 255)
						label.TextStrokeTransparency = 0.3
						label.Name = "Info"
						label.Parent = bb
						bb.Parent = head
						titanEspLabels[t] = bb
					end

					local dist = math.floor((hrp.Position - head.Position).Magnitude)
					local state = t:GetAttribute("State") or t:GetAttribute("Type") or "Standard"
					local name = t.Name:gsub("_", " ")
					titanEspLabels[t].Info.Text = name .. " | " .. tostring(dist) .. "m | " .. tostring(state)
				end)
