-- ============================================================
-- Auto Claim (ported from Kira)
-- ============================================================
KiraClaim = {
	cooldowns = setmetatable({}, {__mode = "k"}),
	stats = {Main = 0, Side = 0, Weekly = 0, Daily = 0, Ach = 0},
	lastDaily = -math.huge,
	lastQuestOpen = -math.huge,
	lastAchOpen = -math.huge,
	lastLog = 0,
}
KIRA_CLAIM_COOLDOWN = 300

function KiraClaimFindInterface()
	return pGui:FindFirstChild("Interface")
end

function KiraClaimVisible(obj)
	if not obj then return false end
	if not obj:IsA("GuiObject") then return false end
	local ref = obj
	while ref and ref ~= pGui do
		if ref:IsA("GuiObject") and not ref.Visible then return false end
		if ref:IsA("ScreenGui") and not ref.Enabled then return false end
		ref = ref.Parent
	end
	return obj.AbsoluteSize.X > 0 and obj.AbsoluteSize.Y > 0
end

function KiraClaimNormalize(obj)
	local text = tostring(obj.Text or "")
	text = text:gsub("<[^>]->", "")
	text = text:gsub("^%s+", ""):gsub("%s+$", "")
	return text:upper()
end

function KiraFindPath(root, ...)
	local ref = root
	for _, name in ipairs({...}) do
		ref = ref and ref:FindFirstChild(name)
		if not ref then return nil end
	end
	return ref
end

function KiraClaimPress(obj)
	if not obj or not obj.Parent then return false end
	pcall(function() GuiService.SelectedObject = obj end)
	task.wait(0.15)
	pcall(function()
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
		task.wait(0.05)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
	end)
	task.wait(0.4)
	pcall(function()
		if type(firesignal) == "function" then
			firesignal(obj.MouseButton1Click)
			firesignal(obj.Activated)
		end
	end)
	task.wait(0.25)
	pcall(function()
		local sg = obj:FindFirstAncestorOfClass("ScreenGui")
		local inset = (sg and sg.IgnoreGuiInset) and Vector2.zero or GuiService:GetGuiInset()
		local pt = obj.AbsolutePosition + obj.AbsoluteSize / 2 + inset
		VirtualInputManager:SendMouseButtonEvent(pt.X, pt.Y, 0, true, game, 0)
		task.wait(0.05)
		VirtualInputManager:SendMouseButtonEvent(pt.X, pt.Y, 0, false, game, 0)
	end)
	task.wait(0.2)
	pcall(function()
		if GuiService.SelectedObject == obj then GuiService.SelectedObject = nil end
	end)
	return true
end

function KiraClaimOnCooldown(obj)
	local last = KiraClaim.cooldowns[obj]
	return last ~= nil and (os.clock() - last) < KIRA_CLAIM_COOLDOWN
end

function KiraClaimQuests()
	local claimed = 0
	local interfaceRef = KiraClaimFindInterface()
	local quests = interfaceRef and interfaceRef:FindFirstChild("Quests")
	if not quests then return 0 end
	local catKey = {
		Main = "AutoClaimMain",
		Side = "AutoClaimSide",
		Weekly = "AutoClaimWeekly",
		Daily = "AutoClaimDaily",
	}
	for _, item in ipairs(quests:GetDescendants()) do
		if item.Name == "Button" and item:IsA("GuiObject") then
			local parent = item.Parent
			if parent and parent.Name == "Claim" and KiraClaimVisible(parent) then
				local tag = item:GetAttribute("Tag")
				local category = item:GetAttribute("Category")
				if tag ~= nil and category ~= nil then
					local key = catKey[tostring(category)]
					if key and IsToggled(key) and not KiraClaimOnCooldown(item) then
						KiraClaim.cooldowns[item] = os.clock()
						local ok, result = pcall(function()
							return getRemote:InvokeServer("Functions", "Quest", tostring(tag), tostring(category))
						end)
						if ok and result ~= nil then
							KiraClaim.stats[tostring(category)] = (KiraClaim.stats[tostring(category)] or 0) + 1
							claimed = claimed + 1
						end
						task.wait(0.3)
					end
				end
			end
		end
	end
	return claimed
end

function KiraClaimAchievements()
	if not IsToggled("AutoClaimAchievements") then return 0 end
	local interfaceRef = KiraClaimFindInterface()
	local achievements = interfaceRef and interfaceRef:FindFirstChild("Achievements")
	local list = achievements and achievements:FindFirstChild("List")
	list = list and list:FindFirstChild("Inner")
	if not list then return 0 end
	local claimed = 0
	for _, item in ipairs(list:GetChildren()) do
		local id = tonumber(item.Name)
		if id and id ~= 99 and not KiraClaimOnCooldown(item) then
			local ok, shouldClaim = pcall(function()
				local inner = item:FindFirstChild("Inner")
				local aState = inner and inner:FindFirstChild("A_State")
				local title = aState and aState:FindFirstChild("Title")
				return aState ~= nil and aState.Visible and title ~= nil and tostring(title.Text) == "CLAIM"
			end)
			if ok and shouldClaim then
				KiraClaim.cooldowns[item] = os.clock()
				local ok2, result = pcall(function()
					return getRemote:InvokeServer("S_Achievements", "Claim", id)
				end)
				if ok2 and result ~= nil then
					KiraClaim.stats.Ach = KiraClaim.stats.Ach + 1
					claimed = claimed + 1
				end
				task.wait(0.3)
			end
		end
	end
	return claimed
end

function KiraClaimDailyDirect()
	if not IsToggled("AutoClaimDaily") then return 0 end
	if os.clock() - KiraClaim.lastDaily < KIRA_CLAIM_COOLDOWN then return 0 end
	KiraClaim.lastDaily = os.clock()
	local claimed = 0
	for i = 1, 3 do
		if not (getgenv().KiraHubAOTR and IsToggled("AutoClaimDaily")) then break end
		local ok, result = pcall(function()
			return getRemote:InvokeServer("Functions", "Quest", "Daily " .. i, "Daily")
		end)
		if ok and result ~= nil then
			KiraClaim.stats.Daily = KiraClaim.stats.Daily + 1
			claimed = claimed + 1
		end
		task.wait(0.5)
	end
	return claimed
end

function KiraClaimUpdateStatus()
