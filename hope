		{name = "Difficulty", value = missionInfo.Difficulty, inline = true},
		{name = "Mission Type", value = missionInfo.Type, inline = true},
		{name = "Time to Complete", value = FormatMissionTime(missionElapsedSecs), inline = true},
		{name = "Script Version", value = SCRIPT_VERSION, inline = true}
	}

	for _, f in ipairs(rewardFields) do
		table.insert(baseFields, f)
	end

	local mentionText = "Legendary+ drop!"
	if rewardType == "Mythical" or rewardType == "Secret" then
		mentionText = "MYTHICAL DROP DETECTED!"
	end

	PostWebhook(WH_PERSONAL_MYTHICAL, {
		content = mentionText,
		embeds = {{
			title = "Kira Hub Premium | " .. rewardType .. " Reward Alert",
			description = "**" .. player.Name .. "** received a **" .. rewardType .. "** class reward.",
			color = embedColor,
			fields = baseFields,
			footer = {text = "Kira Hub Premium | Rare Drop Tracker"},
			timestamp = DateTime.now():ToIsoDate()
		}}
	})
end

