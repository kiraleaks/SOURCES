	MKT_Spins:AddButton({Text = "Buy Spins Now", Func = function()
		task.spawn(function()
			local packMap = {["5"] = 1, ["25"] = 2, ["100"] = 3, ["250"] = 4, ["500"] = 5}
			local size = Options.SpinPackDropdown.Value or "5"
