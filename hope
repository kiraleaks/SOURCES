function KiraLooksLikeClose(obj)
	local lowered = string.lower(tostring(obj.Name))
	if lowered:find("close", 1, true) or lowered:find("exit", 1, true)
		or lowered:find("cancel", 1, true) or lowered == "x"
	then
		return true
	end
	if obj:IsA("TextLabel") or obj:IsA("TextButton") then
		local text = KiraClaimNormalize(obj)
		if text == "X" or text == "×" then return true end
	end
	return false
end

function KiraDailyRewardTitle()
	for _, item in ipairs(pGui:GetDescendants()) do
		if (item:IsA("TextLabel") or item:IsA("TextButton")) and KiraClaimVisible(item) then
			if KiraClaimNormalize(item):find("^DAILY REWARDS") then
				return item
			end
		end
	end
	return nil
end

function KiraFindDailyClose(title)
	local parent = title.Parent
	for _ = 1, 8 do
		if not parent or parent == pGui then break end
		for _, item in ipairs(parent:GetDescendants()) do
			if item:IsA("GuiButton") and KiraClaimVisible(item) and KiraLooksLikeClose(item) then
				return item
			end
			if item:IsA("GuiObject") and not item:IsA("GuiButton")
				and string.lower(item.Name):find("close", 1, true) and KiraClaimVisible(item)
			then
				local button = item:FindFirstChildWhichIsA("GuiButton", true)
				if button and KiraClaimVisible(button) then return button end
			end
		end
		parent = parent.Parent
	end
	local root = title
	while root.Parent and root.Parent ~= pGui and not root.Parent:IsA("ScreenGui") do
		root = root.Parent
	end
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)
	local best, bestX = nil, -1
	for _, item in ipairs(root:GetDescendants()) do
		if item:IsA("GuiButton") and KiraClaimVisible(item) then
			local pos, size = item.AbsolutePosition, item.AbsoluteSize
			if size.X <= 130 and size.Y <= 130
				and pos.Y < viewport.Y * 0.25
				and pos.X > viewport.X * 0.5
				and pos.X > bestX
			then
				best, bestX = item, pos.X
			end
		end
	end
	return best
end

function KiraHasNewBadge(container)
