			if badge and badge:IsA("GuiObject") and badge.Visible
				and os.clock() - KiraClaim.lastAchOpen >= 60
			then
				local button = KiraFindPath(INTERFACE, "Topbar", "Main", "Icons", "Achievements")
				if button and button:IsA("GuiButton") and KiraClaimVisible(button) then
					KiraClaim.lastAchOpen = os.clock()
					KiraClaimPress(button)
					task.wait(1)
