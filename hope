function ForceRetry(force)
	-- Force Retry is the remote path: it deliberately never clicks the Rewards
	-- GUI. (Auto Retry is the opposite - GUI click only, no remotes.)
	local state = getgenv().KiraHub and getgenv().KiraHub.State
	local now = os.clock()
	if state and not force then
		if now - (state.LastForceRetryAt or 0) < 2.5 then return false end
		state.LastForceRetryAt = now
	end
	for attempt = 1, 2 do
		pcall(function() getRemote:InvokeServer("Functions", "Retry", "Add") end)
		task.wait(0.15)
		pcall(function() postRemote:FireServer("Functions", "Retry") end)
		task.wait(0.15)
		if attempt == 1 and (INTERFACE:FindFirstChild("Rewards") == nil) then
			break
		end
	end
	return true
end
getgenv().KiraHub.ForceRetry = ForceRetry

