local RefillCore = {
	Status = "Idle",
	LastAttempt = -999,
	LongRangeFails = 0,
	LongRangeBlockedUntil = 0,
	Refilling = false,
	Attempts = 0,
	Success = 0,
}

getgenv().KiraHub.State.Refilling = false
getgenv().KiraHub.State.RefillStatus = "Idle"

function KiraRefillsLeft()
	local v = player:GetAttribute("Refills")
	if type(v) == "number" then return v end
	return nil
end

function KiraNeedsRefill(forceKind)
	local kind = forceKind or KiraWeaponInfo()
	if kind == "Spears" then
		local n = KiraSpearsLeft()
		return n ~= nil and n <= 0
	end
	if kind == "Blades" then
		if KiraBladesEmpty() ~= true then return false end
		local spare = KiraBladeSpare()
		if spare == nil then
			-- Kira: when spare sets are not visible yet, wait for evidence
			-- (blades empty for a while) before walking to a station.
			return KiraBladesEmptyFor() >= 5
		end
		return spare == 0
	end
	return false
end

function RefillCore:SetStatus(text)
	self.Status = text
	getgenv().KiraHub.State.RefillStatus = text
end

function RefillCore:Try(forceKind, forceNow)
	local now = os.clock()
	if self.Refilling then return false end
	if now - self.LastAttempt < 1 then return false end
	if not forceNow and not KiraNeedsRefill(forceKind) then return true end

	local kind = forceKind or KiraWeaponInfo()
	if not kind then
		self:SetStatus("Unknown weapon")
		return false
	end

	self.LastAttempt = now
	self.Attempts = self.Attempts + 1

	local refillsBefore = KiraRefillsLeft()
	local function Done()
		if not forceNow and not KiraNeedsRefill(forceKind) then return true end
		local after = KiraRefillsLeft()
		if refillsBefore ~= nil and after ~= nil and after < refillsBefore then return true end
		if forceNow and kind == "Spears" then
			-- A forced spear refill is done once the rig shows an unused spear.
			for _, unused in pairs(KiraSpearIds()) do
				if unused then return true end
			end
		end
		return false
	end
	local function WaitDone(sec)
		local t0 = os.clock()
		while os.clock() - t0 < sec do
			if Done() then return true end
			task.wait(0.2)
		end
		return Done()
	end

	local mode = GetOption("RefillModeDropdown", "Smart")
	if mode ~= "Station Only" and mode ~= "Remote Only" then mode = "Smart" end
	local allowRemote = (mode ~= "Station Only")
	local allowStation = (mode ~= "Remote Only")
	local longRangeAllowed = allowRemote
		and IsToggled("RefillFarToggle")
		and os.clock() >= self.LongRangeBlockedUntil

	local post = postRemote
	if not (post and post.Parent) then
		pcall(function()
			local assets = ReplicatedStorage:FindFirstChild("Assets")
			local remotes = assets and assets:FindFirstChild("Remotes")
			if remotes then post = remotes:WaitForChild("POST", 5) end
		end)
	end

	for attempt = 1, 2 do
		local char, root = KiraChar()
		if not (char and root) then break end

		local station = GetRefillStation(root)
		if not station then
			self:SetStatus("No refill station")
			-- Still try a remote without a station reference as a last resort.
			if longRangeAllowed and post and post.Parent then
				pcall(function() post:FireServer("Attacks", "Reload") end)
			end
			break
		end

		if longRangeAllowed then
			self:SetStatus(("Refilling %s (remote %d/2)"):format(kind, attempt))
			KiraNet:Fire(post, "Attacks", "Reload", station)

			if WaitDone(2.5) then
				self.LongRangeFails = 0
				self.Success = self.Success + 1
				self:SetStatus("Refilled (remote)")
				if kind == "Spears" then KiraResetSpearMarks() end
				return true
			end

			self.LongRangeFails = self.LongRangeFails + 1
			if self.LongRangeFails >= 2 then
				self.LongRangeFails = 0
				self.LongRangeBlockedUntil = os.clock() + 120
				self:SetStatus("Long-range refused, using station")
			end
		end

		if not allowStation then break end

		-- step 2: physically go to the station, press the prompt, re-fire.
		local prompt = KiraPromptOf(station)
		local targetPos = KiraPromptPos(prompt, station) or KiraPos(station)
		local backCFrame = root.CFrame

		self.Refilling = true
		getgenv().KiraHub.State.Refilling = true
		self:SetStatus(("Refilling %s (station %d/2)"):format(kind, attempt))

		if targetPos then
			pcall(function() player:RequestStreamAroundAsync(targetPos) end)
			KiraTweenRoot(root, targetPos + Vector3.new(0, 3, 0), 800)
			task.wait(0.3)
			prompt = KiraPromptOf(station) or prompt
		end

		if prompt then
			KiraPressPrompt(prompt)
		else
			KiraPressR(prompt)
		end
		task.wait(0.4)
		if post and post.Parent then
			KiraNet:Fire(post, "Attacks", "Reload", station)
		end

		local done = WaitDone(3)
		if done then
			-- Give the server a moment before flying back so the "Refills"
			-- attribute has time to replicate.
			task.wait(0.6)
			done = Done()
		end

		local _, returnRoot = KiraChar()
		if returnRoot then
			pcall(function() player:RequestStreamAroundAsync(backCFrame.Position) end)
			KiraTweenRoot(returnRoot, backCFrame.Position, 600)
		end

		self.Refilling = false
		getgenv().KiraHub.State.Refilling = false

		if done then
			self.Success = self.Success + 1
			self:SetStatus("Refilled (station)")
			if kind == "Spears" then KiraResetSpearMarks() end
			return true
		end

		self:SetStatus(("Refill failed (station %d/2)"):format(attempt))
	end

	self.Refilling = false
	getgenv().KiraHub.State.Refilling = false
	return false
end

