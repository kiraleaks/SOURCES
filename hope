-- ============================================================
-- Boosted map detection (ported from Kira)
-- Reads workspace attributes first, then scans the attributes of workspace,
-- ReplicatedStorage and the local player for anything containing "boost".
-- Timers at or below 3 seconds are treated as expired.
-- ============================================================
KiraBoostedMaps = {"Shiganshina","Trost","Outskirts","Forest","Utgard","Docks","Stohess","Chapel"}

function KiraGetBoostedMap()
	local mapName = workspace:GetAttribute("Boosted_Map")
	local timer = workspace:GetAttribute("Boosted_Timer")
	if type(mapName) ~= "string" or not table.find(KiraBoostedMaps, mapName) then
		mapName, timer = nil, nil
		for _, root in ipairs({workspace, ReplicatedStorage, player}) do
			local ok, attrs = pcall(function() return root:GetAttributes() end)
			if ok and type(attrs) == "table" then
				local foundMap, foundTimer = nil, nil
				for key, value in pairs(attrs) do
					local lowered = string.lower(tostring(key))
					if lowered:find("boost", 1, true) then
						if type(value) == "string" and table.find(KiraBoostedMaps, value) then
							foundMap = value
						elseif type(value) == "number"
							and (lowered:find("time", 1, true) or lowered:find("left", 1, true))
						then
							foundTimer = value
						end
					end
				end
				if foundMap then
					mapName, timer = foundMap, foundTimer
					break
				end
			end
		end
	end
	if not mapName then return nil end
	if type(timer) == "number" and timer <= 3 then return nil end
	return mapName, (type(timer) == "number") and timer or nil
end

