	local rig = KiraRig()
	if rig then
		for _, armName in ipairs({"RightLowerArm", "LeftLowerArm"}) do
			local arm = rig:FindFirstChild(armName)
			local spears = arm and arm:FindFirstChild("Spears")
			if spears and #spears:GetChildren() > 0 then return true end
		end
	end
	local char = player.Character
	if char then
		for _, attr in ipairs(KiraSpearAttrs) do
			local v = char:GetAttribute(attr)
			if type(v) == "number" and v > 0 then return true end
		end
