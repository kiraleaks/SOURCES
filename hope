				return
			end
			local amount = Options.MarketSpinAmountSlider.Value or 1
			pcall(function() getRemote:InvokeServer("S_Market", "Buy", "Spins", pack, amount) end)
			Library:Notify({Title = "Market", Description = "Bought " .. amount .. "x " .. size .. " Spins", Time = 3})
