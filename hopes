		LastHitAt = 0,
		BossBusyUntil = 0,
		ProtectAt = 0,
		ProtectPos = nil,
		TitanNext = 0,
		TitanWarned = {},
		SkillRetry = {},
		QAt = 0,
		RejoinAt = 0,
		FamilyBusy = false,
		ArtBusy = false,
		CollideAt = 0,
		SpearExtra = 0,
		SpearFixAt = 0,
		WarnedNoRefill = false,
