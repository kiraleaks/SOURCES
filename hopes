function ExecuteAutoEnhancePerks()
	if not IsToggled("AutoEnhanceToggle") then return end
	if not isLobby then return end
	
	local profile = GetPlayerData()
	local slot = player:GetAttribute("Slot")
	if not slot or not profile or not profile.Slots or not profile.Slots[slot] then return end
	
	local slotData = profile.Slots[slot]
	local storage = slotData.Perks and slotData.Perks.Storage or {}
	local perkSlot = GetOption("PerkSlotDropdown", "Body")
	local equippedId = slotData.Perks and slotData.Perks.Equipped and slotData.Perks.Equipped[perkSlot]
	
	if not equippedId then return end
	
	local perkData = storage[equippedId]
	if not perkData then return end
	
	local perkName = perkData.Name
	local currentLevel = perkData.Level or 0
	
	if currentLevel >= 10 then
		Library:Notify({Title = "Enhance", Description = perkName .. " is max level!", Time = 3})
		return
	end
	
	local selectedRarities = GetOption("SelectPerksDropdown", {})
	local foodDict = {}
	local count = 0
	
	for id, tbl in pairs(storage) do
		if count >= 5 then break end
		local r = getgenv().KiraHub.Data.PerkRarityMap[tbl.Name or ""]
		if id ~= equippedId and r and selectedRarities[r] then
			foodDict[id] = 1
			count = count + 1
		end
	end
	
	if count == 0 then return end
	
	local ok, result = pcall(function()
		return getRemote:InvokeServer("S_Equipment", "Enhance", equippedId, foodDict)
	end)
	
	if ok and result then
		Library:Notify({Title = "Enhance", Description = "Enhanced " .. perkName, Time = 2})
	end
end

