t1.OPTREV = {}

do
	t1.TROPT = function(p1)
		local v15 = t1.TR(p1)

		if v15 ~= p1 then
			if type(v15) == "string" then
				t1.OPTREV[v15] = p1
			end
		end

		return v15
	end
end

t1.UNTR = function(p2)
	if t1.Lang == "en" and type(p2) == "string" then
		return t1.OPTREV[p2] or p2
	end

	return p2
end

do
	t1.TR = function(p3)
		if t1.Lang ~= "en" or type(p3) ~= "string" or p3 == "" then
			return p3
		end

		local v16 = t1.EN[p3]

		if v16 then
			return v16
		end

		if p3:find("\n", 1, true) then
			local t3 = {}

			for match in (p3 .. "\n"):gmatch("(.-)\n") do
				t3[#t3 + 1] = t1.TR(match)
			end

			return table.concat(t3, "\n")
		end

		for _, v in ipairs(t1.ENPART) do
			local n1 = 1

			while true do
				local pos, v23 = p3:find(v[1], n1, true)

				if not pos then
					break
				end

				p3 = p3:sub(1, pos - 1) .. v[2] .. p3:sub(v23 + 1)
				n1 = pos + #v[2]
			end
		end

		return p3
	end
end

