	function M.HasFamilyBag()
		local ok, has = pcall(function()
			local gp = player:FindFirstChild("Gamepasses")
			local bag = gp and gp:FindFirstChild("Family_Bag")
			if bag and bag.Value == true then return true end
			local data = M.Profile()
			local list = type(data) == "table" and data.Gamepasses or {}
			return table.find(list, "Family_Bag") ~= nil or table.find(list, "Ymir_Blessing") ~= nil
		end)
		return ok and has == true
	end

	function M.FamilySlotData(data)
		if type(data) ~= "table" then return nil end
		local slots = data.Slots
		if type(slots) ~= "table" then return nil end
		local slot = data.Current_Slot or player:GetAttribute("Slot")
		return slots[slot] or slots[tostring(slot)] or slots[1]
	end

	-- V3's ExecuteFamilySpin owns the family auto roll and is kept exactly as
	-- the working script has it. The engine only maintains the bag around it:
	-- equip the best family and store the equipped one when it is rare enough.
	function M.FamilyTick()
		if not M.EngineOn() then return end
		if not isLobby then return end
		if S.FamilyBusy then return end
		local storeOn = M.Toggle("FamilyStoreToggle", false)
		local equipBest = M.Toggle("FamilyEquipBestToggle", false)
		if not (storeOn or equipBest) then return end
		local data = M.Profile()
		local sl = M.FamilySlotData(data)
		if type(sl) ~= "table" then return end
		S.FamilyBusy = true
		task.spawn(function()
			pcall(function()
				local avatar = sl.Avatar or {}
				local inventory = sl.Inventory or {}
				local families = inventory.Families or {}
				local stopNames = M.Option("FamiliesToStop", {}) or {}
				local storeMin = M.TierRank(M.Option("FamilyStoreMinDropdown", "Legendary"))
				local bagCap = 1 + (tonumber(sl.Extra_Slots and sl.Extra_Slots.Family) or 0)
				if M.HasFamilyBag() then bagCap = bagCap + 10 end

				local function pickEquip(cur, list)
					local best, bestScore = nil, -1
					local function consider(v)
						if type(v) ~= "string" then return end
						local sc = M.Rank(v) * 1000 - (M.FAMILY_POS[v] or 999)
						if sc > bestScore then best, bestScore = v, sc end
					end
					consider(cur)
					for _, v in ipairs(list) do consider(v) end
					return best
				end
				local statusLabel = getgenv().KiraHub.UI and getgenv().KiraHub.UI.Labels
					and getgenv().KiraHub.UI.Labels.FamilyStatus
				local function setStatus(text)
					pcall(function()
						if statusLabel then statusLabel:SetText("Status: " .. tostring(text)) end
					end)
				end

				local function swap(name)
					if not name or name == avatar.Family then return false end
					local ok, a, b, c = pcall(function() return getRemote:InvokeServer("Family", "Swap", name) end)
					if not (ok and a == true) then return false end
					-- The bag list is the truth: the equipped family leaves it and
					-- the swapped-out family enters it.
					for i = #families, 1, -1 do
						if families[i] == name then table.remove(families, i) break end
					end
					if type(b) == "string" then table.insert(families, b) end
					avatar.Family = type(c) == "string" and c or name
					-- Junk that came back from the swap is deleted so the bag does
					-- not fill with low-rarity families (reference rule).
					if type(b) == "string" and M.Rank(b) > 0 and M.Rank(b) < storeMin
						and not stopNames[b]
					then
						local okDel, del = pcall(function()
							return getRemote:InvokeServer("Family", "Delete", b)
						end)
						if okDel and del == true then
							for i = #families, 1, -1 do
								if families[i] == b then table.remove(families, i) break end
							end
						end
					end
					return true
				end

				-- One maintenance pass. Rolling is V3's ExecuteFamilySpin.
				local cur = avatar.Family
				local best = equipBest and pickEquip(cur, families) or nil
				if best and best ~= cur then
					swap(best)
					cur = avatar.Family
				end
				if storeOn and cur and M.Rank(cur) >= storeMin then
					if #families >= bagCap then
						setStatus("Bag full - free a family slot")
					else
						local ok, a, b, c = pcall(function()
							return getRemote:InvokeServer("Family", "Store")
						end)
						if ok and a == true and type(b) == "string" then
							table.insert(families, b)
							if type(c) == "string" then avatar.Family = c end
						end
					end
				end
			end)
			S.FamilyBusy = false
		end)
	end

	-- ------------------------------------------------------------------
	--  Artifact roll
	-- ------------------------------------------------------------------
	local ART_SLOTCAT = {Hat = "Head", Face = "Head", Neck = "Body", Back = "Body"}

	local function requireModule(path)
		local ok, mod = pcall(function()
			local node = ReplicatedStorage
			for _, part in ipairs(path) do
				node = node and node:FindFirstChild(part)
			end
			if not node then return nil end
			return require(node)
		end)
		if ok and type(mod) == "table" then return mod end
		return nil
	end
	M.Require = requireModule

	local function parseRange(text)
		text = tostring(text or ""):gsub(",", ".")
		local a, b = string.match(text, "^%s*([%d%.]+)%s*%-%s*([%d%.]+)%s*$")
		if a then return tonumber(a), tonumber(b) end
		return tonumber(text), nil
	end

	function M.ArtifactRoll()
		if not M.EngineOn() then return end
		if not isLobby then return end
		if S.ArtBusy then return end
		if not M.Toggle("ArtifactRollToggle", false) then return end
		local name = tostring(M.Option("ArtifactNameInput", "") or "")
		if name == "" then return end
		S.ArtBusy = true
		task.spawn(function()
			local ok, err = pcall(function()
				local data = M.Profile()
				local sl = M.FamilySlotData(data)
				local arts = sl and sl.Artifacts
				if type(arts) ~= "table" or type(arts.Storage) ~= "table" then return end

				local values = requireModule({"Modules", "Storage", "Values"})
				local items = requireModule({"Modules", "Storage", "Items"})
				local artsDb = requireModule({"Modules", "Storage", "Artifacts"})
				if not values or not items or not artsDb then
					note("Artifact modules unavailable")
					return
				end
				local rarity = items[name] and items[name].Rarity
				local cat = artsDb[name] and ART_SLOTCAT[artsDb[name].Slot]
				local base = rarity and values.Roll_Costs and tonumber(values.Roll_Costs[rarity])
				if not (rarity and cat and base) then
					note("Unknown artifact: " .. name)
					return
				end

				local idx = {}
				for i, r in pairs(values.Rollable or {}) do idx[r.Stat] = tonumber(i) end
				local targets = {}
				for n = 1, 2 do
					local stat = tostring(M.Option("ArtStat" .. n .. "Dropdown", "None")):gsub(" ", "_")
					local raw = M.Option("ArtVal" .. n .. "Input", "")
					local lo, hi = parseRange(raw)
					local i = idx[stat]
					if i and lo then
						local rg = values.Rollable[i].Ranges[rarity]
						if rg and not (lo > rg[2] or (hi and hi < rg[1])) then
							targets[#targets + 1] = {i = i, min = lo * 10 - 0.01, max = (hi or rg[2]) * 10 + 0.01}
						end
					end
				end
				if #targets == 0 then
					note("Set an artifact stat target first")
					return
				end

				-- Lock bookkeeping: the locks this script sets are
				-- remembered by stat signature, so locks the player set in-game
				-- are never touched. The game's reroll with a lock can delete the
				-- unlocked second stat, so locking is only done when the other
				-- stat is present and rerollable.
				local OURS = {}
				local function lockedAt(it, i)
					return type(it.Locked) == "table" and it.Locked[i] == true
				end
				local function statKey(it, i)
					local s = it and it.Stats and it.Stats[i]
					if not s then return nil end
					return tostring(s.Index) .. ":" .. string.format("%.2f", tonumber(s.Value) or 0)
				end
				local function ours(k, it, i)
					local m, sk = OURS[tostring(k)], statKey(it, i)
					return type(m) == "table" and sk ~= nil and m[sk] == true
				end
				local function userLocked(k, it, i)
					return lockedAt(it, i) and not ours(k, it, i)
				end
				-- Greedy target matching: locked stats are matched first, then the
				-- free ones. viable = the missing targets fit in the unlocked
				-- slots, so a reroll can still reach the goal.
				local function check(it, k)
					local used, hits = {}, 0
					for _, t in ipairs(targets) do
						for pass = 1, 2 do
							local found = false
							for i = 1, 2 do
								local s = it.Stats and it.Stats[i]
								if s and not used[i] and (lockedAt(it, i) == (pass == 1))
									and tonumber(s.Index) == t.i and s.Value >= t.min and s.Value <= t.max then
									used[i] = true
									hits = hits + 1
									found = true
									break
								end
							end
							if found then break end
						end
					end
					local free, userLock = 0, userLocked(k, it, 1) or userLocked(k, it, 2)
					for i = 1, 2 do
						if not userLocked(k, it, i) and not used[i] and it.Stats and it.Stats[i] then
							free = free + 1
						end
					end
					return used, hits == #targets, hits, (not userLock) or (#targets - hits) <= free
				end
				local function slotNow()
					return M.FamilySlotData(M.Profile())
				end
				local function setLock(k, i, want)
					local s = slotNow()
					local it = s and s.Artifacts and s.Artifacts.Storage[k]
					if not it or lockedAt(it, i) == want then return end
					local sk = statKey(it, i)
					local okL, nd = pcall(function()
						return getRemote:InvokeServer("S_Equipment", "Artifact_Lock", k, i)
					end)
					if not okL or nd == nil then return end
					profileCache = type(nd) == "table" and nd or nil
					profileAt = os.clock()
					OURS[tostring(k)] = OURS[tostring(k)] or {}
					if sk then OURS[tostring(k)][sk] = want or nil end
				end

				local eq = arts.Equipped and arts.Equipped[cat] and arts.Equipped[cat].ID
				local id, best, owned = nil, -1, 0
				for k, it in pairs(arts.Storage) do
					if type(it) == "table" and it.Name == name then
						owned = owned + 1
						local _, all, h, viable = check(it, k)
						if all or viable then
							local sc = (all and 100 or 0) + h * 4
								+ (tostring(k) ~= tostring(eq) and 2 or 0)
								+ ((type(it.Stats) ~= "table" or #it.Stats == 0) and 1 or 0)
							if all and tostring(k) == tostring(eq) then sc = sc + 3 end
							if sc > best then id, best = k, sc end
						end
					end
				end
				if owned == 0 then
					note("No " .. name .. " in storage")
					return
				end
				if not id then
					note("Artifact blocked by your own locks: " .. name)
					return
				end

				local reserve = M.Num("ArtifactReserveSlider", 5000, 0, 100000000)
				local same, done = 0, false
				for _ = 1, 300 do
					local s = slotNow()
					arts = s and s.Artifacts or arts
					local cur = arts.Storage[id]
					if type(cur) ~= "table" then break end
					local used, all = check(cur, id)
					if all then done = true break end
					-- Lock whichever stat already meets its target and reroll the
					-- other; only when both stats exist (a lock otherwise deletes
					-- the second one and wastes gold).
					for i = 1, 2 do
						if not userLocked(id, cur, i) then
							local j = 3 - i
							local want = used[i] == true and not used[j]
								and cur.Stats and cur.Stats[i] ~= nil and cur.Stats[j] ~= nil
								and not userLocked(id, cur, j)
							setLock(id, i, want and true or false)
							s = slotNow()
							arts = s and s.Artifacts or arts
							cur = arts.Storage[id]
							if type(cur) ~= "table" then break end
						end
					end
					if type(cur) ~= "table" then break end
					local _, _, _, still = check(cur, id)
					if not still or (lockedAt(cur, 1) and lockedAt(cur, 2)) then
						note("Artifact stuck on locks: " .. name)
						break
					end
					local cost = base
					if lockedAt(cur, 1) or lockedAt(cur, 2) then
						cost = math.floor(base * 1.5)
					end
					local gold = tonumber(s and s.Currency and s.Currency.Gold) or 0
					if gold < cost + reserve then
						note("Not enough gold for " .. name)
						break
					end
					local function sig(x)
						local p = {}
						for i = 1, 2 do
							local s = x.Stats and x.Stats[i]
							p[#p + 1] = s and (tostring(s.Index) .. ":" .. tostring(s.Value)) or "-"
						end
						return table.concat(p, "|")
					end
					local before = sig(cur)
					local okRoll, nd = pcall(function()
						return getRemote:InvokeServer("S_Equipment", "Artifact_Roll", id, nil)
					end)
					if not okRoll or nd == nil then break end
					if type(nd) == "table" then
						profileCache = nd
						profileAt = os.clock()
						local newSl = M.FamilySlotData(nd)
						if newSl and newSl.Artifacts then arts = newSl.Artifacts end
					end
					local after = arts.Storage[id]
					if after and sig(after) == before then same = same + 1 else same = 0 end
					if same >= 3 then break end
					task.wait(0.3)
				end
				if done then
					pcall(function() getRemote:InvokeServer("S_Equipment", "Artifact_State", id, cat) end)
					note("Artifact ready: " .. name)
				end
			end)
			if not ok then note("Artifact error: " .. tostring(err)) end
			S.ArtBusy = false
		end)
	end

	-- ------------------------------------------------------------------
	--  One-click full Auto Thunder Spear
	-- ------------------------------------------------------------------
	function M.OneClickSpear()
		SetToggle("AutoReloadToggle", true)
		SetToggle("MultiHitToggle", true)
		SetToggle("AutoM1Toggle", true)
		SetToggle("AutoEquipThunderToggle", true)
		SetToggle("AutoTSQuestToggle", true)
		SetToggle("AutoBuyTSWavesToggle", true)
		SetToggle("AutoFarmRaidsToggle", true)
		for i = 1, 5 do SetToggle("AutoSkill" .. i, true) end
		pcall(function()
			local slot = player:GetAttribute("Slot")
			if slot then getRemote:InvokeServer("S_Equipment", "Weapon", "Spears") end
		end)
		if isLobby then
			if not IsToggled("AutoKillToggle") then SetToggle("AutoKillToggle", true) end
			if AutoFarm and not AutoFarm._running then pcall(function() AutoFarm:Start() end) end
		end
		note("Full Auto Thunder Spear enabled")
	end

	-- ------------------------------------------------------------------
	--  Worker loops
	-- ------------------------------------------------------------------
	local heartbeat = nil
	function M.Start()
		if heartbeat then return end
		pcall(M.RejoinHook)
		-- Station memory: load the saved positions for this map and keep noting
		-- stations as they stream in, so a refill works even when the player is
		-- far away and the station is not loaded yet.
		pcall(function()
			S.StationJob = game.JobId
			S.StationMap = M.StationMapKey()
			M.LoadStations()
			local cs = CollectionService
			for _, v in ipairs(cs:GetTagged("Station")) do
				M.NoteStation(M.MapStationPart(v))
			end
			S.StationConn = cs:GetInstanceAddedSignal("Station"):Connect(function(inst)
				task.defer(function()
					pcall(function() M.NoteStation(M.MapStationPart(inst)) end)
				end)
			end)
		end)
		-- Reference miss tracking: a confirmed damage tick clears the streak.
		pcall(function()
			postRemote.OnClientEvent:Connect(function(kind, sub)
				if kind == "Zones" and sub == "Damage_Check" then
					S.LastHitAt = os.clock()
					S.MissStreak = 0
				end
			end)
		end)
		heartbeat = RunService.Heartbeat:Connect(function(dt)
			if not getgenv().KiraHubAOTR then return end
			if isLobby or isMenu then return end
			-- Watchdog: a paused state left behind by an interrupted action
			-- must never freeze movement for good.
			if S.Paused then
				S.PausedAt = S.PausedAt or os.clock()
				if not S.Refilling and os.clock() - S.PausedAt > 20 then
					S.Paused = false
					S.PausedAt = nil
				end
			else
				S.PausedAt = nil
			end
			pcall(M.MoveStep, dt)
		end)

		task.spawn(function()
			while getgenv().KiraHubAOTR do
				task.wait(0.12)
				pcall(M.RefillStatus)
				if not isLobby and not isMenu then
					pcall(M.QTEWatch)
					pcall(M.TitanTryShift)
					pcall(M.SkillsTick)
				else
					pcall(M.RejoinWatch)
				end
			end
			if heartbeat then heartbeat:Disconnect() heartbeat = nil end
			M.RestoreCollide()
		end)

		task.spawn(function()
			while getgenv().KiraHubAOTR do
				task.wait(3)
				if isLobby then
					pcall(M.FamilyTick)
					pcall(M.ArtifactRoll)
				end
			end
		end)
	end

	return M
