	function M.SpinsUsable(spins, currency)
		local v = type(spins) == "table" and spins[currency]
		if type(v) ~= "table" then return 0 end
		return math.max(0, (tonumber(v.Amount) or 0) + (tonumber(v.Free) or 0))
