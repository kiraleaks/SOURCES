function HandleAutoCollectCrate()
	if not IsToggled("AutoCollectCrateToggle") then return end
	if not IsWavesMode() then return end
	
	local wavesFolder = workspace:FindFirstChild("Waves")
	local cratesFolder = wavesFolder and wavesFolder:FindFirstChild("Crates")
	local myCrate = cratesFolder and cratesFolder:FindFirstChild("Crate_" .. player.Name)
	
	if not myCrate then return end
	
	local wasFarming = AutoFarm._running
	-- Keep the watchdog quiet while the character detours to the crate.
	AutoFarm._holdUntil = os.clock() + 9
	if wasFarming then AutoFarm:Stop() end
	
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if root then
		root.CFrame = CFrame.new(myCrate:GetPivot().Position + Vector3.new(0, 5, 0))
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
	end
	task.wait(2)
	
	local zonesFolder = wavesFolder and wavesFolder:FindFirstChild("Zones")
	local skillsZone = zonesFolder and zonesFolder:FindFirstChild("Skills")
	if skillsZone and root then
		root.CFrame = CFrame.new(skillsZone:GetPivot().Position + Vector3.new(0, 5, 0))
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
	end
	task.wait(2)
	
	if wasFarming then AutoFarm:Start() end
end

