		StationSeen = {},
		StationJob = nil,
		StationMap = nil,
		StationFile = "aot_stations.json",
		StationConn = nil,
		RefillList = nil,
		RefillListAt = 0,
		RefillSeen = {},
	}
	M.State = S

	M.SAFE = {
		Height = 105,
		Speed = 220,
		Reach = 135,
		TitanReach = 150,
		ExtraReach = 135,
		SpearExtras = 2,
	}
	M.SwingDelay = 0.4
	M.RANKS = {"Common", "Rare", "Epic", "Legendary", "Mythic", "Secret"}
	M.FAMILY_LIST = {
		{"Shiki", "Secret"}, {"Helos", "Mythic"}, {"Fritz", "Mythic"},
		{"Ackerman", "Legendary"}, {"Yeager", "Legendary"}, {"Reiss", "Legendary"},
		{"Zoe", "Epic"}, {"Leonhart", "Epic"}, {"Ksaver", "Epic"}, {"Arlert", "Epic"},
		{"Braun", "Epic"}, {"Galliard", "Epic"}, {"Tybur", "Epic"}, {"Finger", "Epic"},
		{"Azumabito", "Rare"}, {"Springer", "Rare"}, {"Kruger", "Rare"}, {"Smith", "Rare"},
		{"Braus", "Rare"}, {"Grice", "Rare"}, {"Kirstein", "Rare"},
		{"Ral", "Common"}, {"Reeves", "Common"}, {"Pikale", "Common"}, {"Munsell", "Common"},
		{"Inocenio", "Common"}, {"Iglehaut", "Common"}, {"Hume", "Common"},
		{"Blouse", "Common"}, {"Bozado", "Common"}, {"Boyega", "Common"},
	}
	M.FAMILY_RARITY, M.FAMILY_POS = {}, {}
	for i, entry in ipairs(M.FAMILY_LIST) do
		M.FAMILY_RARITY[entry[1]] = entry[2]
		M.FAMILY_POS[entry[1]] = i
	end

	-- ------------------------------------------------------------------
	--  Option accessors (safe before the UI exists)
	-- ------------------------------------------------------------------
	local function ui()
		local hub = getgenv().KiraHub
		return hub and hub.UI or nil
	end

	function M.Toggle(name, default)
		local u = ui()
		local t = u and u.Toggles and u.Toggles[name]
		if t and t.Value ~= nil then return t.Value == true end
		return default == true
	end

	function M.Option(name, default)
		local u = ui()
		local o = u and u.Options and u.Options[name]
		if o and o.Value ~= nil then return o.Value end
		return default
	end

	function M.Num(name, default, lo, hi)
		local v = tonumber(M.Option(name, default)) or default
		if lo then v = math.max(lo, v) end
		if hi then v = math.min(hi, v) end
		return v
	end

	function M.EngineOn() return true end
	function M.Safe() return M.Toggle("SafeModeToggle", false) end
	function M.PrioritizeBoss() return M.Toggle("PrioritizeBossToggle", true) end
	function M.MultiHit() return M.Toggle("MultiHitToggle", false) end
	function M.MultiHitMax() return math.floor(M.Num("MultiHitMaxSlider", 5, 2, 16)) end
	function M.BossMult() return M.MultiHitMax() end
	-- Reference-style general hit multiplier: repeats every hit N times.
	function M.DamageMult() return math.floor(M.Num("DamageMultiplierSlider", 1, 1, 10)) end
	function M.ColossalOn() return M.Toggle("ColossalToggle", true) end

	local function note(text)
		pcall(function()
			Library:Notify({Title = "Kira Hub", Description = tostring(text), Time = 4})
		end)
	end
	M.Note = note

	-- ------------------------------------------------------------------
	--  Character / weapon helpers
	-- ------------------------------------------------------------------
	function M.Char()
		local char = player.Character
		if not char then return nil end
		local hum = char:FindFirstChildOfClass("Humanoid")
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not (hum and hrp and hum.Health > 0) then return nil end
		return char, hrp
	end

	function M.IsTitan()
		local char = player.Character
		return char ~= nil and char:GetAttribute("Shifter") == true
	end

	function M.Weapon()
		local w = KiraWeaponInfo()
		if w then return w end
		local hud = GetCurrentWeapon()
		if hud == "Spears" or hud == "Blades" then return hud end
		return "Blades"
	end

	function M.IsBossTitan(model)
		if not (model and model.Parent) then return false end
		if getgenv().KiraHub.Data.BossNames[model.Name] then return true end
		if model:GetAttribute("Shifter") == true then return true end
		return model.Name:match("^%x+%-%x+%-%x+%-%x+%-%x+$") == nil
	end

	function M.VulnPart(model)
		if not model then return nil end
		local hit = model:FindFirstChild("Hitboxes")
		hit = hit and hit:FindFirstChild("Hit")
		if not hit then return nil end
		for _, child in ipairs(hit:GetChildren()) do
			if child:IsA("BasePart") and child:GetAttribute("Vulnerable") == true and child.CanTouch then
				return child
			end
		end
		return nil
	end

	function M.BossBusy(model)
		if os.clock() < (S.BossBusyUntil or 0) then return true end
		if model:GetAttribute("Heatwave") then return true end
		if model:GetAttribute("Hardening") == nil or M.VulnPart(model) then return false end
		return true
	end

	function M.ValidTitan(model)
		local nape = KiraNape(model)
		if not nape then return false end
		local boss = M.IsBossTitan(model)
		if not nape.CanTouch and not (boss and M.VulnPart(model)) then return false end
		if boss then return not M.BossBusy(model) end
		local hum = model:FindFirstChildOfClass("Humanoid")
		if hum and hum.Health <= 0 then return false end
		local pending = S.Pending[model]
		if pending and os.clock() - pending < 1.5 then return false end
		return true
	end

	-- ------------------------------------------------------------------
	--  Movement (per-frame CFrame.lookAt movement)
	-- ------------------------------------------------------------------
	function M.Speed()
		local v = tonumber(M.Option("HoverSpeedSlider", 400)) or 400
		if M.Safe() then v = math.min(v, M.SAFE.Speed) end
		return math.max(v, 100)
	end

	function M.HoverHeight()
		if M.Safe() then return M.SAFE.Height end
		return tonumber(M.Option("FloatHeightSlider", 250)) or 250
	end

	function M.SpearDist()
		-- Exactly the reference formula: the "LnSpear" attribute holds the
		-- blast-radius level as a string; 0.95 * level + 16, 220 when unread.
		local attr = player:GetAttribute("LnSpear")
		local n
		if attr then n = tonumber(tostring(attr):match("^([%d%.]+)")) end
		local base = (n and n > 0) and (0.95 * n + 16) or 220
		return base + (S.SpearExtra or 0)
	end

	function M.Reach()
		if M.Safe() then
			return M.IsTitan() and M.SAFE.TitanReach or M.SAFE.Reach
		end
		return tonumber(M.Option("AttackRangeSlider", 150)) or 150
	end

	function M.MoveMode()
		return tostring(M.Option("MovementModeDropdown", "Better Teleport"))
	end

	local collided = {}
	-- The reference engine clears collision on the CHARACTER's own parts (so
	-- physics never fights the per-frame CFrame write). Touching the map's
	-- collision would drop the character through the world.
	function M.DisableMapCollide()
		if os.clock() - (S.CollideAt or 0) < 0.5 then return end
		S.CollideAt = os.clock()
		local char = player.Character
		if not char then return end
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") and d.CanCollide then
				collided[d] = true
				d.CanCollide = false
			end
		end
	end

	function M.RestoreCollide()
		for part in pairs(collided) do
			if part and part.Parent then pcall(function() part.CanCollide = true end) end
		end
		table.clear(collided)
	end

	function M.MoveStep(dt)
		if M.MoveMode() ~= "Better Teleport" then return end
		if not (AutoFarm and (AutoFarm._running or IsToggled("ManualAutoAttackToggle"))) then return end
		if S.Paused or S.Refilling then return end
		-- Titan form has its own stance movement in the farm loop; two writers
		-- would fight over the CFrame every frame.
		if M.IsTitan() then return end
		local _, root = M.Char()
		if not root then return end
		-- Skill cast: stand 35 studs off the target, facing it (same as the
		-- reference engine's SkillTarget branch).
		local skillTarget = S.SkillTarget
		if skillTarget and skillTarget.PrimaryPart and skillTarget.Parent then
			M.DisableMapCollide()
			local aim = skillTarget.PrimaryPart.Position
			local from = S.SkillFrom or root.Position
			local flat = Vector3.new(from.X - aim.X, 0, from.Z - aim.Z)
			local stand = aim + (flat.Magnitude > 1 and flat.Unit or Vector3.xAxis) * 35
			root.CFrame = CFrame.lookAt(stand, Vector3.new(aim.X, stand.Y, aim.Z))
			root.AssemblyLinearVelocity = Vector3.zero
			return
		end
		local nape = (S.Target and S.Target.nape) or getgenv().KiraHub.State.TargetNape
		if not nape or not nape.Parent then
			M.DisableMapCollide()
			S.HoldCF = S.HoldCF or root.CFrame
			root.CFrame = S.HoldCF
			root.AssemblyLinearVelocity = Vector3.zero
			return
		end
		M.DisableMapCollide()
		local spear = (M.Weapon() == "Spears") and not M.IsTitan()
		local height = spear and M.SpearDist() or M.HoverHeight()
		local aim = nape.Position + Vector3.new(0, height, 0)
		local delta = aim - root.Position
		local mag = delta.Magnitude
		if mag > 0.5 then
			local unit = delta.Unit
			local step = math.min(mag, M.Speed() * dt)
			root.CFrame = CFrame.lookAt(root.Position + unit * step, nape.Position)
		end
		if os.clock() < (S.ImpulseUntil or 0) then
			root.AssemblyLinearVelocity = S.ImpulseDir * (S.ImpulseSpeed or 0)
		else
			root.AssemblyLinearVelocity = Vector3.zero
		end
		S.HoldCF = root.CFrame
		S.LoopBeat = os.clock()
	end

	-- ------------------------------------------------------------------
	--  Colossal raid cannon (CollectionService tagged model, real flow)
	-- ------------------------------------------------------------------
	local CollectionService = game:GetService("CollectionService")
	M.CannonUsed = setmetatable({}, { __mode = "k" })

	-- All wall cannons assigned to this player. In the colossal stall phase the
	-- game hands out more than one, so hopping between them keeps the shots
	-- coming while a single cannon is reloading.
	function M.Cannons()
		local ok, tagged = pcall(function() return CollectionService:GetTagged("Cannon") end)
		if not ok or type(tagged) ~= "table" then return {} end
		local list = {}
		for _, v in ipairs(tagged) do
			if v:GetAttribute("Spawn") == player.Name and v:GetAttribute("Setup") == true then
				list[#list + 1] = v
			end
		end
		return list
	end

	function M.MyCannon()
		return M.Cannons()[1]
	end

	-- A cannon that can be fired right now (no cooldown, not firing, owned by
	-- this player or unclaimed). Falls back to the first assigned cannon.
	function M.ReadyCannon()
		local fallback
		for _, v in ipairs(M.Cannons()) do
			fallback = fallback or v
			if v:GetAttribute("Cooldown") == nil and v:GetAttribute("Firing") == nil
				and (v:GetAttribute("Player") == nil or v:GetAttribute("Player") == player.Name) then
				return v
			end
		end
		return fallback
	end

	-- Strict version: true only when a shot can actually be fired. The farm
	-- loop uses it to decide between "shoot the Colossal" and "fight the adds
	-- until the next cannon is loaded".
	function M.CannonReadyNow()
		for _, v in ipairs(M.Cannons()) do
			if v:GetAttribute("Cooldown") == nil and v:GetAttribute("Firing") == nil
				and (v:GetAttribute("Player") == nil or v:GetAttribute("Player") == player.Name) then
				return true
			end
		end
		return false
	end

	-- Colossal phase 1 = the wall-cannon stall. Detected from the stall
	-- objective the game exposes (value below its requirement). Attacking the
	-- Colossal or walking to a refill station there breaks the cannon shots.
	function M.ColossalPhase1()
		local active = false
		local function scan(folder)
			local objective = folder and folder:FindFirstChild("Stall_Colossal_Titan")
			if not objective then return end
			local ok, value = pcall(function() return objective.Value end)
			local n = ok and tonumber(value) or nil
			if n == nil then return end
			local req = tonumber(objective:GetAttribute("Requirement")) or 1
			if n < req then active = true end
		end
		pcall(function()
			scan(game:GetService("ReplicatedStorage"):FindFirstChild("Objectives"))
		end)
		pcall(function()
			local u = workspace:FindFirstChild("Unclimbable")
			scan(u and u:FindFirstChild("Objective"))
		end)
		return active
	end

	-- Where to stand to use a cannon: on the cannon itself.
	function M.CannonSpot(cannon)
		cannon = cannon or M.ReadyCannon()
		if not cannon then return nil end
		local pos
		local ok, pivot = pcall(function() return cannon:GetPivot() end)
		if ok and pivot then pos = pivot.Position else pos = cannon.Position end
		if not pos then return nil end
		return pos + Vector3.new(0, 5, 0)
	end

	function M.CannonShot()
		if not M.ColossalOn() then return false end
		local titans = workspace:FindFirstChild("Titans")
		local colossal = titans and titans:FindFirstChild("Colossal_Titan")
		if not colossal or not KiraNape(colossal)
			or player:GetAttribute("Cutscene")
			or player:GetAttribute("Dead") == true then
			return false
		end
		local phase1 = M.ColossalPhase1()
		local cannon = M.ReadyCannon()
		if not cannon
			or cannon:GetAttribute("Cooldown") ~= nil
			or cannon:GetAttribute("Firing") ~= nil
			or (cannon:GetAttribute("Player") ~= nil and cannon:GetAttribute("Player") ~= player.Name) then
			return false
		end

		S.Paused = true
		-- Teleport onto the cannon before firing (phase 1). The shot is fired
		-- through the tagged model, so the character has to be on it; the farm
		-- loop resumes fighting the adds as soon as this returns.
		if phase1 then
			local spot = M.CannonSpot(cannon)
			local _, r = M.Char()
			if spot and r then
				r.CFrame = CFrame.new(spot)
				r.AssemblyLinearVelocity = Vector3.zero
				S.HoldCF = r.CFrame
			end
		end
		local hit = false
		pcall(function()
			local state
			if cannon:GetAttribute("Player") == player.Name then
				state = {
					Base = cannon:GetAttribute("Base") or 0,
					BarrelWood = cannon:GetAttribute("BarrelWood") or 0,
				}
			end
			state = state or getRemote:InvokeServer("Cannon", "State", cannon, true, nil)
			if type(state) ~= "table" then return end
			if getRemote:InvokeServer("Cannon", "Shoot", {
				Base = state.Base or 0,
				BarrelWood = state.BarrelWood or 0,
			}) == true then
				local t0 = os.clock()
				while os.clock() - t0 < 2.5 and not hit do
					for _, child in ipairs(workspace:GetChildren()) do
						if child:GetAttribute("Player") == player.Name
							and child:GetAttribute("Skill") == "Cannon"
							and not M.CannonUsed[child] then
							M.CannonUsed[child] = true
							local nape = KiraNape(colossal)
							if nape then
								pcall(function()
									postRemote:FireServer("S_Skills", "Impact", child, nape.Position)
								end)
							end
							hit = true
							break
						end
					end
					if not hit then task.wait(0.05) end
				end
			end
			local t1 = os.clock()
			while cannon:GetAttribute("Firing") ~= nil and os.clock() - t1 < 3 do
				task.wait(0.05)
			end
			pcall(function()
				getRemote:InvokeServer("Cannon", "State", cannon, false, {
					Angles = {
						Base = state.Base or 0,
						BarrelWood = state.BarrelWood or 0,
					},
				})
			end)
		end)
		S.Paused = false
		return hit
	end

	-- ------------------------------------------------------------------
	--  Spear attack (reference flow): hold at SpearDist, fire a slot the
	--  server actually accepts, then one S_Explode per target with fuse 0.
	-- ------------------------------------------------------------------
	local function spearIdsFree()
		local ids = {}
		local ok, live = pcall(KiraSpearIds)
		if ok and type(live) == "table" then
			for id, unused in pairs(live) do
				if unused and id >= 1 and id <= 8 then ids[#ids + 1] = id end
			end
		end
		table.sort(ids)
		return ids
	end

	local function fireSpear(id)
		local ok, res = pcall(function()
			return getRemote:InvokeServer("Spears", "S_Fire", tostring(id))
		end)
		return ok and res == true
	end

	function M.SpearAttack(nape, others)
		local _, root = M.Char()
		if not root then return end

		-- Reference: an empty rig refills at a station right here and gives
		-- the reload a second to land before the shot is retried.
		if M.SpearCount() <= 0 then
			M.RefillOnce(M.RefillsTotal())
			if M.SpearCount() <= 0 and M.RefillOn() and M.RefillsTotal() > 0 then
				note("Spear: refill has not landed yet, retrying")
				task.wait(1)
				return
			end
			if M.SpearCount() <= 0 then
				if not S.WarnedNoRefill and M.RefillsTotal() <= 0 then
					S.WarnedNoRefill = true
					note("Out of spears and Refills: farm is waiting")
				end
				task.wait(2)
				return
			end
		end
		S.WarnedNoRefill = false

		-- Hold at the spear stand-off distance (same wait budget as the
		-- reference engine) so the explosion lands on the nape.
		local want = M.SpearDist()
		local startAt = os.clock()
		local waitMax = math.min(8, (nape.Position - root.Position).Magnitude / math.max(M.Speed(), 50) + 1)
		local arrived = false
		while os.clock() - startAt < waitMax do
			local _, r = M.Char()
			if not r then break end
			if not (nape.Parent and M.EngineOn()) then break end
			if math.abs((nape.Position - r.Position).Magnitude - want) < 20 then
				arrived = true
				break
			end
			task.wait()
		end
		if not arrived or not nape.Parent then return end

		local model = KiraNapeModel(nape)
		local boss = model and M.IsBossTitan(model) or false
		if not nape.CanTouch and not (boss and M.VulnPart(model)) then return end

		local _, r0 = M.Char()
		if M.Safe() and r0 and (want + 80) < (nape.Position - r0.Position).Magnitude then return end

		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local hp0 = hum and hum.Health

		-- Fire a slot the server actually accepts. A refused shot must never
		-- explode (that was the "spears do nothing" bug).
		local fired
		local first = KiraPickSpearId()
		if first and fireSpear(first) then
			fired = first
		else
			for _, id in ipairs(spearIdsFree()) do
				if fireSpear(id) then fired = id break end
			end
		end
		if not fired then
			-- Every slot was refused: the client's marks are out of sync.
			note("Spear: server refused every slot, reloading")
			getgenv().KiraHub.State.ForceSpearReset = true
			KiraRefreshSpearMarks()
			if M.RefillsTotal() > 0 then
				if os.clock() - (S.SpearFixAt or 0) > 10 then
					S.SpearFixAt = os.clock()
					M.RefillOnce(M.RefillsTotal())
				else
					task.wait(1)
				end
			else
				if not S.WarnedNoRefill then
					S.WarnedNoRefill = true
					note("The game locked the spears and there are no Refills: waiting")
				end
				task.wait(2)
			end
			return
		end

		-- Bosses are hit on the vulnerable part when one is exposed; the nape
		-- is the fallback (reference: VulnPart overrides the nape position).
		local aimPos = nape.Position
		local _, r1 = M.Char()
		local ln = tonumber(tostring(player:GetAttribute("LnSpear") or ""):match("^([%d%.]+)")) or 100
		local targets = {}
		local mult = boss and math.max(1, math.floor(M.BossMult() or 1)) or 1
		-- Damage Multiplier repeats the explosion on every target, boss or add.
		mult = math.min(60, mult * M.DamageMult())
		local vuln = boss and M.VulnPart(model) or nil
		if vuln then aimPos = vuln.Position end
		for _ = 1, mult do
			targets[#targets + 1] = aimPos
		end

		-- Reference extras: only with Multi Hit on, nearest-first, capped at
		-- Multi Hit Targets - 1 and at 2 in Safe Mode. Every extra inside the
		-- blast window gets one S_Explode.
		if M.MultiHit() and type(others) == "table" and r1 then
			local extraMin = 0.78 * ln + 16
			local extraMax = M.SpearDist() + 80
			local limit = math.min(M.MultiHitMax() - 1, M.Safe() and M.SAFE.SpearExtras or math.huge)
			local cands = {}
			for _, o in ipairs(others) do
				if o and o ~= nape and o.Parent and o.Position then
					local d = (o.Position - r1.Position).Magnitude
					if not M.Safe() or not (extraMax < d) then
						cands[#cands + 1] = {part = o, d = d}
					end
				end
			end
			table.sort(cands, function(a, b) return a.d < b.d end)
			local added = 0
			for _, c in ipairs(cands) do
				if added >= limit then break end
				added = added + 1
				if c.part.CanTouch and extraMin <= c.d then
					targets[#targets + 1] = c.part.Position
				end
			end
		end

		for _, pos in ipairs(targets) do
			pcall(function() postRemote:FireServer("Spears", "S_Explode", pos, 0) end)
		end

		-- Reference pending marks: every non-boss titan whose nape sits inside
		-- the blast radius is skipped by the next attack for 1.5s.
		local titans = workspace:FindFirstChild("Titans")
		if titans then
			for _, child in ipairs(titans:GetChildren()) do
				local otherNape = KiraNape(child)
				if otherNape and not M.IsBossTitan(child) then
					for _, pos in ipairs(targets) do
						if (otherNape.Position - pos).Magnitude < ln then
							S.Pending[child] = os.clock()
							break
						end
					end
				end
			end
		end

		task.wait(math.max(M.SwingDelay, 0.5))
		S.MissStreak = (S.MissStreak or 0) + 1

		if hum and hp0 and hum.Health > 0 and hum.Health < hp0 - 1 then
			if (S.SpearExtra or 0) < 160 then
				S.SpearExtra = (S.SpearExtra or 0) + 20
				note(string.format("Spear: took %.0f damage, backing off (+%d)",
					hp0 - hum.Health, S.SpearExtra))
			end
		end
	end

	-- Reference HoldAt: in Safe Mode the character glides to the spot at the
	-- safe speed (frame-time based, exactly like the reference engine), then it
	-- is held there for `sec`. Outside Safe Mode it is a direct teleport.
	function M.HoldAt(pos, sec)
		if not pos then return false end
		if M.Safe() then
			while true do
				local _, root = M.Char()
				if not root or (root.Position - pos).Magnitude <= 15 then break end
				local dt = RunService.Heartbeat:Wait()
				local _, r = M.Char()
				if not r then return false end
				local d = pos - r.Position
				r.CFrame = CFrame.new(r.Position + d.Unit * math.min(d.Magnitude, M.SAFE.Speed * dt))
				r.AssemblyLinearVelocity = Vector3.zero
				S.LoopBeat = os.clock()
			end
		end
		local t0 = os.clock()
		repeat
			local _, root = M.Char()
			if not root then return false end
			root.CFrame = CFrame.new(pos)
			root.AssemblyLinearVelocity = Vector3.zero
			S.LoopBeat = os.clock()
			RunService.Heartbeat:Wait()
		until os.clock() - t0 >= (sec or 0.2)
		return true
	end

	-- ------------------------------------------------------------------
	--  Refill (reference flow: find station -> hold -> Reload -> verify ->
	--  retry when empty -> spear fill wait)
	-- ------------------------------------------------------------------
	-- Reference ammo model: player Refills + the wave Refills upgrade, and the
	-- portable (tagged) stations carry their own stock.
	function M.PlayerRefills()
		local n = tonumber(player:GetAttribute("Refills")) or 0
		local waves = workspace:FindFirstChild("Waves")
		local upgrades = waves and waves:FindFirstChild("Upgrades")
		local refills = upgrades and upgrades:FindFirstChild("Refills")
		if refills and refills:IsA("ValueBase") then
			n = n + (tonumber(refills.Value) or 0)
		end
		return n
	end

	-- The "Refills" attribute is sometimes absent for a moment (fresh spawn or
	-- wave transition). Treating that as zero used to disable refilling.
	function M.RefillsKnown()
		return type(player:GetAttribute("Refills")) == "number"
	end

	-- Wave maps keep their refill stations in Unclimbable.Objective.Waves; the
	-- wave upgrade folder (workspace.Waves) is a different thing. Both are
	-- checked so a wave refill works even when the character attribute is nil.
	function M.WaveFolder()
		local ok, folder = pcall(function()
			local u = workspace:FindFirstChild("Unclimbable")
			local o = u and u:FindFirstChild("Objective")
			return o and o:FindFirstChild("Waves")
		end)
		if ok and folder then return folder end
		return nil
	end

	-- A wave station has its own stock, so "0 personal refills" must not block
	-- the trip there.
	function M.RefillPossible()
		if M.RefillsTotal() > 0 then return true end
		return M.WaveFolder() ~= nil
	end

	function M.PortableStations()
		local list = {}
		local ok, tagged = pcall(function() return CollectionService:GetTagged("Station") end)
		for _, v in ipairs(ok and tagged or {}) do
			if v:GetAttribute("Max_Refills") ~= nil
				and (tonumber(v:GetAttribute("Refills")) or 0) > 0
			then
				local refill = v:FindFirstChild("Refill", true)
				if refill and refill:IsA("BasePart") then list[#list + 1] = refill end
			end
		end
		return list
	end

	function M.PortableRefills()
		local n = 0
		for _, v in ipairs(M.PortableStations()) do
			local parent = v.Parent
			n = n + (tonumber(parent and parent:GetAttribute("Refills")) or 0)
		end
		return n
	end

	function M.RefillsTotal()
		return M.PlayerRefills() + M.PortableRefills()
	end

	function M.SpearCount()
		return KiraSpearsLeft() or 0
	end

	-- Reference blade ammo: unbroken blades on the left hand (1..7) and unused
	-- spare sets (1..3).
	function M.BladeAmmo()
		local char = player.Character
		local rig = char and char:FindFirstChild("Rig_" .. player.Name)
		if not rig and char then
			for _, c in ipairs(char:GetChildren()) do
				if c.Name:sub(1, 4) == "Rig_" then rig = c break end
			end
		end
		if not rig then return 0, 0 end
		local segs = 0
		local left = rig:FindFirstChild("LeftHand")
		if left then
			for i = 1, 7 do
				local blade = left:FindFirstChild("Blade_" .. i)
				if blade and blade:GetAttribute("Broken") == nil then segs = segs + 1 end
			end
		end
		local sets = 0
		for i = 1, 3 do
			local spare = rig:FindFirstChild("Left_" .. i, true)
			if spare and spare:GetAttribute("Used") == nil then sets = sets + 1 end
		end
		return segs, sets
	end

	function M.AmmoEmpty()
		local char = player.Character
		if not char then return nil end
		if player:GetAttribute("Weapon") == "Spears" then
			if char:GetAttribute("Spears") == nil then return nil end
			return M.SpearCount() <= 0
		end
		if not char:FindFirstChild("Rig_" .. player.Name) then
			local found = false
			for _, c in ipairs(char:GetChildren()) do
				if c.Name:sub(1, 4) == "Rig_" then found = true break end
			end
			if not found then return nil end
		end
		local segs, sets = M.BladeAmmo()
		return segs == 0 and sets == 0
	end

	-- Reference blade top-up (v904): a live blade segment means nothing to do;
	-- with no spare sets the station refill runs, then the spare set is swapped
	-- in with the Blades/Reload remote.
	function M.BladeReload()
		local segs, sets = M.BladeAmmo()
		if segs > 0 then return true end
		if sets == 0 then
			M.RefillOnce(M.RefillsTotal())
			segs, sets = M.BladeAmmo()
		end
		if sets > 0 then
			pcall(function() getRemote:InvokeServer("Blades", "Reload") end)
			task.wait(0.15)
			segs = M.BladeAmmo()
		end
		return segs > 0
	end

	-- Station bookkeeping: every station seen is remembered per map and
	-- written to disk, so a refill still works on a fresh join even when the
	-- player is far away and the station has not streamed in yet.
	function M.StationMapKey()
		return tostring(game.PlaceId) .. "|"
			.. tostring(workspace:GetAttribute("Name") or workspace:GetAttribute("Map") or "")
	end

	local function fsReady()
		return type(isfile) == "function" and type(readfile) == "function"
			and type(writefile) == "function"
	end

	function M.SaveStations()
		if not fsReady() then return end
		pcall(function()
			local data = {}
			if isfile(S.StationFile) then
				local ok, decoded = pcall(function()
					return HttpService:JSONDecode(readfile(S.StationFile))
				end)
				if ok and type(decoded) == "table" then data = decoded end
			end
			local list = {}
			for _, p in ipairs(S.StationPos) do
				list[#list + 1] = { math.floor(p.X), math.floor(p.Y), math.floor(p.Z) }
			end
			data[S.StationMap or M.StationMapKey()] = list
			writefile(S.StationFile, HttpService:JSONEncode(data))
		end)
	end

	function M.LoadStations()
		if not fsReady() then return end
		pcall(function()
			if not isfile(S.StationFile) then return end
			local ok, data = pcall(function()
				return HttpService:JSONDecode(readfile(S.StationFile))
			end)
			if not ok or type(data) ~= "table" then return end
			local saved = data[M.StationMapKey()]
			if type(saved) ~= "table" then return end
			for _, v in ipairs(saved) do
				if type(v) == "table" then
					local pos = Vector3.new(
						math.floor(tonumber(v[1]) or 0),
						math.floor(tonumber(v[2]) or 0),
						math.floor(tonumber(v[3]) or 0)
					)
					local key = pos.X .. "," .. pos.Y .. "," .. pos.Z
					if not S.StationSeen[key] then
						S.StationSeen[key] = true
						table.insert(S.StationPos, pos)
					end
				end
			end
		end)
	end

	function M.NoteStation(part)
		if not (part and part:IsA("BasePart")) then return end
		local pos = part.Position
		local key = math.floor(pos.X) .. "," .. math.floor(pos.Y) .. "," .. math.floor(pos.Z)
		if S.StationSeen[key] then return end
		S.StationSeen[key] = true
		table.insert(S.StationPos, pos)
		M.SaveStations()
	end

	function M.MapStationPart(inst)
		if not inst or inst:GetAttribute("Max_Refills") ~= nil then return nil end
		local refill = inst.Name == "Refill" and inst or nil
		if not refill then refill = inst:FindFirstChild("Refill", true) end
		if refill and refill:IsA("BasePart") and refill:IsDescendantOf(workspace) then
			return refill
		end
		return nil
	end

	local function promptCount(prompt)
		if not prompt then return nil end
		local txt = tostring(prompt.ObjectText or "") .. " " .. tostring(prompt.ActionText or "")
		local n = txt:match("(%d+)%s*/%s*%d+")
		return n and tonumber(n) or nil
	end

	local function refillWorked(before, prompt)
		-- The station prompt itself carries the remaining refill count. In
		-- wave mode the character attribute can lag or be nil, so the prompt
		-- is the most reliable "the server accepted it" signal.
		if before.prompt and prompt then
			local now = promptCount(prompt)
			if now and now < before.prompt then return true end
		end
		if M.RefillsTotal() < (before.refills or 0) then return true end
		if M.Weapon() == "Spears" then
			return M.SpearCount() > (before.spears or 0)
		end
		local segs, sets = M.BladeAmmo()
		return sets > (before.sets or 0) or segs > (before.segs or 0)
	end

	-- Use V3's proven prompt helpers when they exist (they handle the
	-- ProximityPrompt, the hold animation and the R-key fallback).
	local function promptOf(station)
		if type(KiraPromptOf) == "function" then
			local ok, p = pcall(KiraPromptOf, station)
			if ok then return p end
		end
		local p = station:FindFirstChildWhichIsA("ProximityPrompt", true)
		if not p and station.Parent then
			p = station.Parent:FindFirstChildWhichIsA("ProximityPrompt", true)
		end
		return p
	end

	local function promptPos(prompt, station)
		if type(KiraPromptPos) == "function" then
			local ok, pos = pcall(KiraPromptPos, prompt, station)
			if ok and pos then return pos end
		end
		local par = prompt and prompt.Parent
		if par and par:IsA("BasePart") then return par.Position end
		if par and par:IsA("Attachment") then return par.WorldPosition end
		return station.Position
	end

	local function pressPrompt(prompt)
		if not prompt then return false end
		if type(KiraPressPrompt) == "function" then
			if pcall(KiraPressPrompt, prompt) then return true end
		end
		if type(fireproximityprompt) == "function" then
			if pcall(fireproximityprompt, prompt) then return true end
		end
		return pcall(function()
			prompt:InputHoldBegin()
			task.wait((prompt.HoldDuration or 0) + 0.15)
			prompt:InputHoldEnd()
		end)
	end

	local function pressR(prompt)
		if type(KiraPressR) == "function" then
			pcall(KiraPressR, prompt)
			return
		end
		local hold = (prompt and prompt.HoldDuration or 0) + 0.2
		pcall(function() VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game) end)
		task.wait(hold)
		pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game) end)
	end

	-- Reference station lookup: portable stations when the player has no
	-- refills of their own, otherwise every tagged station (plus a cached
	-- "Refill" part scan), and finally the remembered positions.
	function M.FindStation()
		local mapKey = M.StationMapKey()
		if S.StationJob ~= game.JobId then
			S.StationPos, S.StationSeen, S.StationJob, S.StationMap = {}, {}, game.JobId, mapKey
			M.LoadStations()
		elseif S.StationMap ~= mapKey then
			-- The map name streams in a moment after the job starts. Reload the
			-- saved positions for the real map without dropping what was seen.
			S.StationMap = mapKey
			M.LoadStations()
		end
		local _, root = M.Char()
		if not root then return nil end
		local best, bestDist
		local function consider(part)
			if not (part and part.Parent) then return end
			local d = (part.Position - root.Position).Magnitude
			if not bestDist or d < bestDist then best, bestDist = part, d end
		end

		-- V3's proven scan: the wave folder first, then the per-map refill
		-- place, then the whole workspace. It does not depend on the personal
		-- refill attribute, so wave refills keep working when that is nil.
		if type(KiraRefillStations) == "function" then
			local okList, list = pcall(KiraRefillStations)
			if okList and type(list) == "table" then
				for _, part in ipairs(list) do
					if part and part.Parent then
						M.NoteStation(part)
						consider(part)
					end
				end
				if best then return best end
			end
		end

		if M.PlayerRefills() <= 0 then
			for _, v in ipairs(M.PortableStations()) do consider(v) end
			return best
		end

		local ok, tagged = pcall(function() return CollectionService:GetTagged("Station") end)
		for _, v in ipairs(ok and tagged or {}) do
			local part = M.MapStationPart(v)
			if part then
				M.NoteStation(part)
				consider(part)
			end
		end

		if not best then
			local list = S.RefillList
			local refresh = true
			if list and os.clock() - (S.RefillListAt or 0) <= 20 then
				refresh = false
				for _, v in ipairs(list) do
					if not v.Parent then refresh = true break end
				end
			end
			if refresh then
				list = {}
				for _, v in ipairs(workspace:GetDescendants()) do
					if v.Name == "Refill" and v:IsA("BasePart") and v.Parent
						and v.Parent:GetAttribute("Max_Refills") == nil
					then
						list[#list + 1] = v
					end
				end
				S.RefillList, S.RefillListAt = list, os.clock()
			end
			for _, v in ipairs(list) do
				if v.Parent then
					M.NoteStation(v)
					consider(v)
				end
			end
		end

		if best then return best end

		local saved, savedDist
		for _, pos in ipairs(S.StationPos) do
			local d = (pos - root.Position).Magnitude
			if not savedDist or d < savedDist then saved, savedDist = pos, d end
		end
		return nil, saved
	end

	-- First visit to a map: nothing is remembered yet, so ask the server to
	-- stream the usual station spots (the player's own position, the map spawn
	-- and the map centre) and look again. Without this a player who has never
	-- walked past a station has nothing to fly to.
	function M.StreamStations()
		local anchors = {}
		local _, root = M.Char()
		if root then anchors[#anchors + 1] = root.Position end
		pcall(function()
			local spawn = workspace:FindFirstChildOfClass("SpawnLocation")
			if spawn then anchors[#anchors + 1] = spawn.Position end
		end)
		pcall(function()
			local cf = workspace:GetBoundingBox()
			if cf then anchors[#anchors + 1] = cf.Position end
		end)
		for _, pos in ipairs(anchors) do
			pcall(function() player:RequestStreamAroundAsync(pos, 4) end)
			for _ = 1, 6 do
				local station = M.FindStation()
				if station then return station end
				task.wait(0.2)
			end
		end
		return nil
	end

	function M.DoRefill(count)
		S.RefillNote = "Finding station"
		local station, savedPos = M.FindStation()
		if not station and not savedPos then
			-- Nothing remembered for this map yet: stream the likely spots and
			-- look again before giving up.
			station = M.StreamStations()
			if not station then station, savedPos = M.FindStation() end
		end
		if not station and savedPos then
			S.RefillNote = "Going to station"
			note(string.format("Refill: station not streamed, flying to (%.0f, %.0f, %.0f)",
				savedPos.X, savedPos.Y, savedPos.Z))
			task.spawn(function()
				pcall(function() player:RequestStreamAroundAsync(savedPos, 6) end)
			end)
			local t0 = os.clock()
			while not station and os.clock() - t0 < 8 do
				if not M.HoldAt(savedPos + Vector3.new(0, 4, 0), 0.25) then return false end
				station = M.FindStation()
			end
		end
		if not station then
			S.RefillNote = "No station"
			note("Refill: no station found")
			return false
		end
		S.RefillNote = "At station"

		local prompt = promptOf(station)
		local standPos = promptPos(prompt, station)

		local before = {
			refills = count,
			spears = M.SpearCount(),
			segs = 0,
			sets = 0,
			prompt = promptCount(prompt),
		}
		before.segs, before.sets = M.BladeAmmo()

		local attempts = M.AmmoEmpty() == true and 4 or 1
		local done = false
		local char0 = player.Character
		local hum0 = char0 and char0:FindFirstChildOfClass("Humanoid")
		local hp0 = hum0 and hum0.Health

		for attempt = 1, attempts do
			if not station.Parent then
				station = M.FindStation() or station
				prompt = promptOf(station)
				standPos = promptPos(prompt, station)
			end
			if not M.HoldAt(standPos or station.Position, attempt == 1 and 0.7 or 0.5) then return false end
			-- Real interaction first (waves and missions both accept it), then
			-- the Reload remote as a fallback. The old flow only fired the
			-- remote, which the wave stations ignored.
			if attempt == 1 then
				if prompt then pressPrompt(prompt) else pressR(nil) end
			elseif attempt == 2 then
				pressR(prompt)
			end
			pcall(function() postRemote:FireServer("Attacks", "Reload", station) end)
			local t0 = os.clock()
			local worked = false
			while os.clock() - t0 < 3 do
				if not M.HoldAt(standPos or station.Position, 0.2) then return false end
				if refillWorked(before, prompt) then
					worked = true
					break
				end
				-- Never stand in a raid getting chewed on: the moment the
				-- station costs health (or the character dies), leave and let
				-- the farm re-engage from the saved position.
				if hum0 and (hum0.Health <= 0 or (hp0 and hum0.Health < hp0 - 5)) then
					S.RefillNote = "Under fire"
					note("Refill: under fire at the station, leaving")
					return done, station, before, true
				end
			end
			if worked then
				S.RefillNote = "Refilled"
				done = true
				break
			end
			if attempts == 1 then break end
			S.RefillNote = "Retrying"
			note("Refill: server did not reload (attempt " .. attempt .. "), retrying")
		end
		if not done then S.RefillNote = "Refill failed" end
		return done, station, before
	end

	-- Stay at the station until the spear racks stop filling (reference loop,
	-- bounded so the character never parks there long enough to be killed).
	local function spearFillWait(station, before)
		if not (station and station.Parent) then return end
		local pos = station.Position
		local char = player.Character
		local maxSpears = tonumber(char and char:GetAttribute("Max_Spears")) or 8
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local hp0 = hum and hum.Health
		local startAt = os.clock()
		local last = M.SpearCount()
		local lastAt = os.clock()
		local startSpears = before and before.spears or last
		while os.clock() - startAt < 5 do
			if not M.HoldAt(pos, 0.2) then break end
			if hum and hp0 and hum.Health < hp0 - 1 then break end
			local n = M.SpearCount()
			if n >= maxSpears then break end
			if n ~= last then last, lastAt = n, os.clock() end
			local gained = n > startSpears
			if gained and os.clock() - lastAt > 2 then break end
			if os.clock() - startAt > 4 and not gained then break end
		end
	end

	-- The wrapper: pauses the farm, refills, then puts the character back where
	-- it was. Every exit path clears Paused/Refilling so the farm can never
	-- wedge in a paused state.
	function M.RefillOnce(count)
		if not M.RefillOn() then return false end
		if S.Refilling then return false end
		-- Colossal phase 1: the cannon owns the trip. Never walk away from a
		-- loaded cannon.
		if M.ColossalPhase1() and M.CannonReadyNow() then return false end
		local total = M.RefillsTotal()
		if not M.RefillPossible() then return false end
		local _, root = M.Char()
		if not root then return false end
		S.Refilling = true
		S.RefillSince = os.clock()
		getgenv().KiraHub.State.Refilling = true
		local waitAt = os.clock()
		while S.Paused and os.clock() - waitAt < 6 do task.wait(0.1) end
		local _, root2 = M.Char()
		if not root2 then
			S.Refilling = false
			getgenv().KiraHub.State.Refilling = false
			return false
		end
		local hold = root2.CFrame
		S.Paused = true
		local ok, done, station, before, aborted = pcall(M.DoRefill, count or total)
		if not ok then note("Refill error: " .. tostring(done)) end
		if not ok or not station then
			S.RefillRetryAt = os.clock() + 5
			local _, r = M.Char()
			if r then
				r.CFrame = hold
				r.AssemblyLinearVelocity = Vector3.zero
			end
			S.HoldCF = hold
			S.Paused = false
			S.Refilling = false
			getgenv().KiraHub.State.Refilling = false
			return false
		end
		if aborted then
			-- Took damage at the station: put the character back immediately
			-- and let the normal retry cooldown bring it in again.
			S.RefillRetryAt = os.clock() + 3
			local _, ra = M.Char()
			if ra then
				ra.CFrame = hold
				ra.AssemblyLinearVelocity = Vector3.zero
			end
			S.HoldCF = hold
			S.Paused = false
			S.Refilling = false
			getgenv().KiraHub.State.Refilling = false
			return false
		end
		if not done then
			S.RefillRetryAt = os.clock() + 3
			note("Refill: server refused the reload, retrying")
		end
		if M.Weapon() == "Spears" and (done or M.AmmoEmpty() == false) then
			pcall(spearFillWait, station, before)
		end
		if M.Weapon() == "Spears" then
			pcall(KiraResetSpearMarks)
		end
		if done and M.Weapon() ~= "Spears" then
			-- Reference: keep holding until a blade set is back on the rig.
			local t0 = os.clock()
			while os.clock() - t0 < 2 do
				local segs, sets = M.BladeAmmo()
				if segs > 0 or sets > 0 then break end
				if not M.HoldAt(station.Position, 0.2) then break end
			end
		end
		local _, r2 = M.Char()
		if r2 then
			r2.CFrame = hold
			r2.AssemblyLinearVelocity = Vector3.zero
		end
		S.HoldCF = hold
		S.Paused = false
		S.Refilling = false
		getgenv().KiraHub.State.Refilling = false
		return done == true
	end

	-- One refill switch decides for missions, raids and waves alike.
	function M.RefillOn()
		return M.Toggle("AutoReloadToggle", false)
	end

	-- Reference RefillDue gate: switch on, no refill already running, alive,
	-- not a titan, off the retry cooldown, Refills left and an empty rig.
	function M.RefillTick()
		if not M.EngineOn() then return false end
		if not M.RefillOn() then return false end
		if S.Refilling then return false end
		if M.IsTitan() or player:GetAttribute("Dead") ~= nil then return false end
		if os.clock() < (S.RefillRetryAt or 0) then return false end
		if not M.RefillPossible() then return false end
		if M.AmmoEmpty() ~= true then return false end
		-- Colossal phase 1: a loaded cannon owns the character. The trip has to
		-- fit between shots, so never walk away from a ready cannon.
		if M.ColossalPhase1() and M.CannonReadyNow() then return false end
		return M.RefillOnce(M.RefillsTotal())
	end

	-- Live label above the refill switch. The legacy updater sits after the
	-- engine loop's continue, so it never runs; the engine feeds it instead.
	function M.RefillStatus()
		local u = ui()
		local label = u and u.Labels and u.Labels.Refill
		if not label then return end
		local total = M.RefillsTotal()
		local known = M.RefillsKnown()
		local state
		if S.Refilling then
			state = S.Upgrading and "Upgrading" or (S.RefillNote or "Refilling")
		elseif not M.RefillOn() then
			state = "Off"
		elseif total <= 0 and not (M.WaveFolder() and not known) then
			state = "No refills"
		elseif M.AmmoEmpty() == true then
			state = "Refilling"
		else
			state = "Ready"
		end
		local shown = known and tostring(total) or (M.WaveFolder() and "wave station" or tostring(total))
		pcall(function()
			label:SetText(("Refill: %s | Refills %s"):format(state, shown))
		end)
	end

	-- ------------------------------------------------------------------
	--  Titan form + titan skills
	-- ------------------------------------------------------------------
	function M.TitanTryShift()
		if not M.Toggle("AutoTurnTitanToggle", false) then return end
		if not M.EngineOn() then return end
		if M.IsTitan() then return end
		-- Colossal phase 1 is cannons only; shifting there wastes the stall.
		if M.ColossalPhase1() then return end
		local now = os.clock()
		if now < (S.TitanNext or 0) then return end
		local bar = tonumber(player:GetAttribute("Bar")) or 0
		local shift = tonumber(player:GetAttribute("Shift")) or 0
		if bar < 75 or shift <= 0 then return end
		local _, root = M.Char()
		if not root then return end
		local hold = root.CFrame
		S.Paused = true
		local t0 = now
		local ok = false
		while os.clock() - t0 < 9 do
			if M.IsTitan() then ok = true break end
			pcall(function() getRemote:InvokeServer("S_Skills", "Usage", "999", false) end)
			local _, r = M.Char()
			if r then
				r.CFrame = hold
				r.AssemblyLinearVelocity = Vector3.zero
			end
			task.wait(0.25)
		end
		S.Paused = false
		S.HoldCF = nil
		S.TitanNext = os.clock() + (ok and 2 or 10)
		if ok then note("Titan form active") end
	end

	local SKILL_KEYS = {Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four, Enum.KeyCode.Five}

	function M.SkillsTick()
		if not M.Toggle("TitanSkillsToggle", false) then return end
		if not M.EngineOn() then return end
		-- Colossal phase 1: skills would pull the character off the cannon.
		if M.ColossalPhase1() then return end
		if UserInputService:GetFocusedTextBox() then return end
		local char, root = M.Char()
		if not char or not root then return end
		if player:GetAttribute("Dead") == true then return end
		local titan = M.IsTitan()
		local nape = getgenv().KiraHub.State.TargetNape
		if titan and not (nape and nape.Parent) then return end
		for i = 1, 5 do
			-- A titan skill is ready while Shifter_Skill_<slot> is nil.
			if (S.SkillRetry[i] or 0) <= os.clock()
				and (not titan or player:GetAttribute("Shifter_Skill_" .. i) == nil)
			then
				pcall(function()
					VirtualInputManager:SendKeyEvent(true, SKILL_KEYS[i], false, game)
					task.wait(titan and 0.5 or 0.08)
					VirtualInputManager:SendKeyEvent(false, SKILL_KEYS[i], false, game)
				end)
				if titan then
					task.wait(0.6)
					-- Still nil means the server ignored it: back off for a while.
					local used = player:GetAttribute("Shifter_Skill_" .. i) ~= nil
					S.SkillRetry[i] = os.clock() + (used and 0.4 or 8)
				else
					S.SkillRetry[i] = os.clock() + 1
				end
				task.wait(0.15)
			end
		end
	end

	-- ------------------------------------------------------------------
	--  QTE (Female raid) / rejoin
	-- ------------------------------------------------------------------
	function M.QTEWatch()
		if not M.Toggle("QTEToggle", false) then return end
		if os.clock() - (S.QAt or 0) < 0.12 then return end
		local gui = pGui:FindFirstChild("Interface")
		local qte = gui and gui:FindFirstChild("QTE")
		local main = qte and qte:FindFirstChild("Main")
		local timing = main and main:FindFirstChild("Timing")
		if not (qte and timing and qte.Visible and timing.Visible) then
			S.QLast = nil
			return
		end
		local scale = 0
		pcall(function() scale = timing.Size.X.Scale end)
		-- Re-arm the press whenever the ring grows again.
		if S.QLast == nil or S.QLast + 0.3 < scale then S.QDone = false end
		S.QLast = scale
		local bg = qte:FindFirstChild("BG")
		-- BG becomes visible once the answer is accepted, so only answer
		-- while it is hidden and the ring is inside the window.
		if S.QDone or scale > 1.6 or scale <= 1.02 or (bg and bg.Visible) then return end
		S.QDone = true
		S.QAt = os.clock()
		local pressed = false
		local key = main:FindFirstChild("Key")
		if key and key.Visible then
			local keyText = key:IsA("TextLabel") and key.Text or nil
			local code = keyText and Enum.KeyCode[keyText]
			if code then
				pcall(function()
					VirtualInputManager:SendKeyEvent(true, code, false, game)
					VirtualInputManager:SendKeyEvent(false, code, false, game)
				end)
				pressed = true
			end
		end
		if not pressed then
			local button = main:FindFirstChild("Button")
			if button and button:IsA("GuiButton") then
				pcall(function()
					local inset = Vector2.zero
					pcall(function() inset = game:GetService("GuiService"):GetGuiInset() end)
					local pos = button.AbsolutePosition + button.AbsoluteSize * 0.5 + inset
					VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 0)
					VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0)
				end)
				pressed = true
			end
		end
		task.wait(0.12)
		local accepted = false
		if bg then
			local col = bg.BackgroundColor3
			accepted = bg.Visible and col.G > 0.8 and col.R < 0.3
		end
		if not accepted then
			pcall(function() getRemote:InvokeServer("Functions", "QTE", true) end)
		end
	end

	-- Rejoin: a kick / disconnect teleports back to the lobby place,
	-- while the in-lobby "rejoin the last match" prompt is answered with Yes.
	function M.RejoinTeleport(reason)
		if not M.Toggle("RejoinOnKickToggle", false) then return end
		if S.Rejoining then return end
		S.Rejoining = true
		note("Rejoin: " .. tostring(reason))
		task.spawn(function()
			task.wait(3)
			for _ = 1, 20 do
				if not M.Toggle("RejoinOnKickToggle", false) then break end
				pcall(function() TeleportService:Teleport(Ctx.LobbyId, player) end)
				task.wait(15)
			end
			S.Rejoining = false
		end)
	end

	function M.RejoinHook()
		if S.RejoinHooked then return end
		S.RejoinHooked = true
		pcall(function()
			game:GetService("GuiService").ErrorMessageChanged:Connect(function(msg)
				if msg and msg ~= "" then M.RejoinTeleport(msg) end
			end)
		end)
		task.spawn(function()
			pcall(function()
				local core = game:GetService("CoreGui")
				local prompt = core:WaitForChild("RobloxPromptGui", 10)
				local overlay = prompt and prompt:WaitForChild("promptOverlay", 10)
				if not overlay then return end
				overlay.ChildAdded:Connect(function(child)
					if child.Name ~= "ErrorPrompt" then return end
					task.wait(1)
					M.RejoinTeleport("error prompt")
				end)
			end)
		end)
	end

	function M.RejoinWatch()
		if not M.Toggle("RejoinOnKickToggle", false) then return end
		if not isLobby then return end
		if S.RejoinPromptUntil and os.clock() < S.RejoinPromptUntil then return end
		if os.clock() - (S.RejoinScanAt or 0) < 0.5 then return end
		S.RejoinScanAt = os.clock()
		local found = false
		for _, g in ipairs(pGui:GetDescendants()) do
			if g:IsA("TextLabel") and g.Text
				and string.find(g.Text, "rejoin the last match", 1, true) then
				-- The label only counts while it and every GUI ancestor is visible.
				local vis, par = g.Visible, g.Parent
				while vis and par and par:IsA("GuiObject") do
					vis = par.Visible
					par = par.Parent
				end
				if vis then found = true break end
			end
		end
		if not found then return end
		S.RejoinPromptUntil = os.clock() + 25
		note("Rejoin prompt detected, rejoining the last match")
		task.spawn(function()
			for _ = 1, 3 do
				local ok = pcall(function()
					return getRemote:InvokeServer("Functions", "Rejoin", "Yes")
				end)
				if ok then break end
				task.wait(3)
			end
			task.wait(20)
		end)
	end

