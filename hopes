			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if not humanoid or humanoid.Health <= 0 then continue end
			-- The engine skill switch owns skills while it is on, so the two
			-- loops never press the same key twice in one cycle.
			if KiraEngine and KiraEngine.Toggle("TitanSkillsToggle", false) then continue end
			for index = 1, 5 do
				if IsToggled("AutoSkill" .. index) and os.clock() >= nextSkillAt[index] then
					local key = skillKeys[index]
					local mode = GetOption("AutoSkillMode", "Tap")
					pcall(function()
						VirtualInputManager:SendKeyEvent(true, key, false, game)
						task.wait(mode == "Hold" and 0.5 or 0.06)
						VirtualInputManager:SendKeyEvent(false, key, false, game)
					end)
					nextSkillAt[index] = os.clock() + math.clamp(tonumber(GetOption("SkillDelay", 0.2)) or 0.2, 0.05, 2)
					task.wait(0.1)
				end
			end
		end
		for _, key in ipairs(skillKeys) do
			pcall(function() VirtualInputManager:SendKeyEvent(false, key, false, game) end)
		end
	end)

	local adminHopRequested = false
	function CheckForAdmin(candidate)
		if not IsToggled("AntiAdminToggle") or not candidate or candidate == player then return end
		local isAdmin = false
		pcall(function()
			isAdmin = candidate.UserId == game.CreatorId
				or candidate:GetRankInGroup(game.CreatorId) >= 250
		end)
		if isAdmin and not adminHopRequested then
			adminHopRequested = true
			pcall(function() TeleportService:Teleport(game.PlaceId, player) end)
		end
	end
	Players.PlayerAdded:Connect(function(candidate)
		if getgenv().KiraHubAOTR then task.defer(CheckForAdmin, candidate) end
	end)
	task.spawn(function()
		while getgenv().KiraHubAOTR do
			task.wait(3)
			if IsToggled("AntiAdminToggle") then
				for _, candidate in ipairs(Players:GetPlayers()) do
					CheckForAdmin(candidate)
					if adminHopRequested then break end
				end
			else
				adminHopRequested = false
			end
		end
	end)

	function ApplyFPSLimit()
		if not IsToggled("FpsLockToggle") then
			local reset = setfpscap or set_fps_cap or setfps
			if type(reset) == "function" then pcall(reset, 9999) end
			return
		end
		local limit = math.clamp(math.floor(tonumber(GetOption("FpsLimit", 144)) or 144), 15, 360)
		local cap = setfpscap or set_fps_cap or setfps
		if type(cap) == "function" then
			pcall(cap, limit)
		elseif syn and type(syn.set_fps_cap) == "function" then
			pcall(syn.set_fps_cap, limit)
		elseif fluxus and type(fluxus.set_fps_cap) == "function" then
			pcall(fluxus.set_fps_cap, limit)
		end
	end
	task.spawn(function()
		local lastSignature = ""
		while getgenv().KiraHubAOTR do
			task.wait(2)
			local signature = tostring(IsToggled("FpsLockToggle")) .. ":" .. tostring(GetOption("FpsLimit", 144))
			if signature ~= lastSignature then
				lastSignature = signature
				pcall(ApplyFPSLimit)
			end
		end
		pcall(function()
			local reset = setfpscap or set_fps_cap or setfps
			if type(reset) == "function" then reset(9999) end
		end)
	end)
end

