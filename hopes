	local function vKiraLoadObsidian()
		local chunk = vKiraObsidianSource

		if type(chunk) == "string" and #chunk > 1000 then
			local fn = loadstring(chunk, "=KiraObsidian")

			if fn then
				local ok, result = pcall(fn)

				if ok and type(result) == "table" and type(result.CreateWindow) == "function" then
					return result
				end
			end
		end

		local urls = {
			"https://raw.githubusercontent.com/deividcomsono/Obsidian/refs/heads/main/Library.lua",
			"https://raw.githubusercontent.com/deividcomsono/Obsidian/main/Library.lua"
		}

		for _, url in ipairs(urls) do
			local ok, result = pcall(function()
				local source = game:HttpGet(url)
				local fn = loadstring(source, "=KiraObsidian")

				if not fn then
					return nil
				end

				return fn()
			end)

			if ok and type(result) == "table" and type(result.CreateWindow) == "function" then
				return result
			end
		end

		pcall(function()
			game:GetService("StarterGui"):SetCore("SendNotification", {
				Title = "Kira Hub",
				Text = t1.TR("Nao consegui carregar a interface. Verifique sua internet e execute de novo."),
				Duration = 10
			})
		end)

