function KiraTweenRoot(root, targetPos, speed)
	if not root or not targetPos then return end
	local dist = (root.Position - targetPos).Magnitude
	local duration = math.clamp(dist / (speed or 800), 0.1, 6)
	local ok, tween = pcall(function()
		return TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)})
	end)
	if not ok or not tween then
		pcall(function() root.CFrame = CFrame.new(targetPos) end)
		return
	end
	local conn = RunService.Heartbeat:Connect(function()
		pcall(function() root.AssemblyLinearVelocity = Vector3.zero end)
	end)
	tween:Play()
	local t0 = os.clock()
	while os.clock() - t0 < duration + 0.3 and tween.PlaybackState == Enum.PlaybackState.Playing do
		task.wait()
	end
	pcall(function() tween:Cancel() end)
	conn:Disconnect()
end

-- ============================================================
-- Farm movement: one linear tween per committed target, with the
-- root velocity locked every frame while it plays. No per-frame
-- CFrame writes, so the character glides instead of vibrating.
-- ============================================================
function KiraCancelFarmMove()
	local st = getgenv().KiraHub and getgenv().KiraHub.State
	if not st then return end
	if st.FarmTween then pcall(function() st.FarmTween:Cancel() end) end
	st.FarmTween = nil
	st.FarmMoveTarget = nil
	st.FarmMoveKey = nil
end

function KiraFarmMove(root, targetPos, speed, key, maxDur)
	if not root or not targetPos then return end
	local st = getgenv().KiraHub and getgenv().KiraHub.State
	if not st then return end
	local active = st.FarmTween
	local sameKey = key ~= nil and st.FarmMoveKey == key
	local committed = st.FarmMoveTarget
	local moved = committed and (targetPos - committed).Magnitude or math.huge
	if active and sameKey and active.PlaybackState == Enum.PlaybackState.Playing and moved < 12 then
		return
	end
	if active then pcall(function() active:Cancel() end) end
	local dist = (root.Position - targetPos).Magnitude
	if dist < 1.5 then
		st.FarmTween = nil
		st.FarmMoveTarget = targetPos
		st.FarmMoveKey = key
		return
	end
	local dur = math.clamp(dist / math.max(tonumber(speed) or 400, 80), 0.12, maxDur or 4)
	local ok, tween = pcall(function()
		return TweenService:Create(root, TweenInfo.new(dur, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)})
	end)
	if ok and tween then
		st.FarmTween = tween
		st.FarmMoveTarget = targetPos
		st.FarmMoveKey = key
		tween:Play()
	else
		pcall(function() root.CFrame = CFrame.new(targetPos) end)
	end
end

-- Global velocity lock for the farm tween (single Heartbeat connection).
RunService.Heartbeat:Connect(function()
	local st = getgenv().KiraHub and getgenv().KiraHub.State
	if not st then return end
	local tween = st.FarmTween
	if not tween or tween.PlaybackState ~= Enum.PlaybackState.Playing then return end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
end)

-- Slash + hit request sync: both are sent together once per interval.
-- Multi Hit shortens the window to SH's cadence (0.4s blades / 0.6s spears).
KiraSlashInterval = 1.05
function KiraSlashGate(now, interval)
	local st = getgenv().KiraHub and getgenv().KiraHub.State
	if not st then return false end
	now = now or os.clock()
	interval = interval or KiraSlashInterval
	local last = st.LastSlashAt or 0
	if now - last >= interval then
		st.LastSlashAt = now
		return true
	end
	return false
end

-- ============================================================================
--  Blade M1 + momentum
--
--  AOTR only registers blade hits on a real swing, so every blade attack also
--  taps M1 (aimed at a viewport point no visible GUI covers, so it can never
--  press a hub button). Blade damage scales with velocity, so while blades are
--  out the farm keeps the character moving at 400+ studs/s around the titan
--  instead of parking with zero speed.
-- ============================================================================
local kiraM1At = 0

function KiraM1(force)
	if not force and not IsToggled("AutoM1Toggle") then return false end
	local now = os.clock()
	if now - kiraM1At < 0.08 then return false end
	local okFocus, focused = pcall(function() return UserInputService:GetFocusedTextBox() end)
	if okFocus and focused then return false end
	kiraM1At = now

	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local points = {
		Vector2.new(vp.X * 0.5, vp.Y * 0.5),
		Vector2.new(vp.X * 0.82, vp.Y * 0.5),
		Vector2.new(vp.X * 0.18, vp.Y * 0.5),
		Vector2.new(vp.X * 0.5, vp.Y * 0.8),
	}
	local gui = player:FindFirstChildOfClass("PlayerGui")
	local free = {}
	for _, c in ipairs(points) do
		local blocked = false
		if gui then
			local ok, objs = pcall(function() return gui:GetGuiObjectsAtPosition(c.X, c.Y) end)
			if ok and type(objs) == "table" then
				for _, o in ipairs(objs) do
					if o and o.Visible and o.AbsoluteSize.X > 0 and o.AbsoluteSize.Y > 0 then
						blocked = true
						break
					end
				end
			end
		end
		if not blocked then free[#free + 1] = c end
	end
	-- Pick a random GUI-free spot; the exact click is jittered below.
	local point = free[math.random(1, math.max(1, #free))] or points[1]

	local jitter = 22
	local clickPoint = Vector2.new(
		math.clamp(point.X + (math.random() * 2 - 1) * jitter, 1, vp.X - 1),
		math.clamp(point.Y + (math.random() * 2 - 1) * jitter, 1, vp.Y - 1)
	)
	local hold = 0.1 + math.random() * 0.03
	pcall(function()
		VirtualInputManager:SendMouseMoveEvent(clickPoint.X, clickPoint.Y, game)
		VirtualInputManager:SendMouseButtonEvent(clickPoint.X, clickPoint.Y, 0, true, game, 0)
	end)
	task.delay(hold, function()
		pcall(function()
			VirtualInputManager:SendMouseButtonEvent(clickPoint.X, clickPoint.Y, 0, false, game, 0)
		end)
	end)
	return true
end

function KiraBladeMomentumSpeed()
	local v = tonumber(GetOption("HoverSpeedSlider", 400)) or 400
	return math.max(v, 400)
end

function KiraBladeMomentum(root, hoverPos, nape)
	local st = getgenv().KiraHub and getgenv().KiraHub.State
	if not (root and hoverPos and st) then return end
	local now = os.clock()
	local speed = KiraBladeMomentumSpeed()
	local aim = hoverPos
	if nape and nape.Parent then
		-- Rotate the aim point around the nape so the velocity vector keeps
		-- changing direction (that is what builds momentum) while the
		-- character stays well inside the horizontal attack ring.
		local range = tonumber(GetOption("AttackRangeSlider", 150)) or 150
		local radius = math.clamp(range * 0.45, 30, 120)
		if now >= (st.MomentumNextAt or 0) then
			st.MomentumNextAt = now + 0.35
			st.OrbitAngle = ((st.OrbitAngle or 0) + 1.1) % (math.pi * 2)
		end
		local ang = st.OrbitAngle or 0
		aim = Vector3.new(
			nape.Position.X + math.cos(ang) * radius,
			hoverPos.Y,
			nape.Position.Z + math.sin(ang) * radius
		)
	end
	local delta = aim - root.Position
	local mag = delta.Magnitude
	if mag < 0.5 then return end
	root.AssemblyLinearVelocity = (delta / mag) * speed
	root.AssemblyAngularVelocity = Vector3.zero
end

-- ============================================================================
--  Blade farm
--
--  Multi Hit OFF: one nape, one Slash + one hit request per 1.05s swing
--  (bosses keep their Blade Boss Hits loop). Safe, current behaviour.
--
--  Multi Hit ON: the SH blade farm -- the main nape plus every other live
--  nape, nearest first, capped at defaultThunderTargets() = 20, one
--  Slash + Register pair per nape per 0.4s. Raids, missions and waves all
--  use this same path.
-- ============================================================================
function KiraMultiHitEnabled()
	return IsToggled("MultiHitToggle") == true
end

function KiraBladeTargets(targetPart, validNapes)
	local list = {}
	if not (targetPart and targetPart.Parent) then return list end
	list[1] = targetPart
	if not KiraMultiHitEnabled() then return list end

	-- SH defaultThunderTargets() is 20; the blade list is that many napes.
	local want = KiraEngine.MultiHitMax()
	local candidates = {}
	for _, n in ipairs(validNapes or {}) do
		if n ~= targetPart and n and n.Parent then
			if KiraTitanAlive(KiraNapeModel(n)) then
				candidates[#candidates + 1] = {
					part = n,
					d = (n.Position - targetPart.Position).Magnitude
				}
			end
		end
	end
	table.sort(candidates, function(a, b) return a.d < b.d end)
	for _, c in ipairs(candidates) do
		if #list >= want then break end
		list[#list + 1] = c.part
	end
	return list
end

function KiraBladeAttack(targetPart, validNapes, isBoss)
	local st = getgenv().KiraHub and getgenv().KiraHub.State
	if not st then return 0 end
	local _, root = KiraEngine.Char()
	if not (root and targetPart and targetPart.Parent) then return 0 end

	local isTitan = KiraEngine.IsTitan()
	-- Safe Mode reach gate: never swing from outside the ring.
	if KiraEngine.Safe() then
		local reach = isTitan and KiraEngine.SAFE.TitanReach or KiraEngine.SAFE.Reach
		if reach < (targetPart.Position - root.Position).Magnitude then
			task.wait(0.1)
			return 0
		end
	end

	local sent = 0
	local ok, err = pcall(function()
		if isTitan then
			postRemote:FireServer("Attacks", "Slash", true)
			task.wait(0.25)
		else
			KiraM1(true)
			local es = KiraEngine and KiraEngine.State
			if es then
				es.ImpulseDir = (targetPart.Position - root.Position).Unit
				es.ImpulseSpeed = 250
				es.ImpulseUntil = os.clock() + 0.25
			end
			task.wait(0.15)
			postRemote:FireServer("Attacks", "Slash", true)
		end

		local _, r = KiraEngine.Char()
		if not r then return end

		-- Reference target list: the committed nape plus the nearest other
		-- napes, capped at Multi Hit Targets - 1 and inside ExtraReach when
		-- Safe Mode is on. Multi Hit OFF keeps the safe one-nape swing.
		local list = {}
		if KiraEngine.MultiHit() then
			local cap = math.max(0, math.floor(KiraEngine.MultiHitMax() or 1) - 1)
			local cands = {}
			for _, n in ipairs(validNapes or {}) do
				if n ~= targetPart and n and n.Parent and n.Position then
					local d = (n.Position - r.Position).Magnitude
					if not KiraEngine.Safe() or d <= KiraEngine.SAFE.ExtraReach then
						cands[#cands + 1] = {part = n, d = d}
					end
				end
			end
			table.sort(cands, function(a, b) return a.d < b.d end)
			for i = 1, math.min(cap, #cands) do
				list[#list + 1] = cands[i].part
			end
		end
		list[#list + 1] = targetPart

		for _, nape in ipairs(list) do
			local model = KiraNapeModel(nape)
			local boss = model and KiraEngine.IsBossTitan(model) or false
			local vuln = boss and KiraEngine.VulnPart(model) or nil
			if (nape.Parent and nape.CanTouch) or vuln then
				local base = boss and math.max(1, math.floor(KiraEngine.BossMult() or 1)) or 1
				if boss and (st.MissStreak or 0) >= 2 then base = 1 end
				local hits = math.min(60, base * KiraEngine.DamageMult())
				for _ = 1, hits do
					if sent >= 700 then break end
					postRemote:FireServer("Hitboxes", "Register", vuln or nape, 0.012 + math.random() * 0.024)
					sent = sent + 1
				end
				if model and not boss then
					KiraEngine.State.Pending[model] = os.clock()
				end
			end
		end
	end)
	if not ok then KiraEngine.Note("Blade attack error: " .. tostring(err)) end

	-- Reference cadence: SwingDelay, plus an extra beat after repeated
	-- misses on a boss.
	task.wait(KiraEngine.SwingDelay or 0.4)
	if isBoss and (st.MissStreak or 0) >= 2 then task.wait(0.6) end
	st.MissStreak = (st.MissStreak or 0) + 1

	-- Reference reload check: when every blade is broken, top the rig up
	-- from a spare set (a free swap first, then the Blades/Reload remote).
	if not isTitan then pcall(KiraEngine.BladeReload) end
	return sent
end

function KiraPressPrompt(prompt)
	if not prompt then return false end
	if type(fireproximityprompt) == "function" then
		if pcall(fireproximityprompt, prompt) then return true end
	end
	return pcall(function()
		prompt:InputHoldBegin()
		task.wait((prompt.HoldDuration or 0) + 0.15)
		prompt:InputHoldEnd()
	end)
end

function KiraPressR(prompt)
	local hold = (prompt and prompt.HoldDuration or 0) + 0.2
	pcall(function() VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game) end)
	task.wait(hold)
	pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game) end)
end

local RefillCore = {
	Status = "Idle",
	LastAttempt = -999,
	LongRangeFails = 0,
	LongRangeBlockedUntil = 0,
	Refilling = false,
	Attempts = 0,
	Success = 0,
}

getgenv().KiraHub.State.Refilling = false
getgenv().KiraHub.State.RefillStatus = "Idle"

function KiraRefillsLeft()
	local v = player:GetAttribute("Refills")
	if type(v) == "number" then return v end
	return nil
end

function KiraNeedsRefill(forceKind)
	local kind = forceKind or KiraWeaponInfo()
	if kind == "Spears" then
		local n = KiraSpearsLeft()
		return n ~= nil and n <= 0
	end
	if kind == "Blades" then
		if KiraBladesEmpty() ~= true then return false end
		local spare = KiraBladeSpare()
		if spare == nil then
			-- Kira: when spare sets are not visible yet, wait for evidence
			-- (blades empty for a while) before walking to a station.
			return KiraBladesEmptyFor() >= 5
		end
		return spare == 0
	end
	return false
end

function RefillCore:SetStatus(text)
	self.Status = text
	getgenv().KiraHub.State.RefillStatus = text
end

function RefillCore:Try(forceKind, forceNow)
	local now = os.clock()
	if self.Refilling then return false end
	if now - self.LastAttempt < 1 then return false end
	if not forceNow and not KiraNeedsRefill(forceKind) then return true end

	local kind = forceKind or KiraWeaponInfo()
	if not kind then
		self:SetStatus("Unknown weapon")
		return false
	end

	self.LastAttempt = now
	self.Attempts = self.Attempts + 1

	local refillsBefore = KiraRefillsLeft()
	local function Done()
		if not forceNow and not KiraNeedsRefill(forceKind) then return true end
		local after = KiraRefillsLeft()
		if refillsBefore ~= nil and after ~= nil and after < refillsBefore then return true end
		if forceNow and kind == "Spears" then
			-- A forced spear refill is done once the rig shows an unused spear.
			for _, unused in pairs(KiraSpearIds()) do
				if unused then return true end
			end
		end
		return false
	end
	local function WaitDone(sec)
		local t0 = os.clock()
		while os.clock() - t0 < sec do
			if Done() then return true end
			task.wait(0.2)
		end
		return Done()
	end

	-- Refills always fly to a station and press the reload prompt.
	local allowRemote, allowStation, longRangeAllowed = true, true, false

	local post = postRemote
	if not (post and post.Parent) then
		pcall(function()
			local assets = ReplicatedStorage:FindFirstChild("Assets")
			local remotes = assets and assets:FindFirstChild("Remotes")
			if remotes then post = remotes:WaitForChild("POST", 5) end
		end)
	end

	for attempt = 1, 2 do
		local char, root = KiraChar()
		if not (char and root) then break end

		local station = GetRefillStation(root)
		if not station then
			self:SetStatus("No refill station")
			-- Still try a remote without a station reference as a last resort.
			if longRangeAllowed and post and post.Parent then
				pcall(function() post:FireServer("Attacks", "Reload") end)
			end
			break
		end

		if longRangeAllowed then
			self:SetStatus(("Refilling %s (remote %d/2)"):format(kind, attempt))
			KiraNet:Fire(post, "Attacks", "Reload", station)

			if WaitDone(2.5) then
				self.LongRangeFails = 0
				self.Success = self.Success + 1
				self:SetStatus("Refilled (remote)")
				if kind == "Spears" then KiraResetSpearMarks() end
				return true
			end

			self.LongRangeFails = self.LongRangeFails + 1
			if self.LongRangeFails >= 2 then
				self.LongRangeFails = 0
				self.LongRangeBlockedUntil = os.clock() + 120
				self:SetStatus("Long-range refused, using station")
			end
		end

		if not allowStation then break end

		-- step 2: physically go to the station, press the prompt, re-fire.
		local prompt = KiraPromptOf(station)
		local targetPos = KiraPromptPos(prompt, station) or KiraPos(station)
		local backCFrame = root.CFrame

		self.Refilling = true
		getgenv().KiraHub.State.Refilling = true
		self:SetStatus(("Refilling %s (station %d/2)"):format(kind, attempt))

		if targetPos then
			pcall(function() player:RequestStreamAroundAsync(targetPos) end)
			KiraTweenRoot(root, targetPos + Vector3.new(0, 3, 0), 800)
			task.wait(0.3)
			prompt = KiraPromptOf(station) or prompt
		end

		if prompt then
			KiraPressPrompt(prompt)
		else
			KiraPressR(prompt)
		end
		task.wait(0.4)
		if post and post.Parent then
			KiraNet:Fire(post, "Attacks", "Reload", station)
		end

		local done = WaitDone(3)
		if done then
			-- Give the server a moment before flying back so the "Refills"
			-- attribute has time to replicate.
			task.wait(0.6)
			done = Done()
		end

		local _, returnRoot = KiraChar()
		if returnRoot then
			pcall(function() player:RequestStreamAroundAsync(backCFrame.Position) end)
			KiraTweenRoot(returnRoot, backCFrame.Position, 600)
		end

		self.Refilling = false
		getgenv().KiraHub.State.Refilling = false

		if done then
			self.Success = self.Success + 1
			self:SetStatus("Refilled (station)")
			if kind == "Spears" then KiraResetSpearMarks() end
			return true
		end

		self:SetStatus(("Refill failed (station %d/2)"):format(attempt))
	end

	self.Refilling = false
	getgenv().KiraHub.State.Refilling = false
	return false
end

function RefillCore:ForceType(kind)
	return self:Try(kind, true)
end

getgenv().KiraHub.Refill = RefillCore

function IsBossTarget(targetPart)
	local result = false
	pcall(function()
		local part = targetPart
		for depth = 1, 5 do
			if not part or not part.Parent then break end
			if getgenv().KiraHub.Data.BossNames[part.Name] then result = true break end
			if getgenv().KiraHub.Data.BossNames[part.Parent.Name] then result = true break end
			part = part.Parent
		end
	end)
	return result
end

function IsWavesMode()
	return workspace:FindFirstChild("Waves") ~= nil
end

local titanHL = {}
local titanEspLabels = {}

function UpdateTitanESP()
	if not workspace:FindFirstChild("Titans") then return end
	local col = getgenv().KiraHub.State.EspColorObj or Color3.fromRGB(255, 185, 50)

	if IsToggled("TitanESPToggle") then
		for _, t in ipairs(workspace.Titans:GetChildren()) do
			if t:IsA("Model") then
				pcall(function()
					local h = t:FindFirstChildOfClass("Humanoid")
					if h and h.Health > 0 then
						if not titanHL[t] then
							local hl = Instance.new("Highlight")
							hl.Adornee = t
							hl.FillTransparency = 0.88
							hl.OutlineColor = getgenv().KiraHub.Data.BossNames[t.Name] and Color3.fromRGB(255, 55, 55) or col
							hl.OutlineTransparency = 0.25
							hl.Parent = t
							titanHL[t] = hl
						elseif not getgenv().KiraHub.Data.BossNames[t.Name] then
							titanHL[t].OutlineColor = col
						end
					elseif titanHL[t] then
						titanHL[t]:Destroy()
						titanHL[t] = nil
					end
				end)
			end
		end
	else
		for _, hl in pairs(titanHL) do pcall(function() hl:Destroy() end) end
		table.clear(titanHL)
	end

	if IsToggled("FullTitanESPToggle") then
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		for _, t in ipairs(workspace.Titans:GetChildren()) do
			if t:IsA("Model") then
				pcall(function()
					local head = t:FindFirstChild("Fake") and t.Fake:FindFirstChild("Head")
					if not head then return end

					if not titanEspLabels[t] then
						local bb = Instance.new("BillboardGui")
						bb.Adornee = head
						bb.Size = UDim2.new(0, 200, 0, 40)
						bb.StudsOffset = Vector3.new(0, 5, 0)
						bb.AlwaysOnTop = true
						local label = Instance.new("TextLabel")
						label.Size = UDim2.new(1, 0, 1, 0)
						label.BackgroundTransparency = 1
						label.Font = Enum.Font.Jura
						label.TextSize = 14
						label.TextColor3 = Color3.fromRGB(255, 255, 255)
						label.TextStrokeTransparency = 0.3
						label.Name = "Info"
						label.Parent = bb
						bb.Parent = head
						titanEspLabels[t] = bb
					end

					local dist = math.floor((hrp.Position - head.Position).Magnitude)
					local state = t:GetAttribute("State") or t:GetAttribute("Type") or "Standard"
					local name = t.Name:gsub("_", " ")
					titanEspLabels[t].Info.Text = name .. " | " .. tostring(dist) .. "m | " .. tostring(state)
				end)
			end
		end
	else
		for _, gui in pairs(titanEspLabels) do pcall(function() gui:Destroy() end) end
		table.clear(titanEspLabels)
	end
end

function UpdateNapeExtend()
	if not workspace:FindFirstChild("Titans") then return end
	for _, t in ipairs(workspace.Titans:GetChildren()) do
		if t:IsA("Model") and not getgenv().KiraHub.Data.BossNames[t.Name] then
			pcall(function()
				local hit = t:FindFirstChild("Hitboxes") and t.Hitboxes:FindFirstChild("Hit")
				local nape = hit and hit:FindFirstChild("Nape")
				if nape then
					if IsToggled("NapeExtendToggle") then
						local mult = GetOption("ExtendMultiSlider", 1.3)
						nape.Size = Vector3.new(50, 50, 50) * mult
						nape.Transparency = IsToggled("NapeVisibleToggle") and 0.65 or 1
						nape.Color = Color3.new(1, 1, 1)
						nape.Material = Enum.Material.Neon
					else
						nape.Size = Vector3.new(15, 9, 11)
						nape.Transparency = 1
					end
				end
			end)
		end
	end
end

function StripVisualFilters()
	pcall(function()
		for _, effectName in ipairs({"Blindness", "Vignette", "InjuredEye"}) do
			for _, v in ipairs(Lighting:GetDescendants()) do
				if v.Name == effectName then pcall(function() v:Destroy() end) end
			end
		end
	end)
end

function DeleteMap()
	if not IsToggled("DeleteMapToggle") then return end
	if not workspace:FindFirstChild("Climbable") then return end
	if mapData and mapData.Map and mapData.Map.Type == "Raids" then return end
	task.spawn(function()
		while IsToggled("DeleteMapToggle") and workspace:FindFirstChild("Climbable") do
			if mapData and mapData.Map and mapData.Map.Type == "Raids" then break end
			for _, v in ipairs(workspace.Climbable:GetChildren()) do
				pcall(function() v:Destroy() end)
			end
			if workspace:FindFirstChild("Unclimbable") then
				for _, v in ipairs(workspace.Unclimbable:GetChildren()) do
					if v.Name ~= "Reloads" and v.Name ~= "Objective" and v.Name ~= "Cutscene" then
						pcall(function() v:Destroy() end)
					end
				end
			end
			task.wait(3)
		end
	end)
end

function RemoveFog()
	pcall(function()
		for _, v in ipairs(Lighting:GetChildren()) do
			if v:IsA("Atmosphere") or v:IsA("FogEffect") then v:Destroy() end
		end
		Lighting.FogEnd = 100000
	end)
end

function ApplyPerformanceStrip()
	pcall(function()
		settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
		Lighting.GlobalShadows = false
		Lighting.FogEnd = 9e8
		for _, v in ipairs(Lighting:GetChildren()) do
			if v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("ColorCorrectionEffect")
				or v:IsA("BloomEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("Atmosphere")
			then
				pcall(function() v.Enabled = false end)
			end
		end
	end)
end

local crashCheckActive = false
function ManageCrashDetection(enabled)
	if crashCheckActive == enabled then return end
	crashCheckActive = enabled
	if not enabled then return end
	task.spawn(function()
		while crashCheckActive do
			task.wait(10)
			if not IsToggled("AutoRejoinToggle") then continue end
			if isLobby or isMenu then continue end
			if not IsToggled("AutoKillToggle") then continue end
			if not workspace:FindFirstChild("Titans") and not workspace:FindFirstChild("Unclimbable") then
				task.wait(10)
				if not workspace:FindFirstChild("Titans") and not workspace:FindFirstChild("Unclimbable") then
					getgenv().KiraHub.State.Crashes = getgenv().KiraHub.State.Crashes + 1
					pcall(function() getgenv().KiraHub.Classes.AutoFarm:Stop() end)
					task.wait(0.5)
					pcall(function() getRemote:InvokeServer("Functions", "Teleport", "Lobby") end)
					task.wait(0.5)
					pcall(function() TeleportService:Teleport(LOBBY_ID, player) end)
				end
			end
		end
	end)
end

local AutoFarm = {}
