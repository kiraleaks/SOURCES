function SendPersonalMythicalWebhook(missionInfo, rewardType, drops, missionElapsedSecs)
	if not drops or #drops == 0 then return end

	local banStatus = getgenv().KiraHub.State.BanStatus or "Unknown"
	local embedColor = 15844367
	if rewardType == "Mythical" or rewardType == "Secret" then
		embedColor = 16711680
	elseif rewardType == "Legendary" then
		embedColor = 15105570
	end

	local rewardFields = {}
	for _, drop in ipairs(drops) do
		table.insert(rewardFields, {
			name = drop.Rarity .. " Drop",
			value = "**" .. drop.Name .. "**" .. (drop.Qty and drop.Qty ~= "1" and " (x" .. drop.Qty .. ")" or ""),
			inline = true
		})
	end

	local baseFields = {
		{name = "Player", value = player.Name, inline = true},
		{name = "User ID", value = tostring(player.UserId), inline = true},
		{name = "Ban Status", value = banStatus, inline = true},
		{name = "Map", value = missionInfo.Map, inline = true},
		{name = "Objective", value = missionInfo.Objective, inline = true},
		{name = "Difficulty", value = missionInfo.Difficulty, inline = true},
		{name = "Mission Type", value = missionInfo.Type, inline = true},
		{name = "Time to Complete", value = FormatMissionTime(missionElapsedSecs), inline = true},
		{name = "Script Version", value = SCRIPT_VERSION, inline = true}
	}

	for _, f in ipairs(rewardFields) do
		table.insert(baseFields, f)
	end

	local mentionText = "Legendary+ drop!"
	if rewardType == "Mythical" or rewardType == "Secret" then
		mentionText = "MYTHICAL DROP DETECTED!"
	end

	PostWebhook(WH_PERSONAL_MYTHICAL, {
		content = mentionText,
		embeds = {{
			title = "Kira Hub Premium | " .. rewardType .. " Reward Alert",
			description = "**" .. player.Name .. "** received a **" .. rewardType .. "** class reward.",
			color = embedColor,
			fields = baseFields,
			footer = {text = "Kira Hub Premium | Rare Drop Tracker"},
			timestamp = DateTime.now():ToIsoDate()
		}}
	})
end

