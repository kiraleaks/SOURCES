	-- ------------------------------------------------------------------
	--  Waves upgrades: Smooth Hub's UI-clicking system.
	--  Cole  = base / character cards (Max HP, Regen, Replenish, Refills,
	--          Revive).
	--  Lulu  = Equipment -> UPGRADE ALL for the blades.
	--  The wave Upgrade remotes are unreliable, so every purchase is a real
	--  click on the NPC panel.
	-- ------------------------------------------------------------------
	local UP = {
		charBusy = false,
		bladeBusy = false,
		charDone = -1,
		bladeDone = -1,
		charFails = 0,
		bladeFails = 0,
		charRetry = 0,
		bladeRetry = 0,
		note = "Off",
	}
	M.UpgradeState = UP

	local UP_CARDS = {
		{name = "Max", title = "max hp"},
		{name = "Regen", title = "regen"},
		{name = "Replenish", title = "replenish"},
		{name = "Refills", title = "refills"},
		{name = "Revive", title = "revive"},
	}

	local function upClean(o)
		local t = tostring(o.Text or ""):gsub("<[^>]->", "")
		return (t:gsub("^%s+", ""):gsub("%s+$", ""))
	end

	local function upShown(obj)
		local cur = obj
		while cur and cur ~= pGui do
			if cur:IsA("GuiObject") and not cur.Visible then return false end
			if cur:IsA("ScreenGui") and not cur.Enabled then return false end
			cur = cur.Parent
		end
		return obj:IsA("GuiObject") and obj.AbsoluteSize.X > 0 and obj.AbsoluteSize.Y > 0
	end

	local function upIsText(d)
		return d:IsA("TextLabel") or d:IsA("TextButton")
	end

	local function upCenter(o)
		return o.AbsolutePosition + o.AbsoluteSize / 2
	end

	local function upClick(obj, attempt)
		attempt = attempt or 1
		if not (obj and obj.Parent) then return end
		local isBtn = obj:IsA("GuiButton")
		local method = (attempt - 1) % 3 + 1
		if method == 1 and (not isBtn or type(firesignal) ~= "function") then method = 2 end
		if method == 1 then
			pcall(firesignal, obj.Activated)
			pcall(firesignal, obj.MouseButton1Click)
		elseif method == 2 then
			local gui = obj:FindFirstAncestorOfClass("ScreenGui")
			local inset = (gui and gui.IgnoreGuiInset) and Vector2.zero or GuiService:GetGuiInset()
			local pos = upCenter(obj) + inset
			pcall(function()
				VirtualInputManager:SendMouseMoveEvent(pos.X, pos.Y, game)
				task.wait(0.05)
				VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 0)
				task.wait(0.06)
				VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0)
			end)
		else
			if isBtn then
				pcall(function() GuiService.SelectedObject = obj end)
				task.wait(0.1)
				pcall(function()
					VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
					task.wait(0.05)
					VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
				end)
				task.wait(0.1)
				pcall(function() GuiService.SelectedObject = nil end)
			end
		end
	end

	local function upButtonFor(label)
		if label:IsA("GuiButton") then return label end
		local cur = label.Parent
		for _ = 1, 4 do
			if not cur or cur == pGui then break end
			if cur:IsA("GuiButton") then return cur end
			cur = cur.Parent
		end
		return label
	end

	local function upFindText(pred)
		for _, d in ipairs(pGui:GetDescendants()) do
			if upIsText(d) and upShown(d) and pred(upClean(d):lower()) then return d end
		end
		return nil
	end

	local function upNpc(name)
		local w = workspace:FindFirstChild("Waves")
		local n = w and w:FindFirstChild("NPCs")
		return n and n:FindFirstChild(name)
	end

	local function upNpcPos(npc)
		local ok, pos = pcall(function()
			if npc:IsA("Model") then return npc:GetPivot().Position end
			if npc:IsA("BasePart") then return npc.Position end
			local part = npc:FindFirstChildWhichIsA("BasePart", true)
			return part and part.Position
		end)
		return ok and pos or nil
	end

	local function upTapKey(key, hold)
		pcall(function() VirtualInputManager:SendKeyEvent(true, key, false, game) end)
		task.wait(hold or 0.15)
		pcall(function() VirtualInputManager:SendKeyEvent(false, key, false, game) end)
	end

	local function upPanel(header)
		local lbl = upFindText(function(t) return t == header end)
		return lbl and (lbl:FindFirstAncestorOfClass("ScreenGui") or pGui) or nil
	end

	local function upClose(header)
		for _ = 1, 3 do
			local scope = upPanel(header)
			if not scope then break end
			local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
			local best, bestScore = nil, math.huge
			for _, d in ipairs(scope:GetDescendants()) do
				if d:IsA("GuiButton") and upShown(d) then
					local c = upCenter(d)
					local txt = d:IsA("TextButton") and upClean(d):upper() or ""
					if txt == "X" or (c.Y < 120 and c.X > vp.X - 160 and d.AbsoluteSize.X < 120) then
						local score = (vp.X - c.X) + c.Y
						if score < bestScore then best, bestScore = d, score end
					end
				end
			end
			if best then upClick(best, 1) end
			task.wait(0.6)
			if not upPanel(header) then break end
		end
		local bye = upFindText(function(t) return t == "bye" or t == "goodbye" end)
		if bye then upClick(upButtonFor(bye), 1) task.wait(0.3) end
	end

	local function upOpen(header, npcName, dialogPattern, statusText)
		if upPanel(header) then return true end
		local npc = upNpc(npcName)
		local pos = npc and upNpcPos(npc)
		if not pos then
			UP.note = npcName .. " not found"
			return false
		end
		if not M.Char() then return false end
		for attempt = 1, 3 do
			if not M.Char() then return false end
			UP.note = ("Going to %s (%d/3)"):format(npcName, attempt)
			pcall(function() player:RequestStreamAroundAsync(pos, 0.5) end)
			if not M.HoldAt(pos + Vector3.new(4, 2, 4), 0.25) then return false end
			pcall(function()
				local _, r = M.Char()
				if r then r.CFrame = CFrame.lookAt(r.Position, pos) end
			end)
			task.wait(0.3)
			UP.note = "Talking to " .. npcName
			local prompt = npc:FindFirstChildWhichIsA("ProximityPrompt", true)
			if prompt and type(fireproximityprompt) == "function" and attempt ~= 2 then
				pcall(fireproximityprompt, prompt)
			else
				upTapKey(Enum.KeyCode.E, (prompt and prompt.HoldDuration or 0) + 0.2)
			end
			local t0 = os.clock()
			local clicked = false
			while os.clock() - t0 < 4 do
				task.wait(0.25)
				if upPanel(header) then return true end
				local lbl = upFindText(function(t) return t:match(dialogPattern) ~= nil end)
				if lbl and not clicked then
					UP.note = statusText
					upClick(upButtonFor(lbl), attempt)
					clicked = true
					t0 = os.clock() - 2
				end
			end
		end
		UP.note = "Could not open " .. header
		return false
	end

	local function upTitleFor(scope, card)
		for _, d in ipairs(scope:GetDescendants()) do
			if upIsText(d) and upShown(d) and upClean(d):lower() == card.title then return d end
		end
		return nil
	end

	local function upBuyBtn(scope, titleLbl)
		local tc = upCenter(titleLbl)
		local best, bestDx = nil, 150
		for _, d in ipairs(scope:GetDescendants()) do
			if upIsText(d) and upShown(d) then
				local t = upClean(d):lower()
				if t:match("^buy%s*%(") or t:match("^max%s*%(") then
					local c = upCenter(d)
					local dx = math.abs(c.X - tc.X)
					if c.Y > tc.Y and dx < bestDx then best, bestDx = d, dx end
				end
			end
		end
		return best
	end

	local function upGold()
		local d = M.Stats()
		return tonumber(d and d.Gold) or 0
	end

	-- "Gold Reserve" keeps that much wave gold untouched, as before.
	local function upReserve()
		return M.Num("GoldReserveSlider", 5000, 0, 100000000)
	end

	local function upBuyCard(card)
		local bought, tries = 0, 0
		for _ = 1, 30 do
			local scope = upPanel("upgrades")
			if not scope then return bought, "closed" end
			local title = upTitleFor(scope, card)
			if not title then return bought, "notfound" end
			local btn = upBuyBtn(scope, title)
			if not btn then return bought, "nobutton" end
			local before = upClean(btn):lower()
			if before:match("^max") then return bought, "max" end
			local price = tonumber(before:match("^buy%s*%((%d+)%)")) or 0
			if price > 0 and upGold() < price + upReserve() then return bought, "gold" end
			UP.note = ("Buying %s %s"):format(card.name, before)
			upClick(upButtonFor(btn), tries + 1)
			task.wait(0.8)
			local scope2 = upPanel("upgrades")
			local title2 = scope2 and upTitleFor(scope2, card)
			local btn2 = title2 and upBuyBtn(scope2, title2)
			local after = btn2 and upClean(btn2):lower() or ""
			if after ~= before then
				bought = bought + 1
				tries = 0
				statsCache = nil
			else
				tries = tries + 1
				if tries >= 3 then return bought, "gold" end
			end
		end
		return bought, "limit"
	end

	local waveLabel, waveScanAt, waveLast = nil, 0, nil
	local function upWaveKey()
		if not (waveLabel and waveLabel.Parent) then
			waveLabel = nil
			if os.clock() - waveScanAt < 2 then return waveLast end
			waveScanAt = os.clock()
			for _, d in ipairs(pGui:GetDescendants()) do
				if upIsText(d) and upClean(d):lower():match("^waves cleared%s*%[%d+%s*/%s*%d+%]") then
					waveLabel = d
					break
				end
			end
		end
		if not waveLabel then return waveLast end
		local a = upClean(waveLabel):match("%[(%d+)%s*/")
		local v = a and tonumber(a) or nil
		if v then waveLast = v end
		return v or waveLast
	end

	function M.WavesGear()
		if UP.bladeBusy or S.Refilling then return false end
		if not IsWavesMode() then return false end
		local npc = upNpc("Lulu")
		if not npc then UP.note = "Lulu not found" return false end
		if upGold() <= upReserve() then
			UP.note = "Gold reserve"
			return false, "reserve"
		end
		UP.bladeBusy = true
		local _, root = M.Char()
		local back = root and root.CFrame
		S.Refilling = true
		S.Upgrading = true
		getgenv().KiraHub.State.Refilling = true
		local ok, err = pcall(function()
			if not upOpen("upgrade all", "Lulu", "^%[?e%]?%s*equipment$", "Clicking [E] Equipment") then
				error("open failed", 0)
			end
			task.wait(0.6)
			for attempt = 1, 2 do
				local lbl = upFindText(function(t) return t == "upgrade all" end)
				if not lbl then error("UPGRADE ALL button not found", 0) end
				UP.note = ("Pressing UPGRADE ALL (%d/2)"):format(attempt)
				upClick(upButtonFor(lbl), attempt)
				task.wait(1)
			end
			UP.note = "Done: pressed UPGRADE ALL"
		end)
		if not ok and tostring(err) ~= "open failed" then
			UP.note = "Error: " .. tostring(err)
		end
		pcall(upClose, "upgrade all")
		local _, r = M.Char()
		if r and back then
			r.CFrame = back
			r.AssemblyLinearVelocity = Vector3.zero
		end
		S.Refilling = false
		S.Upgrading = false
		getgenv().KiraHub.State.Refilling = false
		UP.bladeBusy = false
		return ok, ok and nil or "failed"
	end

	function M.WavesBase()
		if UP.charBusy or S.Refilling then return false end
		if not IsWavesMode() then return false end
		-- The Select Upgrades list still decides what may be bought. An empty
		-- list means "everything", so the toggle works out of the box.
		local picked = M.Option("BaseUpgradesSelectDropdown", {})
		local allow = type(picked) == "table" and picked or {}
		local any = next(allow) ~= nil
		local cards = {}
		for _, c in ipairs(UP_CARDS) do
			if not any or allow[c.name] == true then cards[#cards + 1] = c end
		end
		if #cards == 0 then return false end
		if not upNpc("Cole") then UP.note = "Cole not found" return false end
		if upGold() <= upReserve() then
			UP.note = "Gold reserve"
			return false, "reserve"
		end
		UP.charBusy = true
		local _, root = M.Char()
		local back = root and root.CFrame
		S.Refilling = true
		S.Upgrading = true
		getgenv().KiraHub.State.Refilling = true
		local ok, err = pcall(function()
			if not upOpen("upgrades", "Cole", "^%[?e%]?%s*upgrades?$", "Clicking [E] Upgrade") then
				error("open failed", 0)
			end
			task.wait(0.5)
			local total, noGold = 0, {}
			for _, card in ipairs(cards) do
				local n, why = upBuyCard(card)
				total = total + n
				if why == "gold" then noGold[#noGold + 1] = card.name end
			end
			if #noGold > 0 then
				UP.note = ("Bought %d. No gold for %s"):format(total, table.concat(noGold, ", "))
			else
				UP.note = ("Bought %d upgrade(s)"):format(total)
			end
		end)
		if not ok and tostring(err) ~= "open failed" then
			UP.note = "Error: " .. tostring(err)
		end
		pcall(upClose, "upgrades")
		local _, r = M.Char()
		if r and back then
			r.CFrame = back
			r.AssemblyLinearVelocity = Vector3.zero
		end
		S.Refilling = false
		S.Upgrading = false
		getgenv().KiraHub.State.Refilling = false
		UP.charBusy = false
		return ok, ok and nil or "failed"
	end

	function M.WavesTick()
		if not IsWavesMode() then return end
		if S.Refilling then return end
		local wave = upWaveKey() or 0
		-- The upgrade trip takes several seconds (travel + panel clicks), so it
		-- runs in its own thread. The V3 wave loop (leave/die/blessing) must
		-- keep ticking meanwhile.
		if M.Toggle("AutoBuyBaseUpgradesToggle", false) and not UP.charBusy
			and wave ~= UP.charDone and os.clock() >= UP.charRetry then
			UP.charDone = wave
			task.spawn(function()
				local ok, why = M.WavesBase()
				if ok then
					UP.charFails = 0
				elseif why == "reserve" then
					-- Not enough gold this wave: stay done until the wave moves.
					UP.charFails = 0
				else
					UP.charFails = UP.charFails + 1
					if UP.charFails < 3 then
						UP.charDone = -1
						UP.charRetry = os.clock() + 6
					end
				end
			end)
		end
		if (M.Toggle("AutoWavesUpgradeToggle", false) or M.Toggle("AutoShopWavesToggle", false))
			and not UP.bladeBusy and wave ~= UP.bladeDone and os.clock() >= UP.bladeRetry then
			UP.bladeDone = wave
			task.spawn(function()
				local ok, why = M.WavesGear()
				if ok then
					UP.bladeFails = 0
				elseif why == "reserve" then
					UP.bladeFails = 0
				else
					UP.bladeFails = UP.bladeFails + 1
					if UP.bladeFails < 3 then
						UP.bladeDone = -1
						UP.bladeRetry = os.clock() + 6
					end
				end
			end)
		end
	end

