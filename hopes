function KiraWavesClearedCount()
	local count = nil
	pcall(function()
		for _, d in ipairs(INTERFACE:GetDescendants()) do
			if d:IsA("TextLabel") or d:IsA("TextButton") then
				local text = tostring(d.Text or ""):gsub("<[^>]->", "")
				text = text:gsub("^%s+", ""):gsub("%s+$", "")
				if text:lower():match("^waves cleared%s*%[%d+%s*/%s*%d+%]") then
					local n = text:match("%[(%d+)%s*/")
					if n then
						count = tonumber(n)
