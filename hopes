function t1.KIRA.Post(url, payload)
	if type(url) ~= "string" or url == "" then
		return false
	end

	local req = request or http_request or (syn and syn.request) or (http and http.request) or (fluxus and fluxus.request)

	if type(req) ~= "function" then
		return false
	end

	local ok, body = pcall(function()
		return game:GetService("HttpService"):JSONEncode(payload)
	end)

	if not ok then
		return false
	end

	task.spawn(function()
		pcall(req, {
			Url = url,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json"
			},
			Body = body
		})
	end)

	return true
end

function t1.KIRA.ReadStats()
	local ok, result = pcall(function()
		if type(readfile) ~= "function" or type(isfile) ~= "function" then
			return nil
		end

		if not isfile(t1.KIRA.STATS_FILE) then
			return nil
		end

		return game:GetService("HttpService"):JSONDecode(readfile(t1.KIRA.STATS_FILE))
	end)

	if ok and type(result) == "table" then
		return result
	end

	return {
		missions = 0,
		start = os.time(),
		executions = 0
	}
end

function t1.KIRA.WriteStats(data)
	if type(data) ~= "table" then
		return
	end

	pcall(function()
		if type(writefile) == "function" then
			writefile(t1.KIRA.STATS_FILE, game:GetService("HttpService"):JSONEncode(data))
		end
	end)
end

function t1.KIRA.ResetStats()
	t1.KIRA.WriteStats({
		missions = 0,
		start = os.time(),
		executions = 0
	})
end

function t1.KIRA.FormatTime(seconds)
	local n = math.max(0, math.floor(tonumber(seconds) or 0))

	return string.format("%dh%02dm", math.floor(n / 3600), math.floor(n % 3600 / 60))
end

function t1.KIRA.GetBanStatus()
	local state = t1.KIRA.State

	if game.PlaceId ~= t1.KIRA.LOBBY_PLACE then
		local cached = nil

		pcall(function()
			if type(isfile) == "function" and type(readfile) == "function" and isfile(t1.KIRA.BAN_FILE) then
				cached = readfile(t1.KIRA.BAN_FILE)
			end
		end)

		state.BanStatus = cached and cached ~= "" and cached or "Lobby Only"

		return state.BanStatus
	end

	local bl = LocalPlayer:GetAttribute("Blacklisted") == true
	local ex = LocalPlayer:GetAttribute("Exploiter") == true

	if bl and ex then
		state.BanStatus = "Banned"
	elseif bl or ex then
		state.BanStatus = "Flagged"
	else
		state.BanStatus = "Clean"
	end

	pcall(function()
		if type(writefile) == "function" then
			writefile(t1.KIRA.BAN_FILE, state.BanStatus)
		end
	end)

	return state.BanStatus
end

