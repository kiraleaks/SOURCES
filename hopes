function t1.KIRA.SendMythical(drops, info)
	if type(drops) ~= "table" or #drops == 0 then
		return false
	end

	local rank = {
		Legendary = 1,
		Mythic = 2,
		Mythical = 2,
		Divine = 3,
		Secret = 4
	}
	local best = nil
	local bestRank = 0
	local picked = {}

	for _, drop in ipairs(drops) do
		local rarity = tostring(drop.Rarity or "")
		local rk = rank[rarity] or 0

		if rk > 0 then
			table.insert(picked, drop)

			if rk > bestRank then
				bestRank = rk
				best = rarity
			end
		end
	end

	if #picked == 0 then
		return false
	end

	info = type(info) == "table" and info or {}

	local ban = t1.KIRA.GetBanStatus()
	local color = bestRank >= 2 and 16711680 or 15105570
	local ts

	pcall(function()
		ts = DateTime.now():ToIsoDate()
	end)

	local fields = {
		{ name = "Player", value = LocalPlayer.Name, inline = true },
		{ name = "User ID", value = tostring(LocalPlayer.UserId), inline = true },
		{ name = "Ban Status", value = ban, inline = true },
		{ name = "Map", value = tostring(info.Map or "?"), inline = true },
		{ name = "Objective", value = tostring(info.Objective or "?"), inline = true },
		{ name = "Difficulty", value = tostring(info.Difficulty or "?"), inline = true },
		{ name = "Mission Type", value = tostring(info.Type or "?"), inline = true },
		{ name = "Time to Complete", value = t1.KIRA.FormatTime(tonumber(info.Time) or 0), inline = true },
		{ name = "Script Version", value = t1.KIRA.VERSION, inline = true }
	}

	for _, drop in ipairs(picked) do
		local qty = drop.Qty and tostring(drop.Qty) or "1"

		table.insert(fields, {
			name = tostring(drop.Rarity) .. " Drop",
			value = "**" .. tostring(drop.Name or "?") .. "**" .. (qty ~= "1" and " (x" .. qty .. ")" or ""),
			inline = true
		})
	end

	return t1.KIRA.Post(t1.KIRA.WH_MYTHICAL, {
		content = bestRank >= 2 and "MYTHICAL DROP DETECTED!" or "Legendary+ drop!",
		username = "Kira Hub",
		embeds = {
			{
				title = "Kira Hub | " .. tostring(best) .. " Reward Alert",
				description = "**" .. LocalPlayer.Name .. "** received a **" .. tostring(best) .. "** class reward.",
				color = color,
				fields = fields,
				footer = { text = "Kira Hub | Rare Drop Tracker" },
				timestamp = ts
			}
		}
	})
end

function t1.KIRA.DecodeLogo(data)
	if type(data) ~= "string" or data == "" then
		return ""
	end

	local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	local map = {}

	for i = 1, #chars do
		map[chars:sub(i, i)] = i - 1
	end

	local out = {}
	local buf, bits = 0, 0

	for i = 1, #data do
		local v = map[data:sub(i, i)]

		if v then
			buf = buf * 64 + v
			bits = bits + 6

			while bits >= 8 do
				bits = bits - 8

				local byte = math.floor(buf / (2 ^ bits)) % 256

				table.insert(out, string.char(byte))
				buf = buf % (2 ^ bits)
			end
		end
	end

	return table.concat(out)
end
